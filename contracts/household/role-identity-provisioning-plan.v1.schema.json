{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://home-center.local/contracts/household/role-identity-provisioning-plan.v1.schema.json",
  "title": "Home Center role identity provisioning plan v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "plan_id",
    "household_id",
    "member_id",
    "role",
    "household_snapshot_id",
    "household_resource_version",
    "household_generation",
    "policy_id",
    "provider_id",
    "provider_version",
    "provider_kind",
    "provider_evidence_sha256",
    "account_name",
    "home_directory_mode",
    "profile_mode",
    "confirmation_required",
    "account_absence_preflight_required",
    "post_condition_verification_required",
    "credential_material_authorized",
    "emergency_admin_mutation_authorized",
    "arbitrary_privilege_grant_authorized",
    "execution_authorized",
    "infrastructure_mutation_authorized",
    "external_publication_authorized"
  ],
  "properties": {
    "schema": {"const": "home-center.role-identity-provisioning-plan.v1"},
    "plan_id": {"type": "string", "pattern": "^hcidp-[0-9a-f]{24}$"},
    "household_id": {"type": "string", "pattern": "^[a-z][a-z0-9_.:-]{1,127}$"},
    "member_id": {"type": "string", "pattern": "^[a-z][a-z0-9_.:-]{1,127}$"},
    "role": {"enum": ["parent", "child", "guest"]},
    "household_snapshot_id": {"type": "string", "pattern": "^hsnap-[0-9a-f]{24}$"},
    "household_resource_version": {"type": "string", "pattern": "^hrv-[0-9a-f]{24}$"},
    "household_generation": {"type": "integer", "minimum": 1},
    "policy_id": {"type": "string", "pattern": "^[a-z][a-z0-9_.:-]{1,127}$"},
    "provider_id": {"type": "string", "pattern": "^[a-z][a-z0-9_.:-]{1,127}$"},
    "provider_version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
    "provider_kind": {"enum": ["local", "directory"]},
    "provider_evidence_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "account_name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9._-]{0,31}$",
      "not": {"enum": ["admin", "administrator", "root"]}
    },
    "home_directory_mode": {"enum": ["local", "portable"]},
    "profile_mode": {"enum": ["local", "portable"]},
    "confirmation_required": {"const": true},
    "account_absence_preflight_required": {"const": true},
    "post_condition_verification_required": {"const": true},
    "credential_material_authorized": {"const": false},
    "emergency_admin_mutation_authorized": {"const": false},
    "arbitrary_privilege_grant_authorized": {"const": false},
    "execution_authorized": {"const": false},
    "infrastructure_mutation_authorized": {"const": false},
    "external_publication_authorized": {"const": false}
  }
}
