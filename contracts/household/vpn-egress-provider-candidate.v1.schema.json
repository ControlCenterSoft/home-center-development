{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://home-center.local/contracts/household/vpn-egress-provider-candidate.v1.schema.json",
  "title": "Home Center VPN egress provider candidate v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "provider_id", "provider_version", "location_id", "reachable",
    "latency_ms", "stability_bps", "split_routing_supported", "kill_switch_supported",
    "supported_dns_strategies", "evidence_sha256", "execution_authorized",
    "infrastructure_mutation_authorized", "external_publication_authorized"
  ],
  "properties": {
    "schema": {"const": "home-center.vpn-egress-provider-candidate.v1"},
    "provider_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "provider_version": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,63}$"},
    "location_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "reachable": {"type": "boolean"},
    "latency_ms": {"type": "integer", "minimum": 0, "maximum": 5000},
    "stability_bps": {"type": "integer", "minimum": 0, "maximum": 10000},
    "split_routing_supported": {"type": "boolean"},
    "kill_switch_supported": {"type": "boolean"},
    "supported_dns_strategies": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "uniqueItems": true,
      "items": {"enum": ["provider", "parental", "system"]}
    },
    "evidence_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "execution_authorized": {"const": false},
    "infrastructure_mutation_authorized": {"const": false},
    "external_publication_authorized": {"const": false}
  }
}
