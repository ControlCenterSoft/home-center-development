{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://home-center.local/contracts/household/household-policy-enforcement-plan-request.v1.schema.json",
  "title": "Home Center household policy enforcement plan request v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "member_id", "backend_id"],
  "properties": {
    "schema": {"const": "home-center.household-policy-enforcement-plan-request.v1"},
    "member_id": {
      "type": "string",
      "pattern": "^[a-z0-9](?:[a-z0-9._-]{0,126}[a-z0-9])?$"
    },
    "backend_id": {
      "type": "string",
      "pattern": "^[a-z0-9](?:[a-z0-9._-]{0,126}[a-z0-9])?$"
    }
  }
}
