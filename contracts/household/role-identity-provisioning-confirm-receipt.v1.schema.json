{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://home-center.local/contracts/household/role-identity-provisioning-confirm-receipt.v1.schema.json",
  "title": "Home Center role identity provisioning confirmation receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "receipt_id",
    "plan_id",
    "household_id",
    "member_id",
    "account_name",
    "provider_id",
    "provider_version",
    "provider_evidence_sha256",
    "preflight_evidence_id",
    "home_directory_mode",
    "profile_mode",
    "outcome",
    "provider_execution_authorized",
    "credential_material_authorized",
    "emergency_admin_mutation_authorized",
    "arbitrary_privilege_grant_authorized",
    "infrastructure_mutation_authorized",
    "external_publication_authorized",
    "post_condition_verification_required"
  ],
  "properties": {
    "schema": {"const": "home-center.role-identity-provisioning-confirm-receipt.v1"},
    "receipt_id": {"type": "string", "pattern": "^hcidcr-[0-9a-f]{24}$"},
    "plan_id": {"type": "string", "pattern": "^hcidp-[0-9a-f]{24}$"},
    "household_id": {"type": "string", "pattern": "^[a-z][a-z0-9_.:-]{1,127}$"},
    "member_id": {"type": "string", "pattern": "^[a-z][a-z0-9_.:-]{1,127}$"},
    "account_name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9._-]{0,31}$",
      "not": {"enum": ["admin", "administrator", "root"]}
    },
    "provider_id": {"type": "string", "pattern": "^[a-z][a-z0-9_.:-]{1,127}$"},
    "provider_version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
    "provider_evidence_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "preflight_evidence_id": {"type": "string", "pattern": "^hcidpre-[0-9a-f]{24}$"},
    "home_directory_mode": {"enum": ["local", "portable"]},
    "profile_mode": {"enum": ["local", "portable"]},
    "outcome": {"const": "confirmed-awaiting-execution"},
    "provider_execution_authorized": {"const": false},
    "credential_material_authorized": {"const": false},
    "emergency_admin_mutation_authorized": {"const": false},
    "arbitrary_privilege_grant_authorized": {"const": false},
    "infrastructure_mutation_authorized": {"const": false},
    "external_publication_authorized": {"const": false},
    "post_condition_verification_required": {"const": true}
  }
}
