{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://control-center.pro/schemas/home-center/household-policy-history-overview.v1.schema.json",
  "title": "Home Center Household Policy History Overview v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "resource_key",
    "current_generation",
    "current_bundle_id",
    "window_start_generation",
    "truncated",
    "revisions",
    "provider_execution_authorized",
    "infrastructure_mutation_authorized",
    "external_publication_authorized"
  ],
  "properties": {
    "schema": {"const": "home-center.household-policy-history-overview.v1"},
    "resource_key": {
      "type": "string",
      "pattern": "^household-policy:[a-z][a-z0-9_.:-]{1,127}:[a-z][a-z0-9_.:-]{1,127}$"
    },
    "current_generation": {"type": "integer", "minimum": 1},
    "current_bundle_id": {"type": "string", "pattern": "^hpb-[0-9a-f]{24}$"},
    "window_start_generation": {"type": "integer", "minimum": 1},
    "truncated": {"type": "boolean"},
    "revisions": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "generation",
          "bundle_id",
          "recorded_at",
          "evidence_sha256",
          "audit_event_id",
          "rollback_target"
        ],
        "properties": {
          "generation": {"type": "integer", "minimum": 1},
          "bundle_id": {"type": "string", "pattern": "^hpb-[0-9a-f]{24}$"},
          "recorded_at": {"type": "string", "minLength": 1, "maxLength": 128},
          "evidence_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "audit_event_id": {"type": "string", "minLength": 1, "maxLength": 128},
          "rollback_target": {"type": "boolean"}
        }
      }
    },
    "provider_execution_authorized": {"const": false},
    "infrastructure_mutation_authorized": {"const": false},
    "external_publication_authorized": {"const": false}
  }
}
