{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://control-center.pro/schemas/home-center/household-policy-history.v1.schema.json",
  "title": "Home Center Household Policy History v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "resource_key",
    "generation",
    "bundle_id",
    "value",
    "evidence_sha256",
    "audit_event_id",
    "recorded_at",
    "provider_execution_authorized",
    "infrastructure_mutation_authorized",
    "external_publication_authorized"
  ],
  "properties": {
    "schema": {"const": "home-center.household-policy-history.v1"},
    "resource_key": {
      "type": "string",
      "pattern": "^household-policy:[a-z][a-z0-9_.:-]{1,127}:[a-z][a-z0-9_.:-]{1,127}$"
    },
    "generation": {"type": "integer", "minimum": 1},
    "bundle_id": {"type": "string", "pattern": "^hpb-[0-9a-f]{24}$"},
    "value": {"$ref": "household-policy-bundle.v1.schema.json"},
    "evidence_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "audit_event_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "recorded_at": {"type": "string", "minLength": 1, "maxLength": 128},
    "provider_execution_authorized": {"const": false},
    "infrastructure_mutation_authorized": {"const": false},
    "external_publication_authorized": {"const": false}
  }
}
