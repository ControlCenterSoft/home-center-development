{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://home-center.local/contracts/household/qr-onboarding-audit-details.v1.schema.json",
  "title": "Home Center QR onboarding privacy-minimized Audit details v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "receipt_id", "operation", "runtime_record_id", "invitation_id",
    "target_member_id", "before_state", "after_state", "record_version",
    "invitation_evidence_sha256", "next_required_boundary",
    "raw_onboarding_code_included", "qr_payload_included",
    "account_creation_authorized", "device_registration_authorized",
    "managed_state_change_authorized", "provider_execution_authorized",
    "infrastructure_mutation_authorized", "external_publication_authorized"
  ],
  "properties": {
    "schema": {"const": "home-center.qr-onboarding-audit-details.v1"},
    "receipt_id": {"type": "string", "pattern": "^hcqro-[0-9a-f]{24}$"},
    "operation": {"enum": ["issue", "consume", "revoke"]},
    "runtime_record_id": {"type": "string", "pattern": "^hcqrr-[0-9a-f]{24}$"},
    "invitation_id": {"type": "string", "pattern": "^hcqri-[0-9a-f]{24}$"},
    "target_member_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "before_state": {"type": ["string", "null"], "enum": [null, "active", "expired", "revoked", "consumed"]},
    "after_state": {"enum": ["active", "expired", "revoked", "consumed"]},
    "record_version": {"type": "integer", "minimum": 1},
    "invitation_evidence_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "next_required_boundary": {"type": "string", "minLength": 1, "maxLength": 96},
    "raw_onboarding_code_included": {"const": false},
    "qr_payload_included": {"const": false},
    "account_creation_authorized": {"const": false},
    "device_registration_authorized": {"const": false},
    "managed_state_change_authorized": {"const": false},
    "provider_execution_authorized": {"const": false},
    "infrastructure_mutation_authorized": {"const": false},
    "external_publication_authorized": {"const": false}
  }
}
