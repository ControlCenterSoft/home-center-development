{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://home-center.local/contracts/household/parental-internet-policy-http-plan-request.v1.schema.json",
  "title": "Home Center parental Internet UI plan request v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "subject_member_id", "allow_domains", "deny_domains",
    "allow_categories", "deny_categories", "schedule", "daily_quota_minutes",
    "weekly_quota_minutes", "continuous_session_minutes", "break_minutes",
    "grace_minutes", "bonus_minutes", "reason"
  ],
  "properties": {
    "schema": {"const": "home-center.parental-internet-policy-http-plan-request.v1"},
    "subject_member_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "allow_domains": {"type": "array", "maxItems": 512, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 253}},
    "deny_domains": {"type": "array", "maxItems": 512, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 253}},
    "allow_categories": {"type": "array", "maxItems": 256, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 128}},
    "deny_categories": {"type": "array", "maxItems": 256, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 128}},
    "schedule": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["weekday", "start_minute", "end_minute"],
        "properties": {
          "weekday": {"type": "integer", "minimum": 0, "maximum": 6},
          "start_minute": {"type": "integer", "minimum": 0, "maximum": 1438},
          "end_minute": {"type": "integer", "minimum": 1, "maximum": 1439}
        }
      }
    },
    "daily_quota_minutes": {"type": ["integer", "null"], "minimum": 1, "maximum": 1440},
    "weekly_quota_minutes": {"type": ["integer", "null"], "minimum": 1, "maximum": 10080},
    "continuous_session_minutes": {"type": ["integer", "null"], "minimum": 1, "maximum": 1440},
    "break_minutes": {"type": "integer", "minimum": 0, "maximum": 1440},
    "grace_minutes": {"type": "integer", "minimum": 0, "maximum": 60},
    "bonus_minutes": {"type": "integer", "minimum": 0, "maximum": 1440},
    "reason": {"type": "string", "minLength": 1, "maxLength": 512}
  }
}
