{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://control-center.pro/schemas/home-center/household-policy-confirmation.v1.schema.json",
  "title": "Home Center Household Policy Confirmation v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "confirmation_id",
    "proposal_id",
    "household_id",
    "snapshot_id",
    "resource_version",
    "generation",
    "actor_member_id",
    "member_id",
    "bundle_id",
    "desired_state_resource_key",
    "expected_desired_state_generation",
    "expected_desired_state_bundle_id",
    "audit_event_id",
    "outcome",
    "desired_state_write_ready",
    "desired_state_write_authorized",
    "infrastructure_mutation_authorized",
    "external_publication_authorized"
  ],
  "properties": {
    "schema": {"const": "home-center.household-policy-confirmation.v1"},
    "confirmation_id": {"type": "string", "pattern": "^hpconfirm-[0-9a-f]{24}$"},
    "proposal_id": {"type": "string", "pattern": "^hpc-[0-9a-f]{24}$"},
    "household_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "snapshot_id": {"type": "string", "pattern": "^hsnap-[0-9a-f]{24}$"},
    "resource_version": {"type": "string", "pattern": "^hrv-[0-9a-f]{24}$"},
    "generation": {"type": "integer", "minimum": 1},
    "actor_member_id": {"type": "string", "pattern": "^[a-z][a-z0-9_.:-]{1,127}$"},
    "member_id": {"type": "string", "pattern": "^[a-z][a-z0-9_.:-]{1,127}$"},
    "bundle_id": {"type": "string", "pattern": "^hpb-[0-9a-f]{24}$"},
    "desired_state_resource_key": {
      "type": "string",
      "pattern": "^household-policy:[a-z][a-z0-9_.:-]{1,127}:[a-z][a-z0-9_.:-]{1,127}$"
    },
    "expected_desired_state_generation": {"type": "integer", "minimum": 0},
    "expected_desired_state_bundle_id": {
      "oneOf": [
        {"type": "null"},
        {"type": "string", "pattern": "^hpb-[0-9a-f]{24}$"}
      ]
    },
    "audit_event_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "outcome": {"const": "confirmed-for-desired-state-write"},
    "desired_state_write_ready": {"const": true},
    "desired_state_write_authorized": {"const": false},
    "infrastructure_mutation_authorized": {"const": false},
    "external_publication_authorized": {"const": false}
  },
  "allOf": [
    {
      "if": {"properties": {"expected_desired_state_generation": {"const": 0}}},
      "then": {"properties": {"expected_desired_state_bundle_id": {"type": "null"}}},
      "else": {
        "properties": {
          "expected_desired_state_bundle_id": {
            "type": "string",
            "pattern": "^hpb-[0-9a-f]{24}$"
          }
        }
      }
    }
  ]
}
