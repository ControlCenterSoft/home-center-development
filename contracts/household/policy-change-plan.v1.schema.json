{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://home-center.local/contracts/household/policy-change-plan.v1.schema.json",
  "title": "Home Center policy change plan v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "plan_id",
    "household_id",
    "snapshot_id",
    "resource_version",
    "generation",
    "actor_member_id",
    "target_member_id",
    "current_policy_id",
    "current_bundle_id",
    "target_bundle",
    "cozy_summary_ru",
    "recovery_bundle_id",
    "confirmation_required",
    "desired_state_write_authorized",
    "provider_execution_authorized",
    "external_publication_authorized"
  ],
  "properties": {
    "schema": {"const": "home-center.policy-change-plan.v1"},
    "plan_id": {"type": "string", "pattern": "^hpplan-[0-9a-f]{24}$"},
    "household_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "snapshot_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "resource_version": {"type": "string", "minLength": 1, "maxLength": 256},
    "generation": {"type": "integer", "minimum": 1},
    "actor_member_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "target_member_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "current_policy_id": {"type": "string", "pattern": "^hpol-[0-9a-f]{24}$"},
    "current_bundle_id": {"type": "string", "pattern": "^hpb-[0-9a-f]{24}$"},
    "target_bundle": {"$ref": "policy-bundle.v1.schema.json"},
    "cozy_summary_ru": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {"type": "string", "minLength": 1, "maxLength": 256}
    },
    "recovery_bundle_id": {"type": "string", "pattern": "^hpb-[0-9a-f]{24}$"},
    "confirmation_required": {"const": true},
    "desired_state_write_authorized": {"const": false},
    "provider_execution_authorized": {"const": false},
    "external_publication_authorized": {"const": false}
  }
}
