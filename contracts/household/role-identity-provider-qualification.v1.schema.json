{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://home-center.local/contracts/household/role-identity-provider-qualification.v1.schema.json",
  "title": "Home Center role identity provider qualification decision v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "version", "revision", "candidate_artifact_sha256",
    "provider_id", "provider_version", "provider_kind", "supported_roles",
    "account_create_supported", "portable_home_supported", "portable_profile_supported",
    "secret_reference_supported", "adapter_artifact_sha256", "evidence_sha256",
    "qualified", "blockers", "execution_authorized",
    "infrastructure_mutation_authorized", "external_publication_authorized"
  ],
  "properties": {
    "schema": {"const": "home-center.role-identity-provider-qualification.v1"},
    "version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
    "revision": {"type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"},
    "candidate_artifact_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "provider_id": {"type": "string", "pattern": "^[a-z][a-z0-9_.:-]{1,127}$"},
    "provider_version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
    "provider_kind": {"enum": ["local", "directory"]},
    "supported_roles": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["parent", "child", "guest"]}
    },
    "account_create_supported": {"type": "boolean"},
    "portable_home_supported": {"type": "boolean"},
    "portable_profile_supported": {"type": "boolean"},
    "secret_reference_supported": {"type": "boolean"},
    "adapter_artifact_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "evidence_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "qualified": {"type": "boolean"},
    "blockers": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z0-9_]{1,96}$"}
    },
    "execution_authorized": {"const": false},
    "infrastructure_mutation_authorized": {"const": false},
    "external_publication_authorized": {"const": false}
  }
}
