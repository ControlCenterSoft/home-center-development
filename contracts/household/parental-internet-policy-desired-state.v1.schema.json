{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://home-center.local/contracts/household/parental-internet-policy-desired-state.v1.schema.json",
  "title": "Home Center parental Internet policy Desired State v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "household_id", "member_id", "generation", "plan_id",
    "verified_base_state_sha256", "base_policy_id", "base_policy_sha256",
    "policy", "policy_sha256", "reason", "enforcement_verified",
    "reconciliation_required", "dns_policy_applied", "proxy_policy_applied",
    "infrastructure_mutation_authorized", "external_publication_authorized"
  ],
  "properties": {
    "schema": {"const": "home-center.parental-internet-policy-desired-state.v1"},
    "household_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "member_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "generation": {"type": "integer", "minimum": 1},
    "plan_id": {"type": "string", "pattern": "^hpip-[0-9a-f]{24}$"},
    "verified_base_state_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "base_policy_id": {"type": "string", "pattern": "^hcpol-[0-9a-f]{24}$"},
    "base_policy_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "policy": {"type": "object"},
    "policy_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "reason": {"type": "string", "minLength": 1, "maxLength": 512},
    "enforcement_verified": {"const": false},
    "reconciliation_required": {"const": true},
    "dns_policy_applied": {"const": false},
    "proxy_policy_applied": {"const": false},
    "infrastructure_mutation_authorized": {"const": false},
    "external_publication_authorized": {"const": false}
  }
}
