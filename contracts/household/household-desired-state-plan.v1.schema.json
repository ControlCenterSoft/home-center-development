{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://home-center.example/contracts/household/household-desired-state-plan.v1.schema.json",
  "title": "Home Center Household Desired State Plan v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "plan_id",
    "policy_id",
    "household_id",
    "member_id",
    "role",
    "internet_policy",
    "vpn_allowed",
    "managed_device_required",
    "home_files_allowed",
    "smart_home_control_allowed",
    "administration_allowed",
    "external_publication_allowed",
    "expected_generation",
    "next_generation",
    "approval_required",
    "mutation_authorized",
    "provider_execution_enabled",
    "production_mutation_enabled"
  ],
  "properties": {
    "schema": {"const": "home-center.household-desired-state-plan.v1"},
    "plan_id": {"type": "string", "pattern": "^[a-z][a-z0-9_.:-]{1,127}$"},
    "policy_id": {"type": "string", "pattern": "^[a-z][a-z0-9_.:-]{1,127}$"},
    "household_id": {"type": "string", "pattern": "^[a-z][a-z0-9_.:-]{1,127}$"},
    "member_id": {"type": "string", "pattern": "^[a-z][a-z0-9_.:-]{1,127}$"},
    "role": {"enum": ["parent", "child", "guest"]},
    "internet_policy": {"enum": ["full", "filtered", "guest"]},
    "vpn_allowed": {"type": "boolean"},
    "managed_device_required": {"type": "boolean"},
    "home_files_allowed": {"type": "boolean"},
    "smart_home_control_allowed": {"type": "boolean"},
    "administration_allowed": {"type": "boolean"},
    "external_publication_allowed": {"const": false},
    "expected_generation": {"type": "integer", "minimum": 0, "maximum": 2147483646},
    "next_generation": {"type": "integer", "minimum": 1, "maximum": 2147483647},
    "approval_required": {"const": true},
    "mutation_authorized": {"const": false},
    "provider_execution_enabled": {"const": false},
    "production_mutation_enabled": {"const": false}
  }
}
