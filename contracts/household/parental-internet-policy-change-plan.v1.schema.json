{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://home-center.local/contracts/household/parental-internet-policy-change-plan.v1.schema.json",
  "title": "Home Center parental Internet policy change plan v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "plan_id", "household_snapshot_id", "household_resource_version",
    "household_generation", "actor_member_id", "subject_member_id",
    "verified_base_state_sha256", "base_policy_id", "base_policy_sha256",
    "base_desired_generation", "base_evidence_sha256", "observed_desired_generation",
    "current_parental_policy_sha256", "expected_desired_generation", "proposed_policy",
    "proposed_policy_sha256", "reason", "desired_state_write_authorized",
    "enforcement_authorized", "infrastructure_mutation_authorized", "external_publication_authorized"
  ],
  "properties": {
    "schema": {"const": "home-center.parental-internet-policy-change-plan.v1"},
    "plan_id": {"type": "string", "pattern": "^hpip-[0-9a-f]{24}$"},
    "household_snapshot_id": {"type": "string", "pattern": "^hsnap-[0-9a-f]{24}$"},
    "household_resource_version": {"type": "string", "pattern": "^hrv-[0-9a-f]{24}$"},
    "household_generation": {"type": "integer", "minimum": 1},
    "actor_member_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "subject_member_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "verified_base_state_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "base_policy_id": {"type": "string", "pattern": "^hcpol-[0-9a-f]{24}$"},
    "base_policy_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "base_desired_generation": {"type": "integer", "minimum": 1},
    "base_evidence_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "observed_desired_generation": {"type": "integer", "minimum": 0},
    "current_parental_policy_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "expected_desired_generation": {"type": "integer", "minimum": 1},
    "proposed_policy": {"type": "object"},
    "proposed_policy_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "reason": {"type": "string", "minLength": 1, "maxLength": 512},
    "desired_state_write_authorized": {"const": false},
    "enforcement_authorized": {"const": false},
    "infrastructure_mutation_authorized": {"const": false},
    "external_publication_authorized": {"const": false}
  }
}
