{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://home-center.example/contracts/household/household-intent-proposal.v1.schema.json",
  "title": "Home Center Household Intent Proposal v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "proposal_id",
    "household_id",
    "snapshot_id",
    "resource_version",
    "generation",
    "intent",
    "plan",
    "actor_policy_id",
    "confirmation_required",
    "mutation_authorized",
    "infrastructure_mutation_authorized",
    "external_publication_authorized"
  ],
  "properties": {
    "schema": {
      "const": "home-center.household-intent-proposal.v1"
    },
    "proposal_id": {
      "type": "string",
      "pattern": "^hprop-[0-9a-f]{24}$"
    },
    "household_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.:-]{1,127}$"
    },
    "snapshot_id": {
      "type": "string",
      "pattern": "^hsnap-[0-9a-f]{24}$"
    },
    "resource_version": {
      "type": "string",
      "pattern": "^hrv-[0-9a-f]{24}$"
    },
    "generation": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9223372036854775807
    },
    "intent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "intent_id",
        "actor_member_id",
        "kind",
        "target_id",
        "requested_role",
        "subject_member_id"
      ],
      "properties": {
        "schema": {
          "const": "home-center.household-intent.v1"
        },
        "intent_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.:-]{1,127}$"
        },
        "actor_member_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.:-]{1,127}$"
        },
        "kind": {
          "enum": [
            "onboard-member",
            "enroll-device"
          ]
        },
        "target_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.:-]{1,127}$"
        },
        "requested_role": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "parent",
            "child",
            "guest",
            null
          ]
        },
        "subject_member_id": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-z][a-z0-9_.:-]{1,127}$"
        }
      }
    },
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "plan_id",
        "household_id",
        "intent_id",
        "actor_member_id",
        "actions",
        "confirmation_required",
        "mutation_authorized",
        "production_mutation_enabled"
      ],
      "properties": {
        "schema": {
          "const": "home-center.household-intent-plan.v1"
        },
        "plan_id": {
          "type": "string",
          "pattern": "^hint-[0-9a-f]{24}$"
        },
        "household_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.:-]{1,127}$"
        },
        "intent_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.:-]{1,127}$"
        },
        "actor_member_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.:-]{1,127}$"
        },
        "actions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "action_type",
              "target_id",
              "subject_member_id",
              "requires_confirmation",
              "risk"
            ],
            "properties": {
              "action_type": {
                "enum": [
                  "household.member.create",
                  "household.policy.compose",
                  "household.device.enroll",
                  "household.device.apply-effective-policy"
                ]
              },
              "target_id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_.:-]{1,127}$"
              },
              "subject_member_id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_.:-]{1,127}$"
              },
              "requires_confirmation": {
                "const": true
              },
              "risk": {
                "enum": [
                  "low",
                  "elevated"
                ]
              }
            }
          }
        },
        "confirmation_required": {
          "const": true
        },
        "mutation_authorized": {
          "const": false
        },
        "production_mutation_enabled": {
          "const": false
        }
      }
    },
    "actor_policy_id": {
      "type": "string",
      "pattern": "^hpol-[0-9a-f]{24}$"
    },
    "confirmation_required": {
      "const": true
    },
    "mutation_authorized": {
      "const": false
    },
    "infrastructure_mutation_authorized": {
      "const": false
    },
    "external_publication_authorized": {
      "const": false
    }
  }
}
