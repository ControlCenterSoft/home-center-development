{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://home-center.local/contracts/household/parental-internet-enforcement-rollback-request.v1.schema.json",
  "title": "Home Center parental Internet enforcement rollback request v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "job_id", "adapter_id", "adapter_version", "provider_operation_id", "failed_desired_state_sha256", "failed_policy_sha256", "recovery_evidence_sha256", "rollback_authorized", "credential_value_access_authorized", "external_publication_authorized"],
  "properties": {
    "schema": {"const": "home-center.parental-internet-enforcement-rollback-request.v1"},
    "job_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "adapter_id": {"type": "string", "pattern": "^[a-z0-9](?:[a-z0-9._-]{0,126}[a-z0-9])?$"},
    "adapter_version": {"type": "string", "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)$"},
    "provider_operation_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "failed_desired_state_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "failed_policy_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "recovery_evidence_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "rollback_authorized": {"const": true},
    "credential_value_access_authorized": {"const": false},
    "external_publication_authorized": {"const": false}
  }
}
