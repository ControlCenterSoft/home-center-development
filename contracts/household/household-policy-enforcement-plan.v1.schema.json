{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://home-center.local/contracts/household/household-policy-enforcement-plan.v1.schema.json",
  "title": "Home Center Household policy enforcement plan v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "plan_id",
    "household_id",
    "member_id",
    "desired_generation",
    "source_plan_id",
    "policy_id",
    "policy_sha256",
    "desired_state_sha256",
    "backend_id",
    "backend_version",
    "backend_capability_evidence_sha256",
    "post_condition_verification_required",
    "fresh_revalidation_required",
    "automatic_retry_authorized",
    "execution_authorized",
    "infrastructure_mutation_authorized",
    "external_publication_authorized"
  ],
  "properties": {
    "schema": {"const": "home-center.household-policy-enforcement-plan.v1"},
    "plan_id": {"type": "string", "pattern": "^hpenf-[0-9a-f]{24}$"},
    "household_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "member_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "desired_generation": {"type": "integer", "minimum": 1},
    "source_plan_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "policy_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "policy_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "desired_state_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "backend_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "backend_version": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "backend_capability_evidence_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "post_condition_verification_required": {"const": true},
    "fresh_revalidation_required": {"const": true},
    "automatic_retry_authorized": {"const": false},
    "execution_authorized": {"const": false},
    "infrastructure_mutation_authorized": {"const": false},
    "external_publication_authorized": {"const": false}
  }
}
