{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://home-center.local/contracts/household/household-policy-actual-state-observation.v1.schema.json",
  "title": "Home Center household policy actual state observation v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema","request_id","backend_id","observed_at","observed_state","binding","actual_policy_sha256","read_only"],
  "properties": {
    "schema": {"const":"home-center.household-policy-actual-state-observation.v1"},
    "request_id":{"type":"string","pattern":"^hprq-[0-9a-f]{24}$"},
    "backend_id":{"type":"string","pattern":"^[a-z0-9](?:[a-z0-9._-]{0,126}[a-z0-9])?$"},
    "observed_at":{"type":"string","pattern":"^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "observed_state":{"enum":["enforced","not-enforced","unknown","ambiguous"]},
    "binding":{"$ref":"household-policy-reconciliation-request.v1.schema.json#/$defs/binding"},
    "actual_policy_sha256":{"oneOf":[{"type":"string","pattern":"^[0-9a-f]{64}$"},{"type":"null"}]},
    "read_only":{"const":true}
  },
  "allOf":[
    {"if":{"properties":{"observed_state":{"const":"enforced"}},"required":["observed_state"]},"then":{"properties":{"actual_policy_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"}}}}
  ]
}
