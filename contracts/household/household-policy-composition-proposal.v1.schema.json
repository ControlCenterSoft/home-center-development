{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://home-center.example/contracts/household/household-policy-composition-proposal.v1.schema.json",
  "title": "Home Center Household Policy Composition Proposal v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "proposal_id",
    "household_id",
    "snapshot_id",
    "resource_version",
    "generation",
    "actor_member_id",
    "member_id",
    "expected_desired_state_generation",
    "expected_desired_state_bundle_id",
    "bundle",
    "confirmation_required",
    "desired_state_write_authorized",
    "infrastructure_mutation_authorized",
    "external_publication_authorized"
  ],
  "properties": {
    "schema": {"const": "home-center.household-policy-composition-proposal.v1"},
    "proposal_id": {"type": "string", "pattern": "^hpc-[0-9a-f]{24}$"},
    "household_id": {"type": "string", "pattern": "^[a-z][a-z0-9_.:-]{1,127}$"},
    "snapshot_id": {"type": "string", "pattern": "^[a-z][a-z0-9_.:-]{1,127}$"},
    "resource_version": {"type": "string", "pattern": "^[a-z][a-z0-9_.:-]{1,127}$"},
    "generation": {"type": "integer", "minimum": 1},
    "actor_member_id": {"type": "string", "pattern": "^[a-z][a-z0-9_.:-]{1,127}$"},
    "member_id": {"type": "string", "pattern": "^[a-z][a-z0-9_.:-]{1,127}$"},
    "expected_desired_state_generation": {"type": "integer", "minimum": 0},
    "expected_desired_state_bundle_id": {
      "oneOf": [
        {"type": "null"},
        {"type": "string", "pattern": "^hpb-[0-9a-f]{24}$"}
      ]
    },
    "bundle": {"$ref": "household-policy-bundle.v1.schema.json"},
    "confirmation_required": {"const": true},
    "desired_state_write_authorized": {"const": false},
    "infrastructure_mutation_authorized": {"const": false},
    "external_publication_authorized": {"const": false}
  },
  "allOf": [
    {
      "if": {"properties": {"expected_desired_state_generation": {"const": 0}}},
      "then": {"properties": {"expected_desired_state_bundle_id": {"type": "null"}}},
      "else": {
        "properties": {
          "expected_desired_state_bundle_id": {
            "type": "string",
            "pattern": "^hpb-[0-9a-f]{24}$"
          }
        }
      }
    }
  ]
}
