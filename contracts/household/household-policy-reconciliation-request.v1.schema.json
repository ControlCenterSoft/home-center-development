{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://home-center.local/contracts/household/household-policy-reconciliation-request.v1.schema.json",
  "title": "Home Center household policy reconciliation request v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema","request_id","backend_id","requested_at","max_observed_age_seconds","binding","backend_read_only_required","backend_mutation_authorized","infrastructure_mutation_authorized","external_publication_authorized"],
  "properties": {
    "schema": {"const": "home-center.household-policy-reconciliation-request.v1"},
    "request_id": {"type":"string","pattern":"^hprq-[0-9a-f]{24}$"},
    "backend_id": {"type":"string","pattern":"^[a-z0-9](?:[a-z0-9._-]{0,126}[a-z0-9])?$"},
    "requested_at": {"type":"string","pattern":"^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "max_observed_age_seconds": {"type":"integer","minimum":1,"maximum":900},
    "binding": {"$ref":"#/$defs/binding"},
    "backend_read_only_required": {"const":true},
    "backend_mutation_authorized": {"const":false},
    "infrastructure_mutation_authorized": {"const":false},
    "external_publication_authorized": {"const":false}
  },
  "$defs": {
    "binding": {
      "type":"object","additionalProperties":false,
      "required":["household_id","member_id","desired_generation","desired_plan_id","policy_id","policy_sha256"],
      "properties": {
        "household_id":{"type":"string","minLength":1,"maxLength":128},
        "member_id":{"type":"string","minLength":1,"maxLength":128},
        "desired_generation":{"type":"integer","minimum":1},
        "desired_plan_id":{"type":"string","pattern":"^hpcp-[0-9a-f]{24}$"},
        "policy_id":{"type":"string","pattern":"^hcpol-[0-9a-f]{24}$"},
        "policy_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"}
      }
    }
  }
}
