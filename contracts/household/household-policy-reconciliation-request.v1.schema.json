{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://home-center.local/contracts/household/household-policy-reconciliation-request.v1.schema.json",
  "title": "Home Center household policy reconciliation request v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "household_id", "member_id", "desired_generation", "plan_id", "policy_sha256", "adapter_id", "adapter_revision", "target_id", "correlation_id", "infrastructure_mutation_authorized", "external_publication_authorized", "request_sha256"],
  "properties": {
    "schema": {"const": "home-center.household-policy-reconciliation-request.v1"},
    "household_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "member_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "desired_generation": {"type": "integer", "minimum": 1},
    "plan_id": {"type": "string", "pattern": "^hpcp-[0-9a-f]{24}$"},
    "policy_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "adapter_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "adapter_revision": {"type": "string", "minLength": 1, "maxLength": 128},
    "target_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "correlation_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "infrastructure_mutation_authorized": {"const": false},
    "external_publication_authorized": {"const": false},
    "request_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
