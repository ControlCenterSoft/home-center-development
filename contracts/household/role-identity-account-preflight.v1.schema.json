{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://home-center.local/contracts/household/role-identity-account-preflight.v1.schema.json",
  "title": "Home Center role identity account preflight v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "evidence_id",
    "provider_id",
    "provider_version",
    "provider_evidence_sha256",
    "account_name",
    "observed_state",
    "observed_at",
    "read_only",
    "credential_material_observed",
    "emergency_admin_observed",
    "execution_authorized"
  ],
  "properties": {
    "schema": {"const": "home-center.role-identity-account-preflight.v1"},
    "evidence_id": {"type": "string", "pattern": "^hcidpre-[0-9a-f]{24}$"},
    "provider_id": {"type": "string", "pattern": "^[a-z][a-z0-9_.:-]{1,127}$"},
    "provider_version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
    "provider_evidence_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "account_name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9._-]{0,31}$",
      "not": {"enum": ["admin", "administrator", "root"]}
    },
    "observed_state": {"enum": ["absent", "exists", "unknown"]},
    "observed_at": {"type": "string", "format": "date-time", "pattern": "Z$"},
    "read_only": {"const": true},
    "credential_material_observed": {"const": false},
    "emergency_admin_observed": {"const": false},
    "execution_authorized": {"const": false}
  }
}
