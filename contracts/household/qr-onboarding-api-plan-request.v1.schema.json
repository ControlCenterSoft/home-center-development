{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://home-center.local/contracts/household/qr-onboarding-api-plan-request.v1.schema.json",
  "title": "Home Center QR onboarding API redemption-plan request v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "invitation_id", "onboarding_code"],
  "properties": {
    "schema": {"const": "home-center.qr-onboarding-api-plan-request.v1"},
    "invitation_id": {"type": "string", "pattern": "^hcqri-[0-9a-f]{24}$"},
    "onboarding_code": {"type": "string", "pattern": "^[A-Za-z0-9_-]{22,128}$"}
  }
}
