{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://home-center.example/contracts/household/household-policy-bundle.v1.schema.json",
  "title": "Home Center Household Policy Bundle v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "bundle_id",
    "policy_id",
    "household_id",
    "member_id",
    "role",
    "source",
    "technical_policy",
    "explanation",
    "desired_state_resource_key",
    "desired_state_write_authorized",
    "infrastructure_mutation_authorized",
    "external_publication_authorized"
  ],
  "properties": {
    "schema": {"const": "home-center.household-policy-bundle.v1"},
    "bundle_id": {"type": "string", "pattern": "^hpb-[0-9a-f]{24}$"},
    "policy_id": {"type": "string", "pattern": "^hpol-[0-9a-f]{24}$"},
    "household_id": {"type": "string", "pattern": "^[a-z][a-z0-9_.:-]{1,127}$"},
    "member_id": {"type": "string", "pattern": "^[a-z][a-z0-9_.:-]{1,127}$"},
    "role": {"enum": ["parent", "child", "guest"]},
    "source": {"const": "role-preset"},
    "technical_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "policy_id",
        "household_id",
        "member_id",
        "role",
        "internet_policy",
        "vpn_allowed",
        "managed_device_required",
        "home_files_allowed",
        "smart_home_control_allowed",
        "administration_allowed",
        "external_publication_allowed",
        "production_mutation_enabled"
      ],
      "properties": {
        "schema": {"const": "home-center.household-effective-policy.v1"},
        "policy_id": {"type": "string", "pattern": "^hpol-[0-9a-f]{24}$"},
        "household_id": {"type": "string", "pattern": "^[a-z][a-z0-9_.:-]{1,127}$"},
        "member_id": {"type": "string", "pattern": "^[a-z][a-z0-9_.:-]{1,127}$"},
        "role": {"enum": ["parent", "child", "guest"]},
        "internet_policy": {"enum": ["full", "filtered", "guest"]},
        "vpn_allowed": {"type": "boolean"},
        "managed_device_required": {"type": "boolean"},
        "home_files_allowed": {"type": "boolean"},
        "smart_home_control_allowed": {"type": "boolean"},
        "administration_allowed": {"type": "boolean"},
        "external_publication_allowed": {"const": false},
        "production_mutation_enabled": {"const": false}
      }
    },
    "explanation": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {"type": "string", "minLength": 1, "maxLength": 160}
    },
    "desired_state_resource_key": {
      "type": "string",
      "pattern": "^household-policy:[a-z][a-z0-9_.:-]{1,127}:[a-z][a-z0-9_.:-]{1,127}$"
    },
    "desired_state_write_authorized": {"const": false},
    "infrastructure_mutation_authorized": {"const": false},
    "external_publication_authorized": {"const": false}
  }
}
