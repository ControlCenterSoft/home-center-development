{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://home-center.local/contracts/household/safe-repair-completion-evidence.v1.schema.json",
  "title": "Home Center safe repair completion evidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "completion_id", "admission_id", "plan_id", "household_id", "target_id",
    "recommendation_kind", "repair_action", "job_id", "before_evidence_sha256",
    "after_evidence_sha256", "post_condition_evidence_sha256", "recovery_evidence_sha256",
    "outcome", "post_condition_verified", "repair_verified", "summary_ru", "completed_at_epoch",
    "state_change_authorized", "automatic_success_claim_authorized", "external_publication_authorized"
  ],
  "properties": {
    "schema": {"const": "home-center.safe-repair-completion-evidence.v1"},
    "completion_id": {"type": "string", "pattern": "^src-[0-9a-f]{24}$"},
    "admission_id": {"type": "string", "pattern": "^sra-[0-9a-f]{24}$"},
    "plan_id": {"type": "string", "pattern": "^srp-[0-9a-f]{24}$"},
    "household_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "target_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "recommendation_kind": {
      "enum": ["managed-device-policy", "household-policy-reconciliation", "compatibility-evidence-refresh"]
    },
    "repair_action": {"type": "string", "minLength": 1, "maxLength": 240},
    "job_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "before_evidence_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "after_evidence_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "post_condition_evidence_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "recovery_evidence_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "outcome": {"enum": ["verified", "failed", "reconcile-required"]},
    "post_condition_verified": {"type": "boolean"},
    "repair_verified": {"type": "boolean"},
    "summary_ru": {"type": "string", "minLength": 1, "maxLength": 320},
    "completed_at_epoch": {"type": "integer", "minimum": 0},
    "state_change_authorized": {"const": false},
    "automatic_success_claim_authorized": {"const": false},
    "external_publication_authorized": {"const": false}
  },
  "allOf": [
    {
      "if": {"properties": {"outcome": {"const": "verified"}}, "required": ["outcome"]},
      "then": {
        "properties": {
          "post_condition_verified": {"const": true},
          "repair_verified": {"const": true}
        }
      }
    },
    {
      "if": {
        "properties": {"outcome": {"enum": ["failed", "reconcile-required"]}},
        "required": ["outcome"]
      },
      "then": {
        "properties": {
          "post_condition_verified": {"const": false},
          "repair_verified": {"const": false}
        }
      }
    }
  ]
}
