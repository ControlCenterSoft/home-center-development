{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://home-center.example/contracts/household/household-policy-composition-preview.v1.schema.json",
  "title": "Home Center Household Policy Composition Preview v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "preview_id",
    "base_policy_id",
    "bundle_ids",
    "effective_policy",
    "changes",
    "confirmation_required",
    "mutation_authorized",
    "production_mutation_enabled"
  ],
  "properties": {
    "schema": {"const": "home-center.household-policy-composition-preview.v1"},
    "preview_id": {"type": "string", "pattern": "^hppv-[0-9a-f]{24}$"},
    "base_policy_id": {"type": "string", "pattern": "^hpol-[0-9a-f]{24}$"},
    "bundle_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z][a-z0-9_.:-]{1,127}$"}
    },
    "effective_policy": {"$ref": "household-effective-policy.v1.schema.json"},
    "changes": {
      "type": "array",
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["field", "before", "after", "code"],
        "properties": {
          "field": {
            "enum": [
              "internet_policy",
              "vpn_allowed",
              "managed_device_required",
              "home_files_allowed",
              "smart_home_control_allowed",
              "administration_allowed"
            ]
          },
          "before": {
            "oneOf": [
              {"type": "boolean"},
              {"enum": ["full", "filtered", "guest"]}
            ]
          },
          "after": {
            "oneOf": [
              {"type": "boolean"},
              {"enum": ["full", "filtered", "guest"]}
            ]
          },
          "code": {"const": "restriction_applied"}
        }
      }
    },
    "confirmation_required": {"const": true},
    "mutation_authorized": {"const": false},
    "production_mutation_enabled": {"const": false}
  }
}
