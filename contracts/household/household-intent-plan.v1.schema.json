{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://home-center.example/contracts/household/household-intent-plan.v1.schema.json",
  "title": "Home Center Household Intent Plan v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "plan_id", "household_id", "intent_id", "actor_member_id",
    "actions", "confirmation_required", "mutation_authorized", "production_mutation_enabled"
  ],
  "properties": {
    "schema": {"const": "home-center.household-intent-plan.v1"},
    "plan_id": {"type": "string", "pattern": "^hint-[0-9a-f]{24}$"},
    "household_id": {"type": "string", "pattern": "^[a-z][a-z0-9_.:-]{1,127}$"},
    "intent_id": {"type": "string", "pattern": "^[a-z][a-z0-9_.:-]{1,127}$"},
    "actor_member_id": {"type": "string", "pattern": "^[a-z][a-z0-9_.:-]{1,127}$"},
    "actions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["action_type", "target_id", "subject_member_id", "requires_confirmation", "risk"],
        "properties": {
          "action_type": {
            "enum": [
              "household.member.create",
              "household.policy.compose",
              "household.device.enroll",
              "household.device.apply-effective-policy"
            ]
          },
          "target_id": {"type": "string", "pattern": "^[a-z][a-z0-9_.:-]{1,127}$"},
          "subject_member_id": {"type": "string", "pattern": "^[a-z][a-z0-9_.:-]{1,127}$"},
          "requires_confirmation": {"const": true},
          "risk": {"enum": ["low", "elevated"]}
        }
      }
    },
    "confirmation_required": {"const": true},
    "mutation_authorized": {"const": false},
    "production_mutation_enabled": {"const": false}
  }
}
