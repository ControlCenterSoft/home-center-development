{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://home-center.local/contracts/household/role-identity-binding-state.v1.schema.json",
  "title": "Home Center verified member identity binding state v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "binding_id", "household_id", "member_id", "plan_id", "provider_id",
    "provider_version", "provider_kind", "provider_evidence_sha256", "account_name",
    "account_identity_sha256", "execution_job_id", "observation_evidence_sha256",
    "transition_job_id", "household_snapshot_id", "household_resource_version",
    "household_generation", "role", "home_directory_mode", "profile_mode", "verified",
    "active", "credential_material_persisted", "emergency_admin_isolated",
    "privilege_grant_authorized", "external_publication_authorized"
  ],
  "properties": {
    "schema": {"const": "home-center.role-identity-binding-state.v1"},
    "binding_id": {"type": "string", "pattern": "^hcidb-[0-9a-f]{24}$"},
    "household_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "member_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "plan_id": {"type": "string", "pattern": "^hcidp-[0-9a-f]{24}$"},
    "provider_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "provider_version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
    "provider_kind": {"enum": ["local", "directory"]},
    "provider_evidence_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "account_name": {"type": "string", "pattern": "^[a-z][a-z0-9._-]{0,31}$"},
    "account_identity_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "execution_job_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "observation_evidence_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "transition_job_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "household_snapshot_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "household_resource_version": {"type": "string", "minLength": 1, "maxLength": 128},
    "household_generation": {"type": "integer", "minimum": 1},
    "role": {"enum": ["parent", "child", "guest"]},
    "home_directory_mode": {"enum": ["local", "portable"]},
    "profile_mode": {"enum": ["local", "portable"]},
    "verified": {"const": true},
    "active": {"const": true},
    "credential_material_persisted": {"const": false},
    "emergency_admin_isolated": {"const": true},
    "privilege_grant_authorized": {"const": false},
    "external_publication_authorized": {"const": false}
  }
}
