{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://control-center.pro/schemas/home-center/household-policy-rollback-receipt.v1.schema.json",
  "title": "Home Center Household Policy Rollback Receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "rollback_id",
    "resource_key",
    "target_history_generation",
    "target_history_bundle_id",
    "generation",
    "bundle_id",
    "changed",
    "recovered",
    "outcome",
    "audit_event_id",
    "desired_state_materialized",
    "provider_execution_authorized",
    "infrastructure_mutation_authorized",
    "external_publication_authorized"
  ],
  "properties": {
    "schema": {"const": "home-center.household-policy-rollback-receipt.v1"},
    "rollback_id": {"type": "string", "pattern": "^hprb-[0-9a-f]{24}$"},
    "resource_key": {
      "type": "string",
      "pattern": "^household-policy:[a-z][a-z0-9_.:-]{1,127}:[a-z][a-z0-9_.:-]{1,127}$"
    },
    "target_history_generation": {"type": "integer", "minimum": 1},
    "target_history_bundle_id": {"type": "string", "pattern": "^hpb-[0-9a-f]{24}$"},
    "generation": {"type": "integer", "minimum": 1},
    "bundle_id": {"type": "string", "pattern": "^hpb-[0-9a-f]{24}$"},
    "changed": {"type": "boolean"},
    "recovered": {"type": "boolean"},
    "outcome": {"enum": ["rolled-back", "already-current", "already-rolled-back"]},
    "audit_event_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "desired_state_materialized": {"const": true},
    "provider_execution_authorized": {"const": false},
    "infrastructure_mutation_authorized": {"const": false},
    "external_publication_authorized": {"const": false}
  }
}
