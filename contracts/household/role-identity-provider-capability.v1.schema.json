{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://home-center.local/contracts/household/role-identity-provider-capability.v1.schema.json",
  "title": "Home Center role identity provider capability v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "provider_id",
    "provider_version",
    "provider_kind",
    "supported_roles",
    "account_create_supported",
    "portable_home_supported",
    "portable_profile_supported",
    "secret_reference_supported",
    "evidence_sha256",
    "emergency_admin_isolated",
    "arbitrary_privilege_grant_supported",
    "execution_authorized"
  ],
  "properties": {
    "schema": {"const": "home-center.role-identity-provider-capability.v1"},
    "provider_id": {"type": "string", "pattern": "^[a-z][a-z0-9_.:-]{1,127}$"},
    "provider_version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
    "provider_kind": {"enum": ["local", "directory"]},
    "supported_roles": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "uniqueItems": true,
      "items": {"enum": ["parent", "child", "guest"]}
    },
    "account_create_supported": {"type": "boolean"},
    "portable_home_supported": {"type": "boolean"},
    "portable_profile_supported": {"type": "boolean"},
    "secret_reference_supported": {"type": "boolean"},
    "evidence_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "emergency_admin_isolated": {"const": true},
    "arbitrary_privilege_grant_supported": {"const": false},
    "execution_authorized": {"const": false}
  }
}
