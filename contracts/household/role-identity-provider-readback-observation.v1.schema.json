{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://home-center.local/contracts/household/role-identity-provider-readback-observation.v1.schema.json",
  "title": "Home Center role identity provider readback observation v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "observation_id",
    "provider_operation_id",
    "provider_id",
    "provider_version",
    "provider_evidence_sha256",
    "account_name",
    "account_state",
    "home_directory_state",
    "profile_state",
    "observed_at",
    "read_only",
    "credential_material_observed",
    "execution_authorized",
    "external_publication_authorized"
  ],
  "properties": {
    "schema": {"const": "home-center.role-identity-provider-readback-observation.v1"},
    "observation_id": {"type": "string", "pattern": "^hcidobs-[0-9a-f]{24}$"},
    "provider_operation_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "provider_id": {"type": "string", "pattern": "^[a-z][a-z0-9_.:-]{1,127}$"},
    "provider_version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
    "provider_evidence_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "account_name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9._-]{0,31}$",
      "not": {"enum": ["admin", "administrator", "root"]}
    },
    "account_state": {"enum": ["present", "absent", "unknown"]},
    "home_directory_state": {"enum": ["ready", "missing", "unknown"]},
    "profile_state": {"enum": ["ready", "missing", "unknown"]},
    "observed_at": {"type": "string", "format": "date-time", "pattern": "Z$"},
    "read_only": {"const": true},
    "credential_material_observed": {"const": false},
    "execution_authorized": {"const": false},
    "external_publication_authorized": {"const": false}
  }
}
