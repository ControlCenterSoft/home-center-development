{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://home-center.local/contracts/household/role-identity-account-preflight-observation.v1.schema.json",
  "title": "Home Center role identity account preflight observation v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "provider_id", "provider_version", "provider_kind", "provider_evidence_sha256",
    "account_name", "state", "observed_at", "valid_until", "evidence_sha256", "read_only",
    "execution_authorized", "credential_access_authorized", "emergency_admin_mutation_authorized"
  ],
  "properties": {
    "schema": {"const": "home-center.role-identity-account-preflight-observation.v1"},
    "provider_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "provider_version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
    "provider_kind": {"enum": ["local", "directory"]},
    "provider_evidence_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "account_name": {"type": "string", "pattern": "^[a-z][a-z0-9._-]{0,31}$"},
    "state": {"enum": ["absent", "exists", "conflict", "unknown"]},
    "observed_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "valid_until": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "evidence_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "read_only": {"const": true},
    "execution_authorized": {"const": false},
    "credential_access_authorized": {"const": false},
    "emergency_admin_mutation_authorized": {"const": false}
  }
}
