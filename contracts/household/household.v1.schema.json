{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://home-center.example/contracts/household/household.v1.schema.json",
  "title": "Home Center Household v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "household_id", "members", "devices"],
  "properties": {
    "schema": {"const": "home-center.household.v1"},
    "household_id": {"type": "string", "pattern": "^[a-z][a-z0-9_.:-]{1,127}$"},
    "members": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["member_id", "display_name", "role", "enabled"],
        "properties": {
          "member_id": {"type": "string", "pattern": "^[a-z][a-z0-9_.:-]{1,127}$"},
          "display_name": {"type": "string", "minLength": 1, "maxLength": 80},
          "role": {"enum": ["parent", "child", "guest"]},
          "enabled": {"type": "boolean"}
        }
      }
    },
    "devices": {
      "type": "array",
      "maxItems": 1024,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["device_id", "member_id", "display_name", "managed"],
        "properties": {
          "device_id": {"type": "string", "pattern": "^[a-z][a-z0-9_.:-]{1,127}$"},
          "member_id": {"type": "string", "pattern": "^[a-z][a-z0-9_.:-]{1,127}$"},
          "display_name": {"type": "string", "minLength": 1, "maxLength": 80},
          "managed": {"type": "boolean"}
        }
      }
    }
  }
}
