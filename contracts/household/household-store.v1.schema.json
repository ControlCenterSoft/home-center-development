{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://home-center.local/contracts/household/household-store.v1.schema.json",
  "title": "Home Center Household Store Evidence v1",
  "oneOf": [
    {"$ref": "#/$defs/snapshot"},
    {"$ref": "#/$defs/commit"}
  ],
  "$defs": {
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "snapshot_id", "resource_version", "household_id", "generation", "previous_snapshot_id", "household", "infrastructure_mutation_authorized"],
      "properties": {
        "schema": {"const": "home-center.household-snapshot.v1"},
        "snapshot_id": {"type": "string", "pattern": "^hsnap-[a-f0-9]{24}$"},
        "resource_version": {"type": "string", "pattern": "^hrv-[a-f0-9]{24}$"},
        "household_id": {"type": "string", "pattern": "^[a-z][a-z0-9_.:-]{1,127}$"},
        "generation": {"type": "integer", "minimum": 1, "maximum": 9223372036854775807},
        "previous_snapshot_id": {
          "oneOf": [
            {"type": "null"},
            {"type": "string", "pattern": "^hsnap-[a-f0-9]{24}$"}
          ]
        },
        "household": {"type": "object"},
        "infrastructure_mutation_authorized": {"const": false}
      },
      "allOf": [
        {
          "if": {"properties": {"generation": {"const": 1}}, "required": ["generation"]},
          "then": {"properties": {"previous_snapshot_id": {"type": "null"}}},
          "else": {"properties": {"previous_snapshot_id": {"type": "string", "pattern": "^hsnap-[a-f0-9]{24}$"}}}
        }
      ]
    },
    "commit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "commit_id", "operation", "household_id", "previous_resource_version", "resource_version", "generation", "snapshot_id", "infrastructure_mutation_authorized", "external_publication_authorized"],
      "properties": {
        "schema": {"const": "home-center.household-commit.v1"},
        "commit_id": {"type": "string", "pattern": "^hcommit-[a-f0-9]{24}$"},
        "operation": {"enum": ["create", "replace"]},
        "household_id": {"type": "string", "pattern": "^[a-z][a-z0-9_.:-]{1,127}$"},
        "previous_resource_version": {
          "oneOf": [
            {"type": "null"},
            {"type": "string", "pattern": "^hrv-[a-f0-9]{24}$"}
          ]
        },
        "resource_version": {"type": "string", "pattern": "^hrv-[a-f0-9]{24}$"},
        "generation": {"type": "integer", "minimum": 1, "maximum": 9223372036854775807},
        "snapshot_id": {"type": "string", "pattern": "^hsnap-[a-f0-9]{24}$"},
        "infrastructure_mutation_authorized": {"const": false},
        "external_publication_authorized": {"const": false}
      },
      "allOf": [
        {
          "if": {"properties": {"operation": {"const": "create"}}, "required": ["operation"]},
          "then": {
            "properties": {
              "generation": {"const": 1},
              "previous_resource_version": {"type": "null"}
            }
          },
          "else": {
            "properties": {
              "generation": {"type": "integer", "minimum": 2, "maximum": 9223372036854775807},
              "previous_resource_version": {"type": "string", "pattern": "^hrv-[a-f0-9]{24}$"}
            }
          }
        }
      ]
    }
  }
}
