{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://control-center.pro/schemas/home-center/household-policy-presentation.v1.schema.json",
  "title": "Home Center Household Policy Presentation v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "proposal_id",
    "bundle_id",
    "cozy",
    "full",
    "same_policy_evidence",
    "confirmation_required",
    "mutation_started",
    "infrastructure_mutation_authorized",
    "external_publication_authorized"
  ],
  "properties": {
    "schema": {"const": "home-center.household-policy-presentation.v1"},
    "proposal_id": {"type": "string", "pattern": "^hpc-[0-9a-f]{24}$"},
    "bundle_id": {"type": "string", "pattern": "^hpb-[0-9a-f]{24}$"},
    "cozy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "title",
        "member_id",
        "role",
        "role_label",
        "summary",
        "status",
        "confirmation_required",
        "confirmation_label",
        "mutation_started",
        "technical_details_available",
        "external_publication_enabled"
      ],
      "properties": {
        "schema": {"const": "home-center.household-policy-cozy-card.v1"},
        "title": {"type": "string", "minLength": 1, "maxLength": 160},
        "member_id": {"type": "string", "pattern": "^[a-z][a-z0-9_.:-]{1,127}$"},
        "role": {"enum": ["parent", "child", "guest"]},
        "role_label": {"type": "string", "minLength": 1, "maxLength": 80},
        "summary": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {"type": "string", "minLength": 1, "maxLength": 160}
        },
        "status": {"const": "ready-for-confirmation"},
        "confirmation_required": {"const": true},
        "confirmation_label": {"const": "Применить правила"},
        "mutation_started": {"const": false},
        "technical_details_available": {"const": true},
        "external_publication_enabled": {"const": false}
      }
    },
    "full": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "proposal_id",
        "bundle_id",
        "source",
        "household_id",
        "member_id",
        "role",
        "snapshot_id",
        "resource_version",
        "generation",
        "desired_state_resource_key",
        "expected_desired_state_generation",
        "expected_desired_state_bundle_id",
        "technical_policy",
        "confirmation_required",
        "desired_state_write_authorized",
        "infrastructure_mutation_authorized",
        "external_publication_authorized"
      ],
      "properties": {
        "schema": {"const": "home-center.household-policy-full-inspector.v1"},
        "proposal_id": {"type": "string", "pattern": "^hpc-[0-9a-f]{24}$"},
        "bundle_id": {"type": "string", "pattern": "^hpb-[0-9a-f]{24}$"},
        "source": {"const": "role-preset"},
        "household_id": {"type": "string", "pattern": "^[a-z][a-z0-9_.:-]{1,127}$"},
        "member_id": {"type": "string", "pattern": "^[a-z][a-z0-9_.:-]{1,127}$"},
        "role": {"enum": ["parent", "child", "guest"]},
        "snapshot_id": {"type": "string", "pattern": "^hsnap-[0-9a-f]{24}$"},
        "resource_version": {"type": "string", "pattern": "^hrv-[0-9a-f]{24}$"},
        "generation": {"type": "integer", "minimum": 1},
        "desired_state_resource_key": {
          "type": "string",
          "pattern": "^household-policy:[a-z][a-z0-9_.:-]{1,127}:[a-z][a-z0-9_.:-]{1,127}$"
        },
        "expected_desired_state_generation": {"type": "integer", "minimum": 0},
        "expected_desired_state_bundle_id": {
          "oneOf": [
            {"type": "null"},
            {"type": "string", "pattern": "^hpb-[0-9a-f]{24}$"}
          ]
        },
        "technical_policy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schema",
            "policy_id",
            "household_id",
            "member_id",
            "role",
            "internet_policy",
            "vpn_allowed",
            "managed_device_required",
            "home_files_allowed",
            "smart_home_control_allowed",
            "administration_allowed",
            "external_publication_allowed",
            "production_mutation_enabled"
          ],
          "properties": {
            "schema": {"const": "home-center.household-effective-policy.v1"},
            "policy_id": {"type": "string", "pattern": "^hpol-[0-9a-f]{24}$"},
            "household_id": {"type": "string", "pattern": "^[a-z][a-z0-9_.:-]{1,127}$"},
            "member_id": {"type": "string", "pattern": "^[a-z][a-z0-9_.:-]{1,127}$"},
            "role": {"enum": ["parent", "child", "guest"]},
            "internet_policy": {"enum": ["full", "filtered", "guest"]},
            "vpn_allowed": {"type": "boolean"},
            "managed_device_required": {"type": "boolean"},
            "home_files_allowed": {"type": "boolean"},
            "smart_home_control_allowed": {"type": "boolean"},
            "administration_allowed": {"type": "boolean"},
            "external_publication_allowed": {"const": false},
            "production_mutation_enabled": {"const": false}
          }
        },
        "confirmation_required": {"const": true},
        "desired_state_write_authorized": {"const": false},
        "infrastructure_mutation_authorized": {"const": false},
        "external_publication_authorized": {"const": false}
      }
    },
    "same_policy_evidence": {"const": true},
    "confirmation_required": {"const": true},
    "mutation_started": {"const": false},
    "infrastructure_mutation_authorized": {"const": false},
    "external_publication_authorized": {"const": false}
  }
}
