{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://home-center.local/contracts/core/core-command.v1.schema.json",
  "title": "Home Center Core Command v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "operation_id",
    "idempotency_key",
    "correlation_id",
    "actor",
    "reason",
    "module",
    "action",
    "target_id",
    "input",
    "mode"
  ],
  "properties": {
    "schema": {"const": "home-center.core-command.v1"},
    "operation_id": {"type": "string", "format": "uuid"},
    "idempotency_key": {
      "type": "string",
      "minLength": 8,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{7,127}$"
    },
    "correlation_id": {
      "type": "string",
      "minLength": 2,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9_.:-]{1,127}$"
    },
    "actor": {"type": "string", "minLength": 3, "maxLength": 128},
    "reason": {"type": "string", "minLength": 3, "maxLength": 500},
    "module": {
      "enum": [
        "node-manager",
        "upgrade-engine",
        "configuration-engine",
        "service-manager",
        "policy-engine"
      ]
    },
    "action": {
      "type": "string",
      "minLength": 4,
      "maxLength": 96,
      "pattern": "^[a-z][a-z0-9.-]{1,95}\\.v[1-9][0-9]*$"
    },
    "target_id": {
      "type": "string",
      "minLength": 2,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9_.:-]{1,127}$"
    },
    "input": {
      "type": "object",
      "maxProperties": 32
    },
    "mode": {"const": "plan"}
  }
}
