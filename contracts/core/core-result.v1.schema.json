{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://home-center.local/contracts/core/core-result.v1.schema.json",
  "title": "Home Center Core Result v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "operation_id",
    "module",
    "target_id",
    "state",
    "code",
    "idempotent_replay"
  ],
  "properties": {
    "schema": {"const": "home-center.core-result.v1"},
    "operation_id": {"type": "string", "format": "uuid"},
    "module": {
      "enum": [
        "node-manager",
        "upgrade-engine",
        "configuration-engine",
        "service-manager",
        "policy-engine"
      ]
    },
    "target_id": {
      "type": "string",
      "minLength": 2,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9_.:-]{1,127}$"
    },
    "state": {"enum": ["planned", "blocked", "rejected"]},
    "code": {
      "type": "string",
      "minLength": 2,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9_.-]{1,127}$"
    },
    "idempotent_replay": {"type": "boolean"}
  }
}
