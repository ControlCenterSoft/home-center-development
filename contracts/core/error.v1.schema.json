{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://home-center.local/contracts/core/error.v1.schema.json",
  "title": "Home Center API Error v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "code", "message", "correlation_id", "retryable"],
  "properties": {
    "schema": {"const": "home-center.error.v1"},
    "code": {
      "type": "string",
      "minLength": 2,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9_.-]{1,127}$"
    },
    "message": {"type": "string", "minLength": 1, "maxLength": 500},
    "correlation_id": {
      "type": "string",
      "minLength": 2,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9_.:-]{1,127}$"
    },
    "retryable": {"type": "boolean"}
  }
}
