                    ]
                  },
                  "username": {
                    "type": "string",
                    "minLength": 1
                  },
                  "password": {
                    "type": "string",
                    "minLength": 1
                  },
                  "scope": {
                    "type": "string",
                    "pattern": "^(?:household\\.device\\.management\\.enrollment\\.verify:dmpverify-[0-9a-f]{24}|household\\.device\\.management\\.deenrollment:dmdel-[0-9a-f]{24})$"
