    "/api/v1/session/reauth": {
      "post": {
        "tags": [
          "Step-up"
        ],
        "operationId": "reauthenticateForDeviceManagement",
        "summary": "Получить одноразовый scoped step-up grant для подтверждения risk-bearing шага",
        "x-home-center-boundary": {
          "authenticated_session_required": true,
          "same_origin_required": true,
          "external_access_blocked": true,
          "max_body_bytes": 4096,
          "external_publication_authorized": false,
          "authority": "session-step-up-only"
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "schema",
                  "provider",
                  "username",
                  "password",
                  "scope"
                ],
                "properties": {
                  "schema": {
