{
  "openapi": "3.1.0",
  "info": {
    "title": "Home Center Device Management API",
    "version": "0.58.0-development",
    "description": "Bounded 0.57–0.58 device-management surface. Every operation is same-origin, authenticated, body-bounded and fail-closed. Provider acceptance is not success; verified post-condition evidence is required before managed-state transition."
  },
  "tags": [
    {
      "name": "Enrollment execution"
    },
    {
      "name": "Enrollment verification"
    },
    {
      "name": "De-enrollment"
    },
    {
      "name": "Failed enrollment cleanup"
    },
    {
      "name": "Step-up"
    }
  ],
