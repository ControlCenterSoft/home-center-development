    "/api/v1/household/devices/deenrollment/execute": {
      "post": {
        "tags": [
          "De-enrollment"
        ],
        "operationId": "executeDeviceDeenrollment",
        "summary": "Однократно выполнить typed provider de-enrollment и verify read-back",
        "x-home-center-boundary": {
          "authenticated_session_required": true,
          "same_origin_required": true,
          "external_access_blocked": true,
          "max_body_bytes": 8192,
          "external_publication_authorized": false,
          "authority": "typed-provider-mutation-readback-verified-local-state-transition"
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "schema",
                  "plan_id",
                  "confirmed",
                  "idempotency_key"
                ],
                "properties": {
                  "schema": {
                    "const": "home-center.device-management-deenrollment-execute-request.v1"
                  },
                  "plan_id": {
                    "type": "string",
                    "pattern": "^dmdel-[0-9a-f]{24}$"
                  },
                  "confirmed": {
                    "const": true
                  },
                  "idempotency_key": {
                    "type": "string",
                    "minLength": 8,
                    "maxLength": 128
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Accepted by the bounded runtime contract.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "description": "Completion or fail-closed reconciliation-required outcome; provider acceptance alone is never success."
