{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://home-center.local/contracts/auth/local-admin-password-change.v1.schema.json",
  "title": "Home Center local administrator password change request v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "current_password", "new_password"],
  "properties": {
    "schema": {"const": "home-center.local-admin-password-change.v1"},
    "current_password": {"type": "string", "minLength": 1, "maxLength": 256},
    "new_password": {"type": "string", "minLength": 12, "maxLength": 256}
  }
}
