{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://home-center.local/contracts/auth/local-admin-password-change-result.v1.schema.json",
  "title": "Home Center local administrator password change result v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "status", "node_id"],
  "properties": {
    "schema": {"const": "home-center.local-admin-password-change-result.v1"},
    "status": {"const": "changed"},
    "node_id": {"type": "string", "minLength": 3, "maxLength": 64, "pattern": "^[a-z0-9-]+$"}
  }
}
