{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://home-center.local/contracts/auth/local-admin-recovery-evidence.v1.schema.json",
  "title": "Home Center local administrator recovery evidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "sequence",
    "event_id",
    "occurred_at",
    "actor",
    "action",
    "target",
    "outcome",
    "reason",
    "policy",
    "tty",
    "previous_hash",
    "entry_hash"
  ],
  "properties": {
    "schema": {"const": "home-center.local-admin-recovery-evidence.v1"},
    "sequence": {"type": "integer", "minimum": 1},
    "event_id": {"type": "string", "format": "uuid"},
    "occurred_at": {"type": "string", "format": "date-time"},
    "actor": {"type": "string", "pattern": "^local-console:uid-[0-9]+$"},
    "action": {"const": "local-admin.password.recover"},
    "target": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9._:/-]+$"},
    "outcome": {"enum": ["requested", "accepted", "denied", "failed"]},
    "reason": {
      "enum": [
        "recovery_console_verified",
        "operator_confirmation_failed",
        "operator_cancelled",
        "password_confirmation_mismatch",
        "credential_reset_committed",
        "password_too_short",
        "password_letter_required",
        "password_digit_required",
        "password_rejected",
        "credential_path_rejected",
        "credential_directory_unavailable",
        "credential_directory_metadata_rejected",
        "credential_rotation_lock_unavailable",
        "credential_rotation_lock_rejected",
        "credential_file_metadata_rejected",
        "credential_file_read_rejected",
        "credential_file_write_rejected",
        "credential_transaction_file_rejected",
        "credential_rotation_recovery_unavailable",
        "credential_rotation_recovery_failed",
        "credential_rotation_validation_failed",
        "credential_commit_hook_failed",
        "credential_rotation_rollback_failed",
        "credential_rotation_failed"
      ]
    },
    "policy": {"const": "local-console-recovery-v1"},
    "tty": {"type": "string", "pattern": "^/dev/tty(?:[1-9]|[1-5][0-9]|6[0-3])$"},
    "previous_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "entry_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
