{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://home-center.local/contracts/auth/ad-provider-config.v1.schema.json",
  "title": "Optional Active Directory Provider Config v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "enabled",
    "realm",
    "kdc_hosts",
    "allowed_admin_groups",
    "timeout_seconds",
    "cache_root"
  ],
  "properties": {
    "enabled": {
      "type": "boolean"
    },
    "realm": {
      "type": "string",
      "pattern": "^[A-Z0-9][A-Z0-9.-]{2,254}$"
    },
    "kdc_hosts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 3,
        "maxLength": 253
      }
    },
    "allowed_admin_groups": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      }
    },
    "timeout_seconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10
    },
    "cache_root": {
      "type": "string",
      "pattern": "^/"
    }
  }
}
