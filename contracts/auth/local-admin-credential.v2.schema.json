{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://home-center.local/contracts/auth/local-admin-credential.v2.schema.json",
  "title": "Local Administrator Credential v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "username",
    "kdf",
    "n",
    "r",
    "p",
    "dklen",
    "salt_b64",
    "verifier_b64",
    "password_change_required"
  ],
  "properties": {
    "schema": {"const": "home-center.local-admin-credential.v2"},
    "username": {
      "type": "string",
      "minLength": 3,
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9._-]{2,63}$"
    },
    "kdf": {"const": "scrypt"},
    "n": {"const": 32768},
    "r": {"const": 8},
    "p": {"const": 1},
    "dklen": {"const": 32},
    "salt_b64": {"type": "string", "pattern": "^[A-Za-z0-9+/]{43}=$"},
    "verifier_b64": {"type": "string", "pattern": "^[A-Za-z0-9+/]{43}=$"},
    "password_change_required": {"type": "boolean"}
  }
}
