{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://home-center.invalid/contracts/market/home-service-deployment-plan.v1.schema.json",
  "title": "Home Center Home Service Deployment Plan v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "service_id", "target_node_id", "state", "blockers", "external_publication_enabled", "approval_required", "execution_authorized", "production_mutation_enabled"],
  "properties": {
    "schema": {"const": "home-center.home-service-deployment-plan.v1"},
    "service_id": {"$ref": "#/$defs/identifier"},
    "target_node_id": {"$ref": "#/$defs/identifier"},
    "state": {"enum": ["planned", "blocked"]},
    "blockers": {
      "type": "array",
      "maxItems": 128,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_.:-]{1,191}$"}
    },
    "external_publication_enabled": {"type": "boolean"},
    "approval_required": {"const": true},
    "execution_authorized": {"const": false},
    "production_mutation_enabled": {"const": false}
  },
  "$defs": {
    "identifier": {"type": "string", "pattern": "^[a-z][a-z0-9_.:-]{1,127}$"}
  },
  "allOf": [
    {
      "if": {"properties": {"state": {"const": "planned"}}},
      "then": {"properties": {"blockers": {"maxItems": 0}}},
      "else": {"properties": {"blockers": {"minItems": 1}}}
    }
  ]
}
