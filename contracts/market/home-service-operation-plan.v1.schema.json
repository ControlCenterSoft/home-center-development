{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://control-center.pro/contracts/home-center/market/home-service-operation-plan.v1.schema.json",
  "title": "Home Center home-service operation plan v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "plan_id",
    "instance_id",
    "service_id",
    "target_node_id",
    "operation",
    "from_state",
    "target_state",
    "based_on_generation",
    "based_on_resource_version",
    "idempotency_key",
    "steps",
    "secret_references",
    "approval_required",
    "durable_job_required",
    "audit_required",
    "plan_only",
    "execution_authorized",
    "production_mutation_enabled",
    "accepts_secret_values"
  ],
  "properties": {
    "schema": {"const": "home-center.home-service-operation-plan.v1"},
    "plan_id": {"type": "string", "pattern": "^hsop-[a-f0-9]{24}$"},
    "instance_id": {"$ref": "#/$defs/identifier"},
    "service_id": {"$ref": "#/$defs/identifier"},
    "target_node_id": {"$ref": "#/$defs/identifier"},
    "operation": {
      "enum": ["install", "configure", "health", "update", "backup", "restore", "remove"]
    },
    "from_state": {
      "enum": ["planned", "installed", "configured", "ready", "degraded", "removed"]
    },
    "target_state": {
      "enum": ["planned", "installed", "configured", "ready", "degraded", "removed"]
    },
    "based_on_generation": {"type": "integer", "minimum": 1},
    "based_on_resource_version": {"$ref": "#/$defs/identifier"},
    "idempotency_key": {"$ref": "#/$defs/identifier"},
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {"$ref": "#/$defs/identifier"}
    },
    "secret_references": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/identifier"}
    },
    "approval_required": {"const": true},
    "durable_job_required": {"const": true},
    "audit_required": {"const": true},
    "plan_only": {"const": true},
    "execution_authorized": {"const": false},
    "production_mutation_enabled": {"const": false},
    "accepts_secret_values": {"const": false}
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.:-]{1,127}$"
    }
  }
}
