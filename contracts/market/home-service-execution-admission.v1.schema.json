{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://controlcentersoft.example/contracts/market/home-service-execution-admission.v1.schema.json",
  "title": "Home Service Execution Admission v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "admission_id", "plan_id", "plan_sha256", "instance_id", "operation", "based_on_generation", "based_on_resource_version", "approval_id", "job_id", "audit_correlation_id", "secret_references", "admitted", "admission_record_only", "worker_claim_authorized", "revalidate_before_claim", "direct_execution", "production_mutation_enabled", "accepts_secret_values"],
  "properties": {
    "schema": {"const": "home-center.home-service-execution-admission.v1"},
    "admission_id": {"type": "string", "pattern": "^hsea-[a-f0-9]{24}$"},
    "plan_id": {"type": "string", "pattern": "^hsop-[a-f0-9]{24}$"},
    "plan_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "instance_id": {"type": "string", "minLength": 2, "maxLength": 128},
    "operation": {"enum": ["install", "configure", "health", "update", "backup", "restore", "remove"]},
    "based_on_generation": {"type": "integer", "minimum": 1},
    "based_on_resource_version": {"type": "string", "minLength": 2, "maxLength": 128},
    "approval_id": {"type": "string", "minLength": 2, "maxLength": 128},
    "job_id": {"type": "string", "minLength": 2, "maxLength": 128},
    "audit_correlation_id": {"type": "string", "minLength": 2, "maxLength": 128},
    "secret_references": {"type": "array", "maxItems": 32, "uniqueItems": true, "items": {"type": "string", "minLength": 2, "maxLength": 128}},
    "admitted": {"const": true},
    "admission_record_only": {"const": true},
    "worker_claim_authorized": {"const": true},
    "revalidate_before_claim": {"const": true},
    "direct_execution": {"const": false},
    "production_mutation_enabled": {"const": false},
    "accepts_secret_values": {"const": false}
  }
}
