{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://controlcentersoft.example/contracts/market/home-service-transition-commit.v1.schema.json",
  "title": "Home Service Transition Commit v1",
  "description": "Inert compare-and-swap envelope; it does not perform the durable write.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "commit_id",
    "idempotency_key",
    "decision_id",
    "result_id",
    "evidence_digest",
    "admission_id",
    "claim_id",
    "plan_id",
    "job_id",
    "worker_id",
    "node_id",
    "instance_id",
    "source_state",
    "target_state",
    "expected_generation",
    "expected_resource_version",
    "next_generation",
    "next_resource_version",
    "compare_and_swap_required",
    "idempotent",
    "committed",
    "production_mutation_enabled"
  ],
  "properties": {
    "schema": {"const": "home-center.home-service-transition-commit.v1"},
    "commit_id": {"type": "string", "pattern": "^hstc-[a-f0-9]{24}$"},
    "idempotency_key": {"type": "string", "pattern": "^hsti-[a-f0-9]{24}$"},
    "decision_id": {"type": "string", "pattern": "^hstd-[a-f0-9]{24}$"},
    "result_id": {"type": "string", "pattern": "^hser-[a-f0-9]{24}$"},
    "evidence_digest": {"type": "string", "minLength": 2, "maxLength": 128},
    "admission_id": {"type": "string", "minLength": 2, "maxLength": 128},
    "claim_id": {"type": "string", "minLength": 2, "maxLength": 128},
    "plan_id": {"type": "string", "minLength": 2, "maxLength": 128},
    "job_id": {"type": "string", "minLength": 2, "maxLength": 128},
    "worker_id": {"type": "string", "minLength": 2, "maxLength": 128},
    "node_id": {"type": "string", "minLength": 2, "maxLength": 128},
    "instance_id": {"type": "string", "minLength": 2, "maxLength": 128},
    "source_state": {"enum": ["planned", "installed", "configured", "ready", "degraded", "removed"]},
    "target_state": {"enum": ["planned", "installed", "configured", "ready", "degraded", "removed"]},
    "expected_generation": {"type": "integer", "minimum": 1},
    "expected_resource_version": {"type": "string", "minLength": 2, "maxLength": 128},
    "next_generation": {"type": "integer", "minimum": 2},
    "next_resource_version": {"type": "string", "pattern": "^rv:instance:[a-f0-9]{24}$"},
    "compare_and_swap_required": {"const": true},
    "idempotent": {"const": true},
    "committed": {"const": false},
    "production_mutation_enabled": {"const": false}
  }
}
