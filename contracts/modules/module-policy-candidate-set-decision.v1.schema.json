{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "home-center.module-policy-candidate-set-decision.v1.schema.json",
  "title": "Home Center Module Policy Candidate Set Decision v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "decision_id",
    "status",
    "policy_id",
    "policy_version",
    "candidate_set_id",
    "snapshot_id",
    "base_status",
    "candidate_count",
    "missing_required_runtime_capabilities",
    "base_blocked_modules",
    "policy_blocked_modules",
    "blocked_modules",
    "policy_reasons",
    "modules",
    "installation_authorized",
    "execution_authorized",
    "production_mutation_enabled",
    "external_publication_authorized"
  ],
  "properties": {
    "schema": {
      "const": "home-center.module-policy-candidate-set-decision.v1"
    },
    "decision_id": {
      "type": "string",
      "pattern": "^mpcs-[0-9a-f]{24}$"
    },
    "status": {
      "enum": [
        "compatible",
        "blocked"
      ]
    },
    "policy_id": {
      "type": "string",
      "pattern": "^mcp-[0-9a-f]{24}$"
    },
    "policy_version": {
      "$ref": "#/$defs/semver"
    },
    "candidate_set_id": {
      "type": "string",
      "pattern": "^mcsd-[0-9a-f]{24}$"
    },
    "snapshot_id": {
      "type": "string",
      "pattern": "^mcs-[0-9a-f]{24}$"
    },
    "base_status": {
      "enum": [
        "compatible",
        "blocked"
      ]
    },
    "candidate_count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 128
    },
    "missing_required_runtime_capabilities": {
      "$ref": "#/$defs/capabilities"
    },
    "base_blocked_modules": {
      "$ref": "#/$defs/moduleIds"
    },
    "policy_blocked_modules": {
      "$ref": "#/$defs/moduleIds"
    },
    "blocked_modules": {
      "$ref": "#/$defs/moduleIds"
    },
    "policy_reasons": {
      "type": "array",
      "maxItems": 4,
      "uniqueItems": true,
      "items": {
        "enum": [
          "candidate_limit_exceeded",
          "runtime_capability_required",
          "module_blocked_by_policy",
          "publisher_not_allowed"
        ]
      }
    },
    "modules": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "$ref": "#/$defs/moduleResult"
      }
    },
    "installation_authorized": {
      "const": false
    },
    "execution_authorized": {
      "const": false
    },
    "production_mutation_enabled": {
      "const": false
    },
    "external_publication_authorized": {
      "const": false
    }
  },
  "$defs": {
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "moduleId": {
      "type": "string",
      "pattern": "^[a-z0-9](?:[a-z0-9.-]{0,126}[a-z0-9])?$"
    },
    "symbolicId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"
    },
    "moduleIds": {
      "type": "array",
      "maxItems": 128,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/moduleId"
      }
    },
    "capabilities": {
      "type": "array",
      "maxItems": 256,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/symbolicId"
      }
    },
    "moduleResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "module_id",
        "publisher",
        "policy_reasons"
      ],
      "properties": {
        "module_id": {
          "$ref": "#/$defs/moduleId"
        },
        "publisher": {
          "$ref": "#/$defs/moduleId"
        },
        "policy_reasons": {
          "type": "array",
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "enum": [
              "candidate_limit_exceeded",
              "runtime_capability_required",
              "module_blocked_by_policy",
              "publisher_not_allowed"
            ]
          }
        }
      }
    }
  }
}
