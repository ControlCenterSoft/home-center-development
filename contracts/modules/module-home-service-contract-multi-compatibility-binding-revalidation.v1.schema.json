{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "home-center.module-home-service-contract-multi-compatibility-binding-revalidation.v1",
  "title": "Module Home Service Multi Compatibility Binding Revalidation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "revalidation_id",
    "status",
    "original_multi_compatibility_binding_id",
    "fresh_multi_compatibility_binding_id",
    "original_multi_requirement_set_id",
    "fresh_multi_requirement_set_id",
    "original_home_center_version",
    "fresh_home_center_version",
    "original_module_id",
    "fresh_module_id",
    "original_module_version",
    "fresh_module_version",
    "original_service_ids",
    "fresh_service_ids",
    "original_service_evidence_sha256",
    "fresh_service_evidence_sha256",
    "original_blocked_service_ids",
    "fresh_blocked_service_ids",
    "original_compatibility_status",
    "fresh_compatibility_status",
    "drift_reasons",
    "admission_authorized",
    "installation_authorized",
    "execution_authorized",
    "production_mutation_enabled",
    "external_publication_authorized"
  ],
  "properties": {
    "schema": {
      "const": "home-center.module-home-service-contract-multi-compatibility-binding-revalidation.v1"
    },
    "revalidation_id": {
      "type": "string",
      "pattern": "^mhsmcbr-[0-9a-f]{24}$"
    },
    "status": {
      "enum": ["current", "stale"]
    },
    "original_multi_compatibility_binding_id": {
      "type": "string",
      "pattern": "^mhsmcb-[0-9a-f]{24}$"
    },
    "fresh_multi_compatibility_binding_id": {
      "type": "string",
      "pattern": "^mhsmcb-[0-9a-f]{24}$"
    },
    "original_multi_requirement_set_id": {
      "type": "string",
      "pattern": "^mhsmr-[0-9a-f]{24}$"
    },
    "fresh_multi_requirement_set_id": {
      "type": "string",
      "pattern": "^mhsmr-[0-9a-f]{24}$"
    },
    "original_home_center_version": {
      "$ref": "#/$defs/semver"
    },
    "fresh_home_center_version": {
      "$ref": "#/$defs/semver"
    },
    "original_module_id": {
      "$ref": "#/$defs/moduleId"
    },
    "fresh_module_id": {
      "$ref": "#/$defs/moduleId"
    },
    "original_module_version": {
      "$ref": "#/$defs/semver"
    },
    "fresh_module_version": {
      "$ref": "#/$defs/semver"
    },
    "original_service_ids": {
      "$ref": "#/$defs/serviceIds"
    },
    "fresh_service_ids": {
      "$ref": "#/$defs/serviceIds"
    },
    "original_service_evidence_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "fresh_service_evidence_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "original_blocked_service_ids": {
      "$ref": "#/$defs/blockedServiceIds"
    },
    "fresh_blocked_service_ids": {
      "$ref": "#/$defs/blockedServiceIds"
    },
    "original_compatibility_status": {
      "enum": ["compatible", "blocked"]
    },
    "fresh_compatibility_status": {
      "enum": ["compatible", "blocked"]
    },
    "drift_reasons": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 9,
      "items": {
        "enum": [
          "aggregate_compatibility_evidence_changed",
          "blocked_service_set_changed",
          "compatibility_status_changed",
          "home_center_version_changed",
          "module_identity_changed",
          "module_version_changed",
          "multi_requirement_set_changed",
          "service_compatibility_evidence_changed",
          "service_set_changed"
        ]
      }
    },
    "admission_authorized": {"const": false},
    "installation_authorized": {"const": false},
    "execution_authorized": {"const": false},
    "production_mutation_enabled": {"const": false},
    "external_publication_authorized": {"const": false}
  },
  "$defs": {
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "moduleId": {
      "type": "string",
      "pattern": "^[a-z0-9](?:[a-z0-9.-]{0,126}[a-z0-9])?$"
    },
    "serviceId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.:-]{1,127}$"
    },
    "serviceIds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/serviceId"}
    },
    "blockedServiceIds": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/serviceId"}
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
