{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "home-center.module-home-service-contract-requirement-set.v1.schema.json",
  "title": "Home Center Module Home Service Contract Requirement Set v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "requirement_set_id",
    "home_center_version",
    "module_id",
    "module_version",
    "service_id",
    "required_service_contracts",
    "admission_authorized",
    "installation_authorized",
    "execution_authorized",
    "production_mutation_enabled",
    "external_publication_authorized"
  ],
  "properties": {
    "schema": {
      "const": "home-center.module-home-service-contract-requirement-set.v1"
    },
    "requirement_set_id": {
      "type": "string",
      "pattern": "^mhscr-[0-9a-f]{24}$"
    },
    "home_center_version": {
      "$ref": "#/$defs/semver"
    },
    "module_id": {
      "type": "string",
      "pattern": "^[a-z0-9](?:[a-z0-9.-]{0,126}[a-z0-9])?$"
    },
    "module_version": {
      "$ref": "#/$defs/semver"
    },
    "service_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.:-]{1,127}$"
    },
    "required_service_contracts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9.-]{1,126}\\.v[1-9][0-9]*$"
      }
    },
    "admission_authorized": {
      "const": false
    },
    "installation_authorized": {
      "const": false
    },
    "execution_authorized": {
      "const": false
    },
    "production_mutation_enabled": {
      "const": false
    },
    "external_publication_authorized": {
      "const": false
    }
  },
  "$defs": {
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    }
  }
}
