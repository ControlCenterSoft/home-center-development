{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "home-center.module-home-service-contract-multi-compatibility-binding.v1.schema.json",
  "title": "Home Center Module Home Service Contract Multi Compatibility Binding v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "multi_compatibility_binding_id",
    "multi_requirement_set_id",
    "home_center_version",
    "module_id",
    "module_version",
    "service_compatibility_bindings",
    "blocked_service_ids",
    "compatibility_status",
    "admission_authorized",
    "installation_authorized",
    "execution_authorized",
    "production_mutation_enabled",
    "external_publication_authorized"
  ],
  "properties": {
    "schema": {
      "const": "home-center.module-home-service-contract-multi-compatibility-binding.v1"
    },
    "multi_compatibility_binding_id": {
      "type": "string",
      "pattern": "^mhsmcb-[0-9a-f]{24}$"
    },
    "multi_requirement_set_id": {
      "type": "string",
      "pattern": "^mhsmr-[0-9a-f]{24}$"
    },
    "home_center_version": {
      "$ref": "#/$defs/semver"
    },
    "module_id": {
      "type": "string",
      "pattern": "^[a-z0-9](?:[a-z0-9.-]{0,126}[a-z0-9])?$"
    },
    "module_version": {
      "$ref": "#/$defs/semver"
    },
    "service_compatibility_bindings": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/serviceCompatibility"
      }
    },
    "blocked_service_ids": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/serviceId"
      }
    },
    "compatibility_status": {
      "enum": [
        "compatible",
        "blocked"
      ]
    },
    "admission_authorized": {
      "const": false
    },
    "installation_authorized": {
      "const": false
    },
    "execution_authorized": {
      "const": false
    },
    "production_mutation_enabled": {
      "const": false
    },
    "external_publication_authorized": {
      "const": false
    }
  },
  "$defs": {
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "serviceId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.:-]{1,127}$"
    },
    "contract": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9.-]{1,126}\\.v[1-9][0-9]*$"
    },
    "serviceCompatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "service_id",
        "requirement_set_id",
        "requirement_binding_id",
        "home_service_contract_binding_id",
        "service_profile_sha256",
        "required_service_contracts",
        "compatibility_status"
      ],
      "properties": {
        "service_id": {
          "$ref": "#/$defs/serviceId"
        },
        "requirement_set_id": {
          "type": "string",
          "pattern": "^mhscr-[0-9a-f]{24}$"
        },
        "requirement_binding_id": {
          "type": "string",
          "pattern": "^mhsrb-[0-9a-f]{24}$"
        },
        "home_service_contract_binding_id": {
          "type": "string",
          "pattern": "^mhscb-[0-9a-f]{24}$"
        },
        "service_profile_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "required_service_contracts": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/contract"
          }
        },
        "compatibility_status": {
          "enum": [
            "compatible",
            "blocked"
          ]
        }
      }
    }
  }
}
