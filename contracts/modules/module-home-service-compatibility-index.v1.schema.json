{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://home-center.local/contracts/modules/module-home-service-compatibility-index.v1.schema.json",
  "title": "Home Center Module Home Service Compatibility Index v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "index_id",
    "resource_version",
    "etag",
    "home_center_version",
    "module_count",
    "overall_status",
    "items",
    "admission_authorized",
    "installation_authorized",
    "execution_authorized",
    "production_mutation_enabled",
    "external_publication_authorized"
  ],
  "properties": {
    "schema": {
      "const": "home-center.module-home-service-compatibility-index.v1"
    },
    "index_id": {
      "type": "string",
      "pattern": "^mhsci-[0-9a-f]{24}$"
    },
    "resource_version": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "etag": {
      "type": "string",
      "pattern": "^\\\"mhsci-[0-9a-f]{64}\\\"$"
    },
    "home_center_version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "module_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4096
    },
    "overall_status": {
      "enum": ["compatible", "blocked", "stale"]
    },
    "items": {
      "type": "array",
      "maxItems": 4096,
      "items": {
        "$ref": "#/$defs/item"
      }
    },
    "admission_authorized": {"const": false},
    "installation_authorized": {"const": false},
    "execution_authorized": {"const": false},
    "production_mutation_enabled": {"const": false},
    "external_publication_authorized": {"const": false}
  },
  "$defs": {
    "service_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_.:-]{1,127}$"
      }
    },
    "blocked_service_ids": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_.:-]{1,127}$"
      }
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state_id",
        "state_resource_version",
        "state_etag",
        "module_id",
        "module_version",
        "freshness",
        "effective_status",
        "observed_compatibility_status",
        "service_ids",
        "blocked_service_ids"
      ],
      "properties": {
        "state_id": {
          "type": "string",
          "pattern": "^mhscs-[0-9a-f]{24}$"
        },
        "state_resource_version": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "state_etag": {
          "type": "string",
          "pattern": "^\\\"mhscs-[0-9a-f]{64}\\\"$"
        },
        "module_id": {
          "type": "string",
          "pattern": "^[a-z0-9](?:[a-z0-9.-]{0,126}[a-z0-9])?$"
        },
        "module_version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
        },
        "freshness": {
          "enum": ["current", "stale"]
        },
        "effective_status": {
          "enum": ["compatible", "blocked", "stale"]
        },
        "observed_compatibility_status": {
          "enum": ["compatible", "blocked"]
        },
        "service_ids": {
          "$ref": "#/$defs/service_ids"
        },
        "blocked_service_ids": {
          "$ref": "#/$defs/blocked_service_ids"
        }
      }
    }
  }
}
