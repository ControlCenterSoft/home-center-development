{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "home-center.module-candidate-set-decision.v1.schema.json",
  "title": "Home Center Module Candidate Set Decision v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "candidate_set_id",
    "status",
    "snapshot_id",
    "home_center_version",
    "architecture",
    "operating_system",
    "available_capabilities",
    "installed_modules",
    "planned_modules",
    "candidates",
    "blocked_modules",
    "installation_authorized",
    "execution_authorized",
    "production_mutation_enabled",
    "external_publication_authorized"
  ],
  "properties": {
    "schema": {"const": "home-center.module-candidate-set-decision.v1"},
    "candidate_set_id": {"type": "string", "pattern": "^mcsd-[0-9a-f]{24}$"},
    "status": {"enum": ["compatible", "blocked"]},
    "snapshot_id": {"type": "string", "pattern": "^mcs-[0-9a-f]{24}$"},
    "home_center_version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
    "architecture": {"type": "string", "minLength": 1, "maxLength": 128},
    "operating_system": {"type": "string", "minLength": 1, "maxLength": 128},
    "available_capabilities": {
      "type": "array",
      "maxItems": 256,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 128}
    },
    "installed_modules": {
      "type": "array",
      "maxItems": 256,
      "items": {"$ref": "#/$defs/moduleVersion"}
    },
    "planned_modules": {
      "type": "array",
      "maxItems": 384,
      "items": {"$ref": "#/$defs/moduleVersion"}
    },
    "candidates": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {"$ref": "#/$defs/candidate"}
    },
    "blocked_modules": {
      "type": "array",
      "maxItems": 128,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z0-9](?:[a-z0-9.-]{0,126}[a-z0-9])?$"}
    },
    "installation_authorized": {"const": false},
    "execution_authorized": {"const": false},
    "production_mutation_enabled": {"const": false},
    "external_publication_authorized": {"const": false}
  },
  "$defs": {
    "moduleVersion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9](?:[a-z0-9.-]{0,126}[a-z0-9])?$"},
        "version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"}
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "module_id",
        "module_version",
        "decision_id",
        "status",
        "manifest_binding_sha256",
        "artifact_sha256",
        "reasons"
      ],
      "properties": {
        "module_id": {"type": "string", "pattern": "^[a-z0-9](?:[a-z0-9.-]{0,126}[a-z0-9])?$"},
        "module_version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
        "decision_id": {"type": "string", "pattern": "^madm-[0-9a-f]{24}$"},
        "status": {"enum": ["compatible", "blocked"]},
        "manifest_binding_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "artifact_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "reasons": {
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 128}
        }
      }
    }
  }
}
