{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "home-center.module-legal-compliance-evidence.v1.schema.json",
  "title": "Home Center Module Legal Compliance Evidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "evidence_id",
    "module_id",
    "module_version",
    "artifact_sha256",
    "license_expression",
    "authoritative_source",
    "distribution_mode",
    "commercial_use_disposition",
    "redistribution_disposition",
    "notice_required",
    "source_offer_required",
    "license_evidence_version",
    "license_evidence_sha256",
    "admission_authorized",
    "installation_authorized",
    "execution_authorized",
    "production_mutation_enabled",
    "external_publication_authorized"
  ],
  "properties": {
    "schema": {"const": "home-center.module-legal-compliance-evidence.v1"},
    "evidence_id": {"type": "string", "pattern": "^mlce-[0-9a-f]{24}$"},
    "module_id": {"type": "string", "maxLength": 128, "pattern": "^[a-z0-9](?:[a-z0-9.-]{0,126}[a-z0-9])?$"},
    "module_version": {"$ref": "#/$defs/semver"},
    "artifact_sha256": {"$ref": "#/$defs/digest"},
    "license_expression": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[A-Za-z0-9.+(): -]{1,256}$"},
    "authoritative_source": {"type": "string", "minLength": 1, "maxLength": 1024},
    "distribution_mode": {"enum": ["bundled", "system-package", "official-download", "customer-provided"]},
    "commercial_use_disposition": {"$ref": "#/$defs/disposition"},
    "redistribution_disposition": {"$ref": "#/$defs/disposition"},
    "notice_required": {"type": "boolean"},
    "source_offer_required": {"type": "boolean"},
    "license_evidence_version": {"$ref": "#/$defs/semver"},
    "license_evidence_sha256": {"$ref": "#/$defs/digest"},
    "admission_authorized": {"const": false},
    "installation_authorized": {"const": false},
    "execution_authorized": {"const": false},
    "production_mutation_enabled": {"const": false},
    "external_publication_authorized": {"const": false}
  },
  "$defs": {
    "semver": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "disposition": {"enum": ["allowed", "conditional", "prohibited", "unknown"]}
  }
}
