{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://home-center.local/contracts/modules/module-admission-decision.v1.schema.json",
  "title": "Home Center module compatibility admission decision v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "decision_id",
    "status",
    "module_id",
    "module_version",
    "publisher",
    "manifest_binding_sha256",
    "provenance_statement_sha256",
    "verified_signing_key_ids",
    "artifact_sha256",
    "home_center_version",
    "architecture",
    "operating_system",
    "available_capabilities",
    "installed_modules",
    "missing_capabilities",
    "unsatisfied_dependencies",
    "active_conflicts",
    "reasons",
    "installation_authorized",
    "execution_authorized",
    "production_mutation_enabled",
    "external_publication_authorized"
  ],
  "properties": {
    "schema": {
      "const": "home-center.module-admission-decision.v1"
    },
    "decision_id": {
      "type": "string",
      "pattern": "^madm-[0-9a-f]{24}$"
    },
    "status": {
      "enum": [
        "compatible",
        "blocked"
      ]
    },
    "module_id": {
      "$ref": "#/$defs/moduleId"
    },
    "module_version": {
      "$ref": "#/$defs/semver"
    },
    "publisher": {
      "$ref": "#/$defs/moduleId"
    },
    "manifest_binding_sha256": {
      "$ref": "#/$defs/digest"
    },
    "provenance_statement_sha256": {
      "$ref": "#/$defs/digest"
    },
    "verified_signing_key_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/keyId"
      }
    },
    "artifact_sha256": {
      "$ref": "#/$defs/digest"
    },
    "home_center_version": {
      "$ref": "#/$defs/semver"
    },
    "architecture": {
      "$ref": "#/$defs/symbolicId"
    },
    "operating_system": {
      "$ref": "#/$defs/symbolicId"
    },
    "available_capabilities": {
      "type": "array",
      "maxItems": 256,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/symbolicId"
      }
    },
    "installed_modules": {
      "type": "array",
      "maxItems": 256,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "version"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/moduleId"
          },
          "version": {
            "$ref": "#/$defs/semver"
          }
        }
      }
    },
    "missing_capabilities": {
      "type": "array",
      "maxItems": 128,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/symbolicId"
      }
    },
    "unsatisfied_dependencies": {
      "type": "array",
      "maxItems": 128,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/moduleId"
      }
    },
    "active_conflicts": {
      "type": "array",
      "maxItems": 128,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/moduleId"
      }
    },
    "reasons": {
      "type": "array",
      "maxItems": 6,
      "uniqueItems": true,
      "items": {
        "enum": [
          "architecture_unsupported",
          "capability_missing",
          "conflict_present",
          "dependency_unsatisfied",
          "home_center_version_unsupported",
          "operating_system_unsupported"
        ]
      }
    },
    "installation_authorized": {
      "const": false
    },
    "execution_authorized": {
      "const": false
    },
    "production_mutation_enabled": {
      "const": false
    },
    "external_publication_authorized": {
      "const": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "compatible"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "missing_capabilities": {
            "maxItems": 0
          },
          "unsatisfied_dependencies": {
            "maxItems": 0
          },
          "active_conflicts": {
            "maxItems": 0
          },
          "reasons": {
            "maxItems": 0
          }
        }
      },
      "else": {
        "properties": {
          "reasons": {
            "minItems": 1
          }
        }
      }
    }
  ],
  "$defs": {
    "semver": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "moduleId": {
      "type": "string",
      "maxLength": 128,
      "pattern": "^[a-z0-9](?:[a-z0-9.-]{0,126}[a-z0-9])?$"
    },
    "symbolicId": {
      "type": "string",
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"
    },
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "keyId": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
