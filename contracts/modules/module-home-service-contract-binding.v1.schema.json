{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "home-center.module-home-service-contract-binding.v1.schema.json",
  "title": "Home Center Module Home Service Contract Binding v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "binding_id",
    "module_contract_admission_binding_id",
    "home_center_version",
    "module_id",
    "module_version",
    "service_profile_schema",
    "service_profile_sha256",
    "service_id",
    "service_kind",
    "required_service_contracts",
    "provided_service_contracts",
    "unsupported_service_contracts",
    "status",
    "reasons",
    "admission_authorized",
    "installation_authorized",
    "execution_authorized",
    "production_mutation_enabled",
    "external_publication_authorized"
  ],
  "properties": {
    "schema": {
      "const": "home-center.module-home-service-contract-binding.v1"
    },
    "binding_id": {
      "type": "string",
      "pattern": "^mhscb-[0-9a-f]{24}$"
    },
    "module_contract_admission_binding_id": {
      "type": "string",
      "pattern": "^mcab-[0-9a-f]{24}$"
    },
    "home_center_version": {
      "$ref": "#/$defs/semver"
    },
    "module_id": {
      "type": "string",
      "pattern": "^[a-z0-9](?:[a-z0-9.-]{0,126}[a-z0-9])?$"
    },
    "module_version": {
      "$ref": "#/$defs/semver"
    },
    "service_profile_schema": {
      "const": "home-center.home-service-catalog.v1"
    },
    "service_profile_sha256": {
      "$ref": "#/$defs/digest"
    },
    "service_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.:-]{1,127}$"
    },
    "service_kind": {
      "enum": [
        "yandex-smart-home",
        "torrserver",
        "torrent-client",
        "zigbee-bridge",
        "minecraft-server",
        "android-mdm"
      ]
    },
    "required_service_contracts": {
      "$ref": "#/$defs/contracts"
    },
    "provided_service_contracts": {
      "$ref": "#/$defs/contractsMaybeEmpty"
    },
    "unsupported_service_contracts": {
      "$ref": "#/$defs/contractsMaybeEmpty"
    },
    "status": {
      "enum": [
        "compatible",
        "blocked"
      ]
    },
    "reasons": {
      "type": "array",
      "maxItems": 2,
      "uniqueItems": true,
      "items": {
        "enum": [
          "module_admission_blocked",
          "unsupported_service_contract"
        ]
      }
    },
    "admission_authorized": {
      "const": false
    },
    "installation_authorized": {
      "const": false
    },
    "execution_authorized": {
      "const": false
    },
    "production_mutation_enabled": {
      "const": false
    },
    "external_publication_authorized": {
      "const": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "compatible"
          }
        }
      },
      "then": {
        "properties": {
          "unsupported_service_contracts": {
            "maxItems": 0
          },
          "reasons": {
            "maxItems": 0
          }
        }
      },
      "else": {
        "properties": {
          "reasons": {
            "minItems": 1
          }
        }
      }
    }
  ],
  "$defs": {
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "contract": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9.-]{1,126}\\.v[1-9][0-9]*$"
    },
    "contracts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/contract"
      }
    },
    "contractsMaybeEmpty": {
      "type": "array",
      "maxItems": 128,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/contract"
      }
    }
  }
}
