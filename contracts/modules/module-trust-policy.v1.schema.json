{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://home-center.local/contracts/modules/module-trust-policy.v1.schema.json",
  "title": "Home Center offline module-publisher trust policy v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "publisher", "payload_type", "threshold", "keys"],
  "properties": {
    "schema": {"const": "home-center.module-trust-policy.v1"},
    "publisher": {"type": "string", "maxLength": 128, "pattern": "^[a-z0-9](?:[a-z0-9.-]{0,126}[a-z0-9])?$"},
    "payload_type": {"const": "application/vnd.home-center.module-provenance.v1+json"},
    "threshold": {"type": "integer", "minimum": 1, "maximum": 16},
    "keys": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["keyid", "algorithm", "state", "public_key_pem"],
        "properties": {
          "keyid": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
          "algorithm": {"const": "ecdsa-p256-sha256"},
          "state": {"enum": ["active", "retired", "revoked"]},
          "public_key_pem": {"type": "string", "minLength": 100, "maxLength": 4096}
        }
      }
    }
  }
}
