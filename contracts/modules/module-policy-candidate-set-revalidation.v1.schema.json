{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "home-center.module-policy-candidate-set-revalidation.v1.schema.json",
  "title": "Home Center Module Policy Candidate Set Revalidation v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "revalidation_id",
    "status",
    "original_decision_id",
    "fresh_decision_id",
    "original_policy_id",
    "fresh_policy_id",
    "original_policy_version",
    "fresh_policy_version",
    "original_candidate_set_id",
    "fresh_candidate_set_id",
    "original_snapshot_id",
    "fresh_snapshot_id",
    "original_status",
    "fresh_status",
    "original_base_status",
    "fresh_base_status",
    "original_base_blocked_modules",
    "fresh_base_blocked_modules",
    "original_policy_blocked_modules",
    "fresh_policy_blocked_modules",
    "original_blocked_modules",
    "fresh_blocked_modules",
    "original_missing_required_runtime_capabilities",
    "fresh_missing_required_runtime_capabilities",
    "original_policy_reasons",
    "fresh_policy_reasons",
    "original_modules",
    "fresh_modules",
    "stale_modules",
    "drift_reasons",
    "installation_authorized",
    "execution_authorized",
    "production_mutation_enabled",
    "external_publication_authorized"
  ],
  "properties": {
    "schema": {
      "const": "home-center.module-policy-candidate-set-revalidation.v1"
    },
    "revalidation_id": {
      "type": "string",
      "pattern": "^mpcsr-[0-9a-f]{24}$"
    },
    "status": {
      "enum": [
        "current",
        "stale"
      ]
    },
    "original_decision_id": {
      "$ref": "#/$defs/decisionId"
    },
    "fresh_decision_id": {
      "$ref": "#/$defs/decisionId"
    },
    "original_policy_id": {
      "$ref": "#/$defs/policyId"
    },
    "fresh_policy_id": {
      "$ref": "#/$defs/policyId"
    },
    "original_policy_version": {
      "$ref": "#/$defs/semver"
    },
    "fresh_policy_version": {
      "$ref": "#/$defs/semver"
    },
    "original_candidate_set_id": {
      "$ref": "#/$defs/candidateSetId"
    },
    "fresh_candidate_set_id": {
      "$ref": "#/$defs/candidateSetId"
    },
    "original_snapshot_id": {
      "$ref": "#/$defs/snapshotId"
    },
    "fresh_snapshot_id": {
      "$ref": "#/$defs/snapshotId"
    },
    "original_status": {
      "$ref": "#/$defs/compatibilityStatus"
    },
    "fresh_status": {
      "$ref": "#/$defs/compatibilityStatus"
    },
    "original_base_status": {
      "$ref": "#/$defs/compatibilityStatus"
    },
    "fresh_base_status": {
      "$ref": "#/$defs/compatibilityStatus"
    },
    "original_base_blocked_modules": {
      "$ref": "#/$defs/moduleIds"
    },
    "fresh_base_blocked_modules": {
      "$ref": "#/$defs/moduleIds"
    },
    "original_policy_blocked_modules": {
      "$ref": "#/$defs/moduleIds"
    },
    "fresh_policy_blocked_modules": {
      "$ref": "#/$defs/moduleIds"
    },
    "original_blocked_modules": {
      "$ref": "#/$defs/moduleIds"
    },
    "fresh_blocked_modules": {
      "$ref": "#/$defs/moduleIds"
    },
    "original_missing_required_runtime_capabilities": {
      "$ref": "#/$defs/capabilities"
    },
    "fresh_missing_required_runtime_capabilities": {
      "$ref": "#/$defs/capabilities"
    },
    "original_policy_reasons": {
      "$ref": "#/$defs/policyReasons"
    },
    "fresh_policy_reasons": {
      "$ref": "#/$defs/policyReasons"
    },
    "original_modules": {
      "$ref": "#/$defs/moduleResults"
    },
    "fresh_modules": {
      "$ref": "#/$defs/moduleResults"
    },
    "stale_modules": {
      "$ref": "#/$defs/moduleIds"
    },
    "drift_reasons": {
      "$ref": "#/$defs/driftReasons"
    },
    "installation_authorized": {
      "const": false
    },
    "execution_authorized": {
      "const": false
    },
    "production_mutation_enabled": {
      "const": false
    },
    "external_publication_authorized": {
      "const": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "current"
          }
        }
      },
      "then": {
        "properties": {
          "drift_reasons": {
            "maxItems": 0
          },
          "stale_modules": {
            "maxItems": 0
          }
        }
      },
      "else": {
        "properties": {
          "drift_reasons": {
            "minItems": 1
          }
        }
      }
    }
  ],
  "$defs": {
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "moduleId": {
      "type": "string",
      "pattern": "^[a-z0-9](?:[a-z0-9.-]{0,126}[a-z0-9])?$"
    },
    "symbolicId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"
    },
    "decisionId": {
      "type": "string",
      "pattern": "^mpcs-[0-9a-f]{24}$"
    },
    "policyId": {
      "type": "string",
      "pattern": "^mcp-[0-9a-f]{24}$"
    },
    "candidateSetId": {
      "type": "string",
      "pattern": "^mcsd-[0-9a-f]{24}$"
    },
    "snapshotId": {
      "type": "string",
      "pattern": "^mcs-[0-9a-f]{24}$"
    },
    "compatibilityStatus": {
      "enum": [
        "compatible",
        "blocked"
      ]
    },
    "moduleIds": {
      "type": "array",
      "maxItems": 128,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/moduleId"
      }
    },
    "capabilities": {
      "type": "array",
      "maxItems": 256,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/symbolicId"
      }
    },
    "policyReason": {
      "enum": [
        "candidate_limit_exceeded",
        "runtime_capability_required",
        "module_blocked_by_policy",
        "publisher_not_allowed"
      ]
    },
    "policyReasons": {
      "type": "array",
      "maxItems": 4,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/policyReason"
      }
    },
    "moduleResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "module_id",
        "publisher",
        "policy_reasons"
      ],
      "properties": {
        "module_id": {
          "$ref": "#/$defs/moduleId"
        },
        "publisher": {
          "$ref": "#/$defs/moduleId"
        },
        "policy_reasons": {
          "$ref": "#/$defs/policyReasons"
        }
      }
    },
    "moduleResults": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "$ref": "#/$defs/moduleResult"
      }
    },
    "driftReason": {
      "enum": [
        "compatibility_policy_changed",
        "policy_version_changed",
        "runtime_snapshot_changed",
        "candidate_set_changed",
        "candidate_membership_changed",
        "aggregate_status_changed",
        "base_compatibility_changed",
        "base_blocked_module_set_changed",
        "policy_blocked_module_set_changed",
        "blocked_module_set_changed",
        "policy_runtime_requirement_outcome_changed",
        "policy_reason_set_changed",
        "module_policy_outcome_changed",
        "policy_candidate_set_evidence_changed"
      ]
    },
    "driftReasons": {
      "type": "array",
      "maxItems": 14,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/driftReason"
      }
    }
  }
}
