{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://home-center.local/contracts/modules/module-home-service-compatibility-state.v1.schema.json",
  "title": "Home Center module Home Service compatibility state v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "state_id",
    "resource_version",
    "etag",
    "home_center_version",
    "module_id",
    "module_version",
    "source_multi_compatibility_binding_id",
    "fresh_multi_compatibility_binding_id",
    "revalidation_id",
    "freshness",
    "effective_status",
    "observed_compatibility_status",
    "service_ids",
    "blocked_service_ids",
    "drift_reasons",
    "admission_authorized",
    "installation_authorized",
    "execution_authorized",
    "production_mutation_enabled",
    "external_publication_authorized"
  ],
  "properties": {
    "schema": {
      "const": "home-center.module-home-service-compatibility-state.v1"
    },
    "state_id": {
      "type": "string",
      "pattern": "^mhscs-[0-9a-f]{24}$"
    },
    "resource_version": {
      "$ref": "#/$defs/digest"
    },
    "etag": {
      "type": "string",
      "pattern": "^\\\"mhscs-[0-9a-f]{64}\\\"$"
    },
    "home_center_version": {
      "$ref": "#/$defs/semver"
    },
    "module_id": {
      "$ref": "#/$defs/moduleId"
    },
    "module_version": {
      "$ref": "#/$defs/semver"
    },
    "source_multi_compatibility_binding_id": {
      "type": "string",
      "pattern": "^mhsmcb-[0-9a-f]{24}$"
    },
    "fresh_multi_compatibility_binding_id": {
      "type": "string",
      "pattern": "^mhsmcb-[0-9a-f]{24}$"
    },
    "revalidation_id": {
      "type": "string",
      "pattern": "^mhsmcbr-[0-9a-f]{24}$"
    },
    "freshness": {
      "enum": [
        "current",
        "stale"
      ]
    },
    "effective_status": {
      "enum": [
        "compatible",
        "blocked",
        "stale"
      ]
    },
    "observed_compatibility_status": {
      "enum": [
        "compatible",
        "blocked"
      ]
    },
    "service_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/serviceId"
      }
    },
    "blocked_service_ids": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/serviceId"
      }
    },
    "drift_reasons": {
      "type": "array",
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "enum": [
          "aggregate_compatibility_evidence_changed",
          "blocked_service_set_changed",
          "compatibility_status_changed",
          "home_center_version_changed",
          "module_identity_changed",
          "module_version_changed",
          "multi_requirement_set_changed",
          "service_compatibility_evidence_changed",
          "service_set_changed"
        ]
      }
    },
    "admission_authorized": {
      "const": false
    },
    "installation_authorized": {
      "const": false
    },
    "execution_authorized": {
      "const": false
    },
    "production_mutation_enabled": {
      "const": false
    },
    "external_publication_authorized": {
      "const": false
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "semver": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "moduleId": {
      "type": "string",
      "maxLength": 128,
      "pattern": "^[a-z0-9](?:[a-z0-9.-]{0,126}[a-z0-9])?$"
    },
    "serviceId": {
      "type": "string",
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9_.:-]{1,127}$"
    }
  }
}
