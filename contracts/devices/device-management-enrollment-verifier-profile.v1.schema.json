{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://home-center.local/contracts/devices/device-management-enrollment-verifier-profile.v1.schema.json",
  "title": "Home Center enrollment verifier profile v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "provider_id",
    "verifier_id",
    "verifier_revision",
    "result_schema",
    "signals",
    "verification_read_only",
    "source_sha256"
  ],
  "properties": {
    "schema": {"const": "home-center.device-management-enrollment-verifier-profile.v1"},
    "provider_id": {"type": "string", "pattern": "^[a-z][a-z0-9_.:-]{1,127}$"},
    "verifier_id": {"type": "string", "pattern": "^[a-z][a-z0-9_.:-]{1,127}$"},
    "verifier_revision": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$"},
    "result_schema": {"const": "home-center.device-management-enrollment-post-condition-result.v1"},
    "signals": {
      "type": "array",
      "prefixItems": [
        {"const": "certificate"},
        {"const": "profile"},
        {"const": "agent"}
      ],
      "items": false,
      "minItems": 3,
      "maxItems": 3
    },
    "verification_read_only": {"const": true},
    "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
