{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://home-center.local/contracts/devices/device-management-enrollment-adapter-verify-result.v1.schema.json",
  "title": "Home Center device management enrollment adapter verify result v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "state",
    "verification_id",
    "provider_operation_id",
    "device_id",
    "provider_device_reference",
    "enrollment_completed",
    "post_condition_verified",
    "managed_state_change_authorized",
    "policy_application_authorized",
    "infrastructure_mutation_authorized",
    "external_publication_authorized"
  ],
  "properties": {
    "schema": {"const": "home-center.device-management-enrollment-adapter-verify-result.v1"},
    "state": {"const": "verified"},
    "verification_id": {"type": "string", "pattern": "^dmpverify-[0-9a-f]{24}$"},
    "provider_operation_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "device_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "provider_device_reference": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,239}$"},
    "enrollment_completed": {"const": true},
    "post_condition_verified": {"const": true},
    "managed_state_change_authorized": {"const": false},
    "policy_application_authorized": {"const": false},
    "infrastructure_mutation_authorized": {"const": false},
    "external_publication_authorized": {"const": false}
  }
}
