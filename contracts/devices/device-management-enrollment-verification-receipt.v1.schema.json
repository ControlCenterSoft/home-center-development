{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://home-center.local/contracts/devices/device-management-enrollment-verification-receipt.v1.schema.json",
  "title": "Home Center device management enrollment verification receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "state",
    "verification_id",
    "execution_plan_id",
    "execution_job_id",
    "provider_id",
    "provider_operation_id",
    "provider_device_reference",
    "device_id",
    "member_id",
    "previous_snapshot_id",
    "previous_resource_version",
    "snapshot_id",
    "resource_version",
    "generation",
    "commit_id",
    "enrollment_completed",
    "post_condition_verified",
    "managed_state_change_authorized",
    "policy_application_authorized",
    "infrastructure_mutation_authorized",
    "external_publication_authorized"
  ],
  "properties": {
    "schema": {"const": "home-center.device-management-enrollment-verification-receipt.v1"},
    "state": {"const": "managed-state-applied"},
    "verification_id": {"type": "string", "pattern": "^dmpverify-[0-9a-f]{24}$"},
    "execution_plan_id": {"type": "string", "pattern": "^dmpexec-[0-9a-f]{24}$"},
    "execution_job_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "provider_id": {"type": "string", "pattern": "^[a-z][a-z0-9_.:-]{1,127}$"},
    "provider_operation_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "provider_device_reference": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,239}$"},
    "device_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "member_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "previous_snapshot_id": {"type": "string", "pattern": "^hsnap-[a-f0-9]{24}$"},
    "previous_resource_version": {"type": "string", "pattern": "^hrv-[a-f0-9]{24}$"},
    "snapshot_id": {"type": "string", "pattern": "^hsnap-[a-f0-9]{24}$"},
    "resource_version": {"type": "string", "pattern": "^hrv-[a-f0-9]{24}$"},
    "generation": {"type": "integer", "minimum": 2},
    "commit_id": {"type": "string", "pattern": "^hcommit-[a-z0-9-]{1,127}$"},
    "enrollment_completed": {"const": true},
    "post_condition_verified": {"const": true},
    "managed_state_change_authorized": {"const": true},
    "policy_application_authorized": {"const": false},
    "infrastructure_mutation_authorized": {"const": false},
    "external_publication_authorized": {"const": false}
  }
}
