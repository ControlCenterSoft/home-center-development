{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://home-center.local/contracts/devices/device-management-enrollment-policy-handoff.v1.schema.json",
  "title": "Home Center verified enrollment policy handoff v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "handoff_id",
    "commit_job_id",
    "verification_id",
    "execution_job_id",
    "enrollment_plan_id",
    "household_id",
    "device_id",
    "member_id",
    "commit_id",
    "resource_version",
    "generation",
    "snapshot_id",
    "audit_event_id",
    "policy_context_ready",
    "separate_policy_plan_required",
    "separate_confirmation_required",
    "policy_application_authorized",
    "policy_execution_authorized",
    "provider_mutation_authorized",
    "infrastructure_mutation_authorized",
    "external_publication_authorized"
  ],
  "properties": {
    "schema": {"const": "home-center.device-management-enrollment-policy-handoff.v1"},
    "handoff_id": {"type": "string", "pattern": "^dmphandoff-[0-9a-f]{24}$"},
    "commit_job_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "verification_id": {"type": "string", "pattern": "^dmpverify-[0-9a-f]{24}$"},
    "execution_job_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "enrollment_plan_id": {"type": "string", "pattern": "^dmpexec-[0-9a-f]{24}$"},
    "household_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "device_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "member_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "commit_id": {"type": "string", "pattern": "^hcommit-[0-9a-f]{24}$"},
    "resource_version": {"type": "string", "pattern": "^hrv-[0-9a-f]{24}$"},
    "generation": {"type": "integer", "minimum": 2},
    "snapshot_id": {"type": "string", "pattern": "^hsnap-[0-9a-f]{24}$"},
    "audit_event_id": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "policy_context_ready": {"const": true},
    "separate_policy_plan_required": {"const": true},
    "separate_confirmation_required": {"const": true},
    "policy_application_authorized": {"const": false},
    "policy_execution_authorized": {"const": false},
    "provider_mutation_authorized": {"const": false},
    "infrastructure_mutation_authorized": {"const": false},
    "external_publication_authorized": {"const": false}
  }
}
