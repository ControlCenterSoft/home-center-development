{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://home-center.local/contracts/devices/device-management-enrollment-execution-plan.v1.schema.json",
  "title": "Home Center device management enrollment execution plan v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "plan_id", "selection_proposal_id", "enrollment_proposal_id", "household_id", "snapshot_id",
    "resource_version", "generation", "actor_member_id", "device_id", "member_id", "catalog_id", "provider_id",
    "enrollment_mode", "credential_references", "timeout_seconds", "one_time_artifact", "confirmation_required",
    "durable_job_required", "audit_required", "provider_execution_authorized", "credential_value_access_authorized",
    "policy_application_authorized", "managed_state_change_authorized", "infrastructure_mutation_authorized",
    "external_publication_authorized"
  ],
  "properties": {
    "schema": {"const": "home-center.device-management-enrollment-execution-plan.v1"},
    "plan_id": {"type": "string", "pattern": "^dmpexec-[0-9a-f]{24}$"},
    "selection_proposal_id": {"type": "string", "pattern": "^dmpsel-[0-9a-f]{24}$"},
    "enrollment_proposal_id": {"type": "string", "minLength": 1},
    "household_id": {"type": "string", "minLength": 1},
    "snapshot_id": {"type": "string", "minLength": 1},
    "resource_version": {"type": "string", "minLength": 1},
    "generation": {"type": "integer", "minimum": 1},
    "actor_member_id": {"type": "string", "minLength": 1},
    "device_id": {"type": "string", "minLength": 1},
    "member_id": {"type": "string", "minLength": 1},
    "catalog_id": {"type": "string", "pattern": "^dmpcat-[0-9a-f]{24}$"},
    "provider_id": {"type": "string", "pattern": "^[a-z][a-z0-9_.:-]{1,127}$"},
    "enrollment_mode": {"type": "string", "pattern": "^[a-z][a-z0-9_.:-]{1,127}$"},
    "credential_references": {
      "type": "array", "maxItems": 16,
      "items": {"type": "object", "additionalProperties": false, "required": ["name", "reference"],
        "properties": {"name": {"type": "string", "pattern": "^[a-z][a-z0-9_.:-]{1,127}$"},
          "reference": {"type": "string", "pattern": "^secret://[A-Za-z0-9][A-Za-z0-9._/-]{0,239}$"}}}
    },
    "timeout_seconds": {"type": "integer", "minimum": 30, "maximum": 1800},
    "one_time_artifact": {"type": "string", "enum": ["none", "token", "qr"]},
    "confirmation_required": {"const": true},
    "durable_job_required": {"const": true},
    "audit_required": {"const": true},
    "provider_execution_authorized": {"const": false},
    "credential_value_access_authorized": {"const": false},
    "policy_application_authorized": {"const": false},
    "managed_state_change_authorized": {"const": false},
    "infrastructure_mutation_authorized": {"const": false},
    "external_publication_authorized": {"const": false}
  }
}
