{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://home-center.local/contracts/devices/device-management-enrollment-managed-state-commit-receipt.v1.schema.json",
  "title": "Home Center verified enrollment managed-state commit receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "state", "job_id", "verification_id", "execution_job_id", "plan_id",
    "household_id", "device_id", "member_id", "commit_id",
    "previous_resource_version", "resource_version", "generation", "snapshot_id",
    "audit_event_id", "post_condition_verified", "managed_state_change_authorized",
    "managed_state_change_committed", "provider_mutation_authorized",
    "policy_application_authorized", "infrastructure_mutation_authorized",
    "external_publication_authorized", "audit_required"
  ],
  "properties": {
    "schema": {"const": "home-center.device-management-enrollment-managed-state-commit-receipt.v1"},
    "state": {"const": "managed-state-committed"},
    "job_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "verification_id": {"type": "string", "pattern": "^dmpverify-[0-9a-f]{24}$"},
    "execution_job_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "plan_id": {"type": "string", "pattern": "^dmpexec-[0-9a-f]{24}$"},
    "household_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "device_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "member_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "commit_id": {"type": "string", "pattern": "^hcommit-[0-9a-f]{24}$"},
    "previous_resource_version": {"type": "string", "pattern": "^hrv-[0-9a-f]{24}$"},
    "resource_version": {"type": "string", "pattern": "^hrv-[0-9a-f]{24}$"},
    "generation": {"type": "integer", "minimum": 2},
    "snapshot_id": {"type": "string", "pattern": "^hsnap-[0-9a-f]{24}$"},
    "audit_event_id": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "post_condition_verified": {"const": true},
    "managed_state_change_authorized": {"const": true},
    "managed_state_change_committed": {"const": true},
    "provider_mutation_authorized": {"const": false},
    "policy_application_authorized": {"const": false},
    "infrastructure_mutation_authorized": {"const": false},
    "external_publication_authorized": {"const": false},
    "audit_required": {"const": true}
  }
}
