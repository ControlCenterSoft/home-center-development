{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://home-center.local/contracts/devices/device-management-enrollment-adapter-cancel-result.v1.schema.json",
  "title": "Home Center provider enrollment adapter cancel result v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "state", "provider_operation_id", "post_condition_verified", "managed_state_change_authorized"],
  "properties": {
    "schema": {"const": "home-center.device-management-enrollment-adapter-cancel-result.v1"},
