{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://home-center.local/contracts/devices/device-management-provider-selection-confirmation.v1.schema.json",
  "title": "Home Center device-management provider selection confirmation v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "proposal_id", "resolution_plan_id", "enrollment_proposal_id", "device_id", "member_id",
    "selected_provider_id", "snapshot_id", "resource_version", "generation", "catalog_id", "audit_event_id",
    "outcome", "provider_selected", "provider_execution_authorized", "credential_access_authorized",
    "enrollment_authorized", "policy_application_authorized", "managed_state_change_authorized",
    "infrastructure_mutation_authorized", "external_publication_authorized"
  ],
  "properties": {
    "schema": {"const": "home-center.device-management-provider-selection-confirmation.v1"},
    "proposal_id": {"type": "string", "pattern": "^dmpsel-[0-9a-f]{24}$"},
    "resolution_plan_id": {"type": "string", "pattern": "^dmpr-[0-9a-f]{24}$"},
    "enrollment_proposal_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "device_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "member_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "selected_provider_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "snapshot_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "resource_version": {"type": "string", "minLength": 1, "maxLength": 256},
    "generation": {"type": "integer", "minimum": 1},
    "catalog_id": {"type": "string", "pattern": "^dmpcat-[0-9a-f]{24}$"},
    "audit_event_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "outcome": {"enum": ["provider-selected", "already-confirmed"]},
    "provider_selected": {"const": true},
    "provider_execution_authorized": {"const": false},
    "credential_access_authorized": {"const": false},
    "enrollment_authorized": {"const": false},
    "policy_application_authorized": {"const": false},
    "managed_state_change_authorized": {"const": false},
    "infrastructure_mutation_authorized": {"const": false},
    "external_publication_authorized": {"const": false}
  }
}
