{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://home-center.local/contracts/devices/device-management-enrollment-managed-state-apply-receipt.v1.schema.json",
  "title": "Home Center managed-state apply receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "state", "verification_id", "device_id", "member_id", "previous_snapshot_id", "previous_resource_version", "snapshot_id", "resource_version", "generation", "commit_id", "post_condition_verified", "managed_state_change_authorized", "managed_state_applied", "policy_application_authorized", "infrastructure_mutation_authorized", "external_publication_authorized"],
  "properties": {
    "schema": {"const": "home-center.device-management-enrollment-managed-state-apply-receipt.v1"},
    "state": {"enum": ["planned", "applied"]},
    "verification_id": {"type": "string", "pattern": "^dmpverify-[0-9a-f]{24}$"},
    "device_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "member_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "previous_snapshot_id": {"type": "string", "pattern": "^hsnap-[0-9a-f]{24}$"},
    "previous_resource_version": {"type": "string", "pattern": "^hrv-[0-9a-f]{24}$"},
    "snapshot_id": {"type": "string", "pattern": "^hsnap-[0-9a-f]{24}$"},
    "resource_version": {"type": "string", "pattern": "^hrv-[0-9a-f]{24}$"},
    "generation": {"type": "integer", "minimum": 2},
    "commit_id": {"type": "string", "pattern": "^hcommit-[0-9a-f]{24}$"},
    "post_condition_verified": {"const": true},
    "managed_state_change_authorized": {"const": true},
    "managed_state_applied": {"type": "boolean"},
    "policy_application_authorized": {"const": false},
    "infrastructure_mutation_authorized": {"const": false},
    "external_publication_authorized": {"const": false}
  },
  "allOf": [
    {"if": {"properties": {"state": {"const": "planned"}}}, "then": {"properties": {"managed_state_applied": {"const": false}}}},
    {"if": {"properties": {"state": {"const": "applied"}}}, "then": {"properties": {"managed_state_applied": {"const": true}}}}
  ]
}
