{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://home-center.local/contracts/devices/device-management-enrollment-verification-request.v1.schema.json",
  "title": "Home Center enrollment post-condition verification request v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "verification_id",
    "execution_job_id",
    "plan_id",
    "provider_id",
    "provider_operation_id",
    "household_id",
    "snapshot_id",
    "resource_version",
    "generation",
    "device_id",
    "member_id",
    "provider_readback_authorized",
    "credential_value_access_authorized",
    "policy_application_authorized",
    "managed_state_change_authorized",
    "infrastructure_mutation_authorized",
    "external_publication_authorized"
  ],
  "properties": {
    "schema": {"const": "home-center.device-management-enrollment-verification-request.v1"},
    "verification_id": {"type": "string", "pattern": "^dmpverify-[0-9a-f]{24}$"},
    "execution_job_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "plan_id": {"type": "string", "pattern": "^dmpexec-[0-9a-f]{24}$"},
    "provider_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "provider_operation_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "household_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "snapshot_id": {"type": "string", "pattern": "^hsnap-[0-9a-f]{24}$"},
    "resource_version": {"type": "string", "pattern": "^hrv-[0-9a-f]{24}$"},
    "generation": {"type": "integer", "minimum": 1},
    "device_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "member_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "provider_readback_authorized": {"const": true},
    "credential_value_access_authorized": {"const": false},
    "policy_application_authorized": {"const": false},
    "managed_state_change_authorized": {"const": false},
    "infrastructure_mutation_authorized": {"const": false},
    "external_publication_authorized": {"const": false}
  }
}
