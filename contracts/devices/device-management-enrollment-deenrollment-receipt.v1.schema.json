{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://home-center.local/contracts/devices/device-management-enrollment-deenrollment-receipt.v1.schema.json",
  "title": "Home Center enrollment cleanup de-enrollment receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "state", "job_id", "de_enrollment_id", "cleanup_id", "confirmation_id",
    "provider_id", "provider_operation_id", "cleanup_operation_id", "device_id",
    "post_cleanup_verified", "retry_planning_allowed", "retry_execution_authorized",
    "managed_state_change_authorized", "policy_application_authorized",
    "infrastructure_mutation_authorized", "external_publication_authorized"
  ],
  "properties": {
    "schema": {"const": "home-center.device-management-enrollment-deenrollment-receipt.v1"},
    "state": {"const": "provider-cleanup-accepted"},
    "job_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "de_enrollment_id": {"type": "string", "pattern": "^dmpdeenroll-[0-9a-f]{24}$"},
    "cleanup_id": {"type": "string", "pattern": "^dmpclean-[0-9a-f]{24}$"},
    "confirmation_id": {"type": "string", "pattern": "^dmpdeconfirm-[0-9a-f]{24}$"},
    "provider_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "provider_operation_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "cleanup_operation_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "device_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "post_cleanup_verified": {"const": false},
    "retry_planning_allowed": {"const": false},
    "retry_execution_authorized": {"const": false},
    "managed_state_change_authorized": {"const": false},
    "policy_application_authorized": {"const": false},
    "infrastructure_mutation_authorized": {"const": false},
    "external_publication_authorized": {"const": false}
  }
}
