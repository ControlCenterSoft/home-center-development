{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://home-center.local/contracts/device-management-enrollment-verification-plan.v1.schema.json",
  "title": "Home Center device management enrollment verification plan v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "verification_id",
    "execution_job_id",
    "execution_plan_id",
    "selection_proposal_id",
    "household_id",
    "snapshot_id",
    "resource_version",
    "generation",
    "actor_member_id",
    "device_id",
    "member_id",
    "provider_id",
    "provider_operation_id",
    "required_checks",
    "read_only_provider_observation",
    "provider_mutation_authorized",
    "credential_access_authorized",
    "managed_state_change_authorized",
    "policy_application_authorized",
    "infrastructure_mutation_authorized",
    "external_publication_authorized"
  ],
  "properties": {
    "schema": {"const": "home-center.device-management-enrollment-verification-plan.v1"},
    "verification_id": {"type": "string", "pattern": "^dmpverify-[0-9a-f]{24}$"},
    "execution_job_id": {"type": "string", "minLength": 1},
    "execution_plan_id": {"type": "string", "minLength": 1},
    "selection_proposal_id": {"type": "string", "minLength": 1},
    "household_id": {"type": "string", "minLength": 1},
    "snapshot_id": {"type": "string", "minLength": 1},
    "resource_version": {"type": "string", "minLength": 1},
    "generation": {"type": "integer", "minimum": 1},
    "actor_member_id": {"type": "string", "minLength": 1},
    "device_id": {"type": "string", "minLength": 1},
    "member_id": {"type": "string", "minLength": 1},
    "provider_id": {"type": "string", "minLength": 1},
    "provider_operation_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "required_checks": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["certificate", "profile", "agent"]}
    },
    "read_only_provider_observation": {"const": true},
    "provider_mutation_authorized": {"const": false},
    "credential_access_authorized": {"const": false},
    "managed_state_change_authorized": {"const": false},
    "policy_application_authorized": {"const": false},
    "infrastructure_mutation_authorized": {"const": false},
    "external_publication_authorized": {"const": false}
  }
}
