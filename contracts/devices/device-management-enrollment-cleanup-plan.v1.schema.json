{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://home-center.local/contracts/device-management-enrollment-cleanup-plan.v1.schema.json",
  "title": "Home Center device management enrollment cleanup plan v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "cleanup_id",
    "verification_id",
    "execution_job_id",
    "execution_plan_id",
    "household_id",
    "snapshot_id",
    "resource_version",
    "generation",
    "actor_member_id",
    "device_id",
    "member_id",
    "provider_id",
    "provider_operation_id",
    "verification_reason",
    "action",
    "explicit_confirmation_required",
    "provider_mutation_authorized",
    "retry_authorized",
    "managed_state_change_authorized",
    "policy_application_authorized",
    "infrastructure_mutation_authorized",
    "external_publication_authorized"
  ],
  "properties": {
    "schema": {"const": "home-center.device-management-enrollment-cleanup-plan.v1"},
    "cleanup_id": {"type": "string", "pattern": "^dmpclean-[0-9a-f]{24}$"},
    "verification_id": {"type": "string", "pattern": "^dmpverify-[0-9a-f]{24}$"},
    "execution_job_id": {"type": "string", "minLength": 1, "maxLength": 160},
    "execution_plan_id": {"type": "string", "pattern": "^dmpexec-[0-9a-f]{24}$"},
    "household_id": {"type": "string", "minLength": 1, "maxLength": 160},
    "snapshot_id": {"type": "string", "minLength": 1, "maxLength": 160},
    "resource_version": {"type": "string", "minLength": 1, "maxLength": 160},
    "generation": {"type": "integer", "minimum": 1},
    "actor_member_id": {"type": "string", "minLength": 1, "maxLength": 160},
    "device_id": {"type": "string", "minLength": 1, "maxLength": 160},
    "member_id": {"type": "string", "minLength": 1, "maxLength": 160},
    "provider_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "provider_operation_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "verification_reason": {
      "enum": [
        "provider-state-unknown",
        "provider-not-enrolled",
        "required-evidence-not-present",
        "required-evidence-not-applicable"
      ]
    },
    "action": {
      "enum": [
        "observe-provider-state",
        "no-provider-cleanup",
        "de-enroll-required"
      ]
    },
    "explicit_confirmation_required": {"type": "boolean"},
    "provider_mutation_authorized": {"const": false},
    "retry_authorized": {"const": false},
    "managed_state_change_authorized": {"const": false},
    "policy_application_authorized": {"const": false},
    "infrastructure_mutation_authorized": {"const": false},
    "external_publication_authorized": {"const": false}
  },
  "allOf": [
    {
      "if": {"properties": {"action": {"const": "de-enroll-required"}}},
      "then": {"properties": {"explicit_confirmation_required": {"const": true}}}
    },
    {
      "if": {
        "properties": {
          "action": {"enum": ["observe-provider-state", "no-provider-cleanup"]}
        }
      },
      "then": {"properties": {"explicit_confirmation_required": {"const": false}}}
    }
  ]
}
