{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://home-center.local/contracts/device-management-enrollment-verification-profile-catalog.v1.schema.json",
  "title": "Home Center device management enrollment verification profile catalog v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "catalog_id", "profiles", "trusted", "read_only"],
  "properties": {
    "schema": {"const": "home-center.device-management-enrollment-verification-profile-catalog.v1"},
    "catalog_id": {"type": "string", "pattern": "^dmpvcat-[0-9a-f]{24}$"},
    "profiles": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {"$ref": "device-management-enrollment-verification-profile.v1.schema.json"}
    },
    "trusted": {"const": true},
    "read_only": {"const": true}
  }
}
