{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://control-center.pro/schemas/home-center/device-management-enrollment-managed-transition-plan.v1.schema.json",
  "title": "Home Center device management enrollment managed transition plan v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "transition_id",
    "verification_id",
    "household_id",
    "snapshot_id",
    "resource_version",
    "generation",
    "actor_member_id",
    "device_id",
    "member_id",
    "provider_id",
    "provider_operation_id",
    "managed_before",
    "managed_after",
    "post_condition_verified",
    "policy_application_authorized",
    "provider_mutation_authorized",
    "infrastructure_mutation_authorized",
    "external_publication_authorized"
  ],
  "properties": {
    "schema": {"const": "home-center.device-management-enrollment-managed-transition-plan.v1"},
    "transition_id": {"type": "string", "pattern": "^dmmanaged-[0-9a-f]{24}$"},
    "verification_id": {"type": "string", "pattern": "^dmpverify-[0-9a-f]{24}$"},
    "household_id": {"type": "string", "minLength": 1},
    "snapshot_id": {"type": "string", "minLength": 1},
    "resource_version": {"type": "string", "minLength": 1},
    "generation": {"type": "integer", "minimum": 1},
    "actor_member_id": {"type": "string", "minLength": 1},
    "device_id": {"type": "string", "minLength": 1},
    "member_id": {"type": "string", "minLength": 1},
    "provider_id": {"type": "string", "minLength": 1},
    "provider_operation_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "managed_before": {"const": false},
    "managed_after": {"const": true},
    "post_condition_verified": {"const": true},
    "policy_application_authorized": {"const": false},
    "provider_mutation_authorized": {"const": false},
    "infrastructure_mutation_authorized": {"const": false},
    "external_publication_authorized": {"const": false}
  }
}
