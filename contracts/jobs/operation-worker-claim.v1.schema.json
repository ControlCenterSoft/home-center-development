{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://control-center.pro/contracts/jobs/operation-worker-claim.v1.schema.json",
  "title": "Home Center bounded operation worker claim",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "claim_id",
    "handoff_id",
    "job_id",
    "action_id",
    "plan_id",
    "plan_sha256",
    "request_sha256",
    "snapshot_sha256",
    "authorization_id",
    "target_node_id",
    "worker_id",
    "from_state",
    "to_state",
    "from_state_version",
    "to_state_version",
    "audit_event_id",
    "contains_command_material",
    "accepts_caller_argv",
    "accepts_shell",
    "execution_authorized",
    "production_mutation_enabled"
  ],
  "properties": {
    "schema": {"const": "home-center.operation-worker-claim.v1"},
    "claim_id": {"type": "string", "pattern": "^opclaim-[a-f0-9]{24}$"},
    "handoff_id": {"type": "string", "pattern": "^ophandoff-[a-f0-9]{24}$"},
    "job_id": {"type": "string", "pattern": "^opjob-[a-f0-9]{24}$"},
    "action_id": {"const": "service.restart.v1"},
    "plan_id": {"type": "string", "pattern": "^opcmd-[a-f0-9]{24}$"},
    "plan_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "request_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "snapshot_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "authorization_id": {"type": "string", "pattern": "^opauth-[a-f0-9]{24}$"},
    "target_node_id": {"type": "string", "pattern": "^[a-z][a-z0-9._-]{2,63}$"},
    "worker_id": {"type": "string", "pattern": "^[a-z][a-z0-9._-]{2,63}$"},
    "from_state": {"const": "prepared"},
    "to_state": {"const": "running"},
    "from_state_version": {"type": "integer", "minimum": 1},
    "to_state_version": {"type": "integer", "minimum": 2},
    "audit_event_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "contains_command_material": {"const": false},
    "accepts_caller_argv": {"const": false},
    "accepts_shell": {"const": false},
    "execution_authorized": {"const": false},
    "production_mutation_enabled": {"const": false}
  }
}
