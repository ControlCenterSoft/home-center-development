{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://controlcentersoft.example/contracts/jobs/operation-worker-handoff.v1.schema.json",
  "title": "Home Center Operation Worker Handoff v1",
  "description": "Non-executable evidence binding one durable prepared operation job to a target-node worker and exact CAS state version.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "handoff_id",
    "job_id",
    "action_id",
    "plan_id",
    "plan_sha256",
    "request_sha256",
    "snapshot_sha256",
    "authorization_id",
    "target_node_id",
    "worker_id",
    "expected_state",
    "expected_state_version",
    "revalidate_before_execution",
    "audit_required",
    "contains_command_material",
    "accepts_caller_argv",
    "accepts_shell",
    "direct_execution",
    "production_mutation_enabled"
  ],
  "properties": {
    "schema": {"const": "home-center.operation-worker-handoff.v1"},
    "handoff_id": {"type": "string", "pattern": "^ophandoff-[a-f0-9]{24}$"},
    "job_id": {"type": "string", "pattern": "^opjob-[a-f0-9]{24}$"},
    "action_id": {"const": "service.restart.v1"},
    "plan_id": {"type": "string", "pattern": "^opcmd-[a-f0-9]{24}$"},
    "plan_sha256": {"$ref": "#/$defs/sha256"},
    "request_sha256": {"$ref": "#/$defs/sha256"},
    "snapshot_sha256": {"$ref": "#/$defs/sha256"},
    "authorization_id": {"type": "string", "pattern": "^opauth-[a-f0-9]{24}$"},
    "target_node_id": {"$ref": "#/$defs/identifier"},
    "worker_id": {"$ref": "#/$defs/identifier"},
    "expected_state": {"const": "prepared"},
    "expected_state_version": {"type": "integer", "minimum": 1},
    "revalidate_before_execution": {"const": true},
    "audit_required": {"const": true},
    "contains_command_material": {"const": false},
    "accepts_caller_argv": {"const": false},
    "accepts_shell": {"const": false},
    "direct_execution": {"const": false},
    "production_mutation_enabled": {"const": false}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "identifier": {"type": "string", "pattern": "^[a-z][a-z0-9._-]{2,63}$"}
  }
}
