{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://controlcenter.example/contracts/jobs/operation-recovery-retry-execution-receipt.v1.schema.json",
  "title": "Home Center operation recovery retry execution receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "receipt_id",
    "retry_claim_id",
    "admission_id",
    "rollback_verification_receipt_id",
    "rollback_execution_receipt_id",
    "job_id",
    "action_id",
    "plan_id",
    "plan_sha256",
    "worker_id",
    "target_node_id",
    "recovery_sha256",
    "command_sha256",
    "started",
    "timed_out",
    "exit_code",
    "elapsed_ms",
    "retry_succeeded",
    "recovery_required",
    "from_state",
    "next_state",
    "from_state_version",
    "to_state_version",
    "audit_event_id",
    "verification_required",
    "single_use",
    "contains_command_material",
    "accepts_caller_argv",
    "accepts_shell",
    "grants_execution_authority",
    "production_mutation_enabled"
  ],
  "properties": {
    "schema": {
      "const": "home-center.operation-recovery-retry-execution-receipt.v1"
    },
    "receipt_id": {
      "type": "string",
      "pattern": "^oprecoveryexec-[a-f0-9]{24}$"
    },
    "retry_claim_id": {
      "type": "string",
      "pattern": "^oprecoveryclaim-[a-f0-9]{24}$"
    },
    "admission_id": {
      "type": "string",
      "pattern": "^oprecoveryretry-[a-f0-9]{24}$"
    },
    "rollback_verification_receipt_id": {
      "type": "string",
      "pattern": "^oprollbackverify-[a-f0-9]{24}$"
    },
    "rollback_execution_receipt_id": {
      "type": "string",
      "pattern": "^oprollbackexec-[a-f0-9]{24}$"
    },
    "job_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "action_id": {
      "const": "service.restart.v1"
    },
    "plan_id": {
      "type": "string",
      "pattern": "^opcmd-[a-f0-9]{24}$"
    },
    "plan_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "worker_id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 64
    },
    "target_node_id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 64
    },
    "recovery_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "command_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "started": {
      "type": "boolean"
    },
    "timed_out": {
      "type": "boolean"
    },
    "exit_code": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": -255,
      "maximum": 255
    },
    "elapsed_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 15000
    },
    "retry_succeeded": {
      "type": "boolean"
    },
    "recovery_required": {
      "type": "boolean"
    },
    "from_state": {
      "const": "rolling_back"
    },
    "next_state": {
      "enum": [
        "rolling_back",
        "failed"
      ]
    },
    "from_state_version": {
      "type": "integer",
      "minimum": 1
    },
    "to_state_version": {
      "type": "integer",
      "minimum": 2
    },
    "audit_event_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "verification_required": {
      "type": "boolean"
    },
    "single_use": {
      "const": true
    },
    "contains_command_material": {
      "const": false
    },
    "accepts_caller_argv": {
      "const": false
    },
    "accepts_shell": {
      "const": false
    },
    "grants_execution_authority": {
      "const": false
    },
    "production_mutation_enabled": {
      "const": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "retry_succeeded": {
            "const": true
          }
        },
        "required": [
          "retry_succeeded"
        ]
      },
      "then": {
        "properties": {
          "started": {
            "const": true
          },
          "timed_out": {
            "const": false
          },
          "exit_code": {
            "const": 0
          },
          "recovery_required": {
            "const": false
          },
          "next_state": {
            "const": "rolling_back"
          },
          "verification_required": {
            "const": true
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "retry_succeeded": {
            "const": false
          }
        },
        "required": [
          "retry_succeeded"
        ]
      },
      "then": {
        "properties": {
          "recovery_required": {
            "const": true
          },
          "next_state": {
            "const": "failed"
          },
          "verification_required": {
            "const": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "started": {
            "const": false
          }
        },
        "required": [
          "started"
        ]
      },
      "then": {
        "properties": {
          "timed_out": {
            "const": false
          },
          "exit_code": {
            "const": null
          },
          "elapsed_ms": {
            "const": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "timed_out": {
            "const": true
          }
        },
        "required": [
          "timed_out"
        ]
      },
      "then": {
        "properties": {
          "started": {
            "const": true
          },
          "exit_code": {
            "const": null
          }
        }
      }
    }
  ]
}
