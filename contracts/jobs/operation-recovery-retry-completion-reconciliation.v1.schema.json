{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "home-center.operation-recovery-retry-completion-reconciliation.v1",
  "title": "Home Center recovery retry completion reconciliation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "checkpoint_id",
    "receipt_id",
    "receipt_sha256",
    "recovery_retry_execution_receipt_id",
    "job_id",
    "plan_id",
    "plan_sha256",
    "target_node_id",
    "audit_event_id",
    "audit_event_sha256",
    "observed_state",
    "observed_state_version",
    "claimed_recovery_verified",
    "claimed_recovery_required",
    "completion_status",
    "reason",
    "exact_completion_confirmed",
    "reconciliation_required",
    "contains_command_material",
    "accepts_caller_argv",
    "accepts_shell",
    "grants_execution_authority",
    "retry_authorized",
    "rollback_authorized",
    "production_mutation_enabled"
  ],
  "properties": {
    "schema": {
      "const": "home-center.operation-recovery-retry-completion-reconciliation.v1"
    },
    "checkpoint_id": {
      "type": "string",
      "pattern": "^oprecoveryreconcile-[0-9a-f]{24}$"
    },
    "receipt_id": {
      "type": "string",
      "pattern": "^oprecoveryverify-[0-9a-f]{24}$"
    },
    "receipt_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "recovery_retry_execution_receipt_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "job_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "plan_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "plan_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "target_node_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "audit_event_id": {
      "type": ["string", "null"],
      "minLength": 1,
      "maxLength": 128
    },
    "audit_event_sha256": {
      "oneOf": [
        {"type": "null"},
        {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      ]
    },
    "observed_state": {
      "type": ["string", "null"],
      "enum": [
        "prepared",
        "running",
        "verifying",
        "succeeded",
        "rolling_back",
        "rolled_back",
        "failed",
        null
      ]
    },
    "observed_state_version": {
      "type": ["integer", "null"],
      "minimum": 1
    },
    "claimed_recovery_verified": {"type": "boolean"},
    "claimed_recovery_required": {"type": "boolean"},
    "completion_status": {
      "type": "string",
      "enum": ["confirmed", "reconcile"]
    },
    "reason": {
      "type": "string",
      "enum": [
        "confirmed",
        "operation_job_missing",
        "completion_state_not_current",
        "verification_evidence_not_current",
        "audit_chain_invalid",
        "transition_audit_missing",
        "transition_audit_not_current",
        "completion_changed_during_reconciliation"
      ]
    },
    "exact_completion_confirmed": {"type": "boolean"},
    "reconciliation_required": {"type": "boolean"},
    "contains_command_material": {"const": false},
    "accepts_caller_argv": {"const": false},
    "accepts_shell": {"const": false},
    "grants_execution_authority": {"const": false},
    "retry_authorized": {"const": false},
    "rollback_authorized": {"const": false},
    "production_mutation_enabled": {"const": false}
  },
  "allOf": [
    {
      "if": {"properties": {"completion_status": {"const": "confirmed"}}},
      "then": {
        "properties": {
          "reason": {"const": "confirmed"},
          "exact_completion_confirmed": {"const": true},
          "reconciliation_required": {"const": false},
          "audit_event_id": {"type": "string"},
          "audit_event_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "observed_state": {"enum": ["rolled_back", "failed"]},
          "observed_state_version": {"type": "integer", "minimum": 1}
        }
      }
    },
    {
      "if": {"properties": {"completion_status": {"const": "reconcile"}}},
      "then": {
        "properties": {
          "reason": {"not": {"const": "confirmed"}},
          "exact_completion_confirmed": {"const": false},
          "reconciliation_required": {"const": true},
          "audit_event_sha256": {"type": "null"}
        }
      }
    },
    {
      "if": {"properties": {"claimed_recovery_verified": {"const": true}}},
      "then": {"properties": {"claimed_recovery_required": {"const": false}}}
    },
    {
      "if": {"properties": {"claimed_recovery_verified": {"const": false}}},
      "then": {"properties": {"claimed_recovery_required": {"const": true}}}
    }
  ]
}
