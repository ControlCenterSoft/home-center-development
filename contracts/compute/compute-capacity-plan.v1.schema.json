{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://home-center.local/contracts/compute/compute-capacity-plan.v1.schema.json",
  "title": "Home Center Compute Capacity Plan v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "request_id", "resource", "state", "selected_provider_id", "blockers", "evaluations", "selection_policy", "production_mutation_enabled"],
  "properties": {
    "schema": {"const": "home-center.compute-capacity-plan.v1"},
    "request_id": {"$ref": "#/$defs/identifier"},
    "resource": {"$ref": "#/$defs/resource"},
    "state": {"enum": ["planned", "blocked"]},
    "selected_provider_id": {"oneOf": [{"$ref": "#/$defs/identifier"}, {"type": "null"}]},
    "blockers": {"type": "array", "maxItems": 16, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9_:-]+$"}},
    "evaluations": {"type": "array", "maxItems": 64, "items": {"$ref": "#/$defs/evaluation"}},
    "selection_policy": {"const": "least-utilized-then-provider-id.v1"},
    "production_mutation_enabled": {"const": false}
  },
  "$defs": {
    "identifier": {"type": "string", "pattern": "^[a-z][a-z0-9_.:-]{1,127}$"},
    "capability": {"type": "string", "pattern": "^[a-z][a-z0-9.-]{1,126}\\.v[1-9][0-9]*$"},
    "capacity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["vcpu", "memory_mib", "storage_gib"],
      "properties": {
        "vcpu": {"type": "integer", "minimum": 0, "maximum": 65536},
        "memory_mib": {"type": "integer", "minimum": 0, "maximum": 16777216},
        "storage_gib": {"type": "integer", "minimum": 0, "maximum": 16777216}
      }
    },
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resource_id", "kind", "vcpu", "memory_mib", "disk_gib", "high_availability"],
      "properties": {
        "resource_id": {"$ref": "#/$defs/identifier"},
        "kind": {"enum": ["vm", "container", "lxc"]},
        "vcpu": {"type": "integer", "minimum": 1, "maximum": 256},
        "memory_mib": {"type": "integer", "minimum": 256, "maximum": 4194304},
        "disk_gib": {"type": "integer", "minimum": 1, "maximum": 1048576},
        "high_availability": {"type": "boolean"}
      }
    },
    "evaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider_id", "profile_id", "state", "blockers", "available_before", "available_after", "maximum_utilization_bps_after", "capacity_sequence"],
      "properties": {
        "provider_id": {"$ref": "#/$defs/identifier"},
        "profile_id": {"$ref": "#/$defs/capability"},
        "state": {"enum": ["planned", "blocked"]},
        "blockers": {"type": "array", "maxItems": 16, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9_:-]+$"}},
        "available_before": {"$ref": "#/$defs/capacity"},
        "available_after": {"oneOf": [{"$ref": "#/$defs/capacity"}, {"type": "null"}]},
        "maximum_utilization_bps_after": {"oneOf": [{"type": "integer", "minimum": 0, "maximum": 10000}, {"type": "null"}]},
        "capacity_sequence": {"type": "integer", "minimum": 0, "maximum": 9223372036854775807}
      }
    }
  }
}
