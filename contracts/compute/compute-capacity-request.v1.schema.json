{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://home-center.local/contracts/compute/compute-capacity-request.v1.schema.json",
  "title": "Home Center Compute Capacity Planning Request v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "request_id", "resource", "providers"],
  "properties": {
    "schema": {"const": "home-center.compute-capacity-request.v1"},
    "request_id": {"$ref": "#/$defs/identifier"},
    "resource": {"$ref": "#/$defs/resource"},
    "providers": {
      "type": "array",
      "maxItems": 64,
      "items": {"$ref": "#/$defs/provider_state"}
    }
  },
  "$defs": {
    "identifier": {"type": "string", "pattern": "^[a-z][a-z0-9_.:-]{1,127}$"},
    "capability": {"type": "string", "pattern": "^[a-z][a-z0-9.-]{1,126}\\.v[1-9][0-9]*$"},
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resource_id", "kind", "vcpu", "memory_mib", "disk_gib", "high_availability"],
      "properties": {
        "resource_id": {"$ref": "#/$defs/identifier"},
        "kind": {"enum": ["vm", "container", "lxc"]},
        "vcpu": {"type": "integer", "minimum": 1, "maximum": 256},
        "memory_mib": {"type": "integer", "minimum": 256, "maximum": 4194304},
        "disk_gib": {"type": "integer", "minimum": 1, "maximum": 1048576},
        "high_availability": {"type": "boolean"}
      }
    },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider_id", "profile_id", "healthy", "capabilities"],
      "properties": {
        "provider_id": {"$ref": "#/$defs/identifier"},
        "profile_id": {"$ref": "#/$defs/capability"},
        "healthy": {"type": "boolean"},
        "capabilities": {"type": "array", "maxItems": 128, "uniqueItems": true, "items": {"$ref": "#/$defs/capability"}}
      }
    },
    "provider_state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "capacity"],
      "properties": {
        "provider": {"$ref": "#/$defs/provider"},
        "capacity": {"$ref": "compute-capacity-snapshot.v1.schema.json"}
      }
    }
  }
}
