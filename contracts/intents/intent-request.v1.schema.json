{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://home-center.local/contracts/intents/intent-request.v1.schema.json",
  "title": "Intent Request v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "intent_id",
    "idempotency_key",
    "correlation_id",
    "actor",
    "reason",
    "kind",
    "target_id",
    "parameters",
    "mode"
  ],
  "properties": {
    "schema": {
      "const": "home-center.intent-request.v1"
    },
    "intent_id": {
      "type": "string",
      "format": "uuid"
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 8,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{7,127}$"
    },
    "correlation_id": {
      "type": "string",
      "minLength": 2,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9_.:-]{1,127}$"
    },
    "actor": {
      "type": "string",
      "minLength": 3,
      "maxLength": 128
    },
    "reason": {
      "type": "string",
      "minLength": 3,
      "maxLength": 500
    },
    "kind": {
      "enum": [
        "node.drain",
        "storage.share.create",
        "virtualization.workload.create",
        "module.install"
      ]
    },
    "target_id": {
      "type": "string",
      "minLength": 2,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9_.:-]{1,127}$"
    },
    "parameters": {
      "type": "object",
      "maxProperties": 32
    },
    "mode": {
      "const": "plan"
    }
  }
}
