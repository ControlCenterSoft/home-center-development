{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://home-center.local/contracts/intents/intent-plan.v1.schema.json",
  "title": "Intent Plan v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "intent_id",
    "kind",
    "target_id",
    "state",
    "code",
    "steps",
    "blockers",
    "production_execution_enabled"
  ],
  "properties": {
    "schema": {
      "const": "home-center.intent-plan.v1"
    },
    "intent_id": {
      "type": "string",
      "format": "uuid"
    },
    "kind": {
      "enum": [
        "node.drain",
        "storage.share.create",
        "virtualization.workload.create",
        "module.install"
      ]
    },
    "target_id": {
      "type": "string",
      "minLength": 2,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9_.:-]{1,127}$"
    },
    "state": {
      "enum": ["planned", "blocked"]
    },
    "code": {
      "type": "string",
      "minLength": 2,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9_.:-]{1,127}$"
    },
    "steps": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "schema",
          "sequence",
          "module",
          "action",
          "target_id",
          "input",
          "execution_requires_approval"
        ],
        "properties": {
          "schema": {
            "const": "home-center.intent-step.v1"
          },
          "sequence": {
            "type": "integer",
            "minimum": 1,
            "maximum": 32
          },
          "module": {
            "enum": [
              "node-manager",
              "storage-manager",
              "virtualization-manager",
              "module-manager",
              "backup-manager"
            ]
          },
          "action": {
            "type": "string",
            "minLength": 4,
            "maxLength": 96,
            "pattern": "^[a-z][a-z0-9.-]{1,95}\\.v[1-9][0-9]*$"
          },
          "target_id": {
            "type": "string",
            "minLength": 2,
            "maxLength": 128,
            "pattern": "^[a-z][a-z0-9_.:-]{1,127}$"
          },
          "input": {
            "type": "object",
            "maxProperties": 32
          },
          "execution_requires_approval": {
            "type": "boolean"
          }
        }
      }
    },
    "blockers": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "string",
        "minLength": 2,
        "maxLength": 128,
        "pattern": "^[a-z][a-z0-9_.:-]{1,127}$"
      }
    },
    "production_execution_enabled": {
      "const": false
    }
  }
}
