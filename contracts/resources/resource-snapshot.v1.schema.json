{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://home-center.local/contracts/resources/resource-snapshot.v1.schema.json",
  "title": "Resource Snapshot v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "cluster_id",
    "state",
    "planning_ready",
    "production_mutation_enabled",
    "totals",
    "nodes"
  ],
  "properties": {
    "schema": {"const": "home-center.resource-snapshot.v1"},
    "cluster_id": {"type": "string", "minLength": 3, "maxLength": 128},
    "state": {"enum": ["ready", "degraded"]},
    "planning_ready": {"type": "boolean"},
    "production_mutation_enabled": {"const": false},
    "totals": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observed_nodes",
        "expected_nodes",
        "ready_nodes",
        "cpu_count",
        "memory_bytes",
        "root_storage_total_bytes",
        "root_storage_used_bytes",
        "root_storage_free_bytes"
      ],
      "properties": {
        "observed_nodes": {"type": "integer", "minimum": 0, "maximum": 64},
        "expected_nodes": {"type": "integer", "minimum": 1, "maximum": 64},
        "ready_nodes": {"type": "integer", "minimum": 0, "maximum": 64},
        "cpu_count": {"type": "integer", "minimum": 0},
        "memory_bytes": {"type": "integer", "minimum": 0},
        "root_storage_total_bytes": {"type": "integer", "minimum": 0},
        "root_storage_used_bytes": {"type": "integer", "minimum": 0},
        "root_storage_free_bytes": {"type": "integer", "minimum": 0}
      }
    },
    "nodes": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "node_id",
          "name",
          "role",
          "status",
          "observed_at",
          "cpu_count",
          "memory_bytes",
          "root_storage",
          "capabilities"
        ],
        "properties": {
          "node_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.-]{2,63}$"},
          "name": {"type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9.-]{0,62}$"},
          "role": {"enum": ["leader", "standby"]},
          "status": {"enum": ["ready", "unreachable"]},
          "observed_at": {"type": "string", "format": "date-time"},
          "cpu_count": {"type": "integer", "minimum": 1, "maximum": 4096},
          "memory_bytes": {"type": "integer", "minimum": 1},
          "root_storage": {
            "type": "object",
            "additionalProperties": false,
            "required": ["total_bytes", "used_bytes", "free_bytes"],
            "properties": {
              "total_bytes": {"type": "integer", "minimum": 1},
              "used_bytes": {"type": "integer", "minimum": 0},
              "free_bytes": {"type": "integer", "minimum": 0}
            }
          },
          "capabilities": {
            "type": "array",
            "maxItems": 128,
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.-]+\\.v[0-9]+$"}
          }
        }
      }
    }
  }
}
