{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Home Center Certificate Renewal Policy v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "certificate_id",
    "evaluated_at",
    "warning_days",
    "issuer_available",
    "service_reload_supported",
    "mode"
  ],
  "properties": {
    "schema": {"const": "home-center.certificate-renewal-policy.v1"},
    "certificate_id": {
      "type": "string",
      "minLength": 2,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9_.:-]{1,127}$"
    },
    "evaluated_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "warning_days": {"type": "integer", "minimum": 1, "maximum": 365},
    "issuer_available": {"type": "boolean"},
    "service_reload_supported": {"type": "boolean"},
    "mode": {"const": "plan"}
  }
}
