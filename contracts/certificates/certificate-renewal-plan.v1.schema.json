{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://home-center.local/contracts/certificates/certificate-renewal-plan.v1.schema.json",
  "title": "Home Center CertificateRenewalPlan v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "certificate_id", "service_id", "status", "state", "blockers", "production_mutation_enabled"],
  "properties": {
    "schema": {"const": "home-center.certificate-renewal-plan.v1"},
    "certificate_id": {"type": "string", "minLength": 2, "maxLength": 128},
    "service_id": {"type": "string", "minLength": 2, "maxLength": 128},
    "status": {"enum": ["valid", "expiring", "expired", "invalid"]},
    "state": {"enum": ["planned", "blocked"]},
    "blockers": {"type": "array", "maxItems": 16, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9_:-]+$"}},
    "production_mutation_enabled": {"const": false}
  }
}
