{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Home Center Certificate Renewal Plan v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "plan_id",
    "certificate_id",
    "service_id",
    "fingerprint_sha256",
    "not_after",
    "evaluated_at",
    "warning_days",
    "status",
    "validation",
    "state",
    "code",
    "steps",
    "blockers",
    "production_execution_enabled"
  ],
  "properties": {
    "schema": {"const": "home-center.certificate-renewal-plan.v2"},
    "plan_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "certificate_id": {"$ref": "#/$defs/identifier"},
    "service_id": {"$ref": "#/$defs/identifier"},
    "fingerprint_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "not_after": {"type": "string", "format": "date-time"},
    "evaluated_at": {"type": "string", "format": "date-time"},
    "warning_days": {"type": "integer", "minimum": 1, "maximum": 365},
    "status": {"enum": ["valid", "renewal_due", "expired"]},
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["chain_valid", "name_valid"],
      "properties": {
        "chain_valid": {"type": "boolean"},
        "name_valid": {"type": "boolean"}
      }
    },
    "state": {"enum": ["planned", "blocked"]},
    "code": {"enum": ["certificate_renewal_planned", "certificate_renewal_blocked"]},
    "steps": {
      "type": "array",
      "maxItems": 4,
      "items": {"$ref": "#/$defs/step"}
    },
    "blockers": {
      "type": "array",
      "maxItems": 16,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/identifier"}
    },
    "production_execution_enabled": {"const": false}
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 2,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9_.:-]{1,127}$"
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "sequence",
        "action",
        "certificate_id",
        "service_id",
        "execution_requires_approval"
      ],
      "properties": {
        "schema": {"const": "home-center.certificate-renewal-step.v1"},
        "sequence": {"type": "integer", "minimum": 1, "maximum": 4},
        "action": {
          "enum": [
            "certificate.request.v1",
            "certificate.validate.v1",
            "certificate.stage.v1",
            "service.reload.v1"
          ]
        },
        "certificate_id": {"$ref": "#/$defs/identifier"},
        "service_id": {"$ref": "#/$defs/identifier"},
        "execution_requires_approval": {"const": true}
      }
    }
  }
}
