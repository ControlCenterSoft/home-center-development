{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Home Center Certificate Inventory v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "evaluated_at", "warning_days", "items"],
  "properties": {
    "schema": {"const": "home-center.certificate-inventory.v1"},
    "evaluated_at": {"type": "string", "format": "date-time"},
    "warning_days": {"type": "integer", "minimum": 1, "maximum": 365},
    "items": {
      "type": "array",
      "maxItems": 128,
      "items": {"$ref": "#/$defs/item"}
    }
  },
  "$defs": {
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "certificate_id",
        "service_id",
        "fingerprint_sha256",
        "not_after",
        "status",
        "validation"
      ],
      "properties": {
        "schema": {"const": "home-center.certificate-inventory-item.v1"},
        "certificate_id": {
          "type": "string",
          "minLength": 2,
          "maxLength": 128,
          "pattern": "^[a-z][a-z0-9_.:-]{1,127}$"
        },
        "service_id": {
          "type": "string",
          "minLength": 2,
          "maxLength": 128,
          "pattern": "^[a-z][a-z0-9_.:-]{1,127}$"
        },
        "fingerprint_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "not_after": {"type": "string", "format": "date-time"},
        "status": {"enum": ["valid", "renewal_due", "expired"]},
        "validation": {"$ref": "#/$defs/validation"}
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["chain_valid", "name_valid"],
      "properties": {
        "chain_valid": {"type": "boolean"},
        "name_valid": {"type": "boolean"}
      }
    }
  }
}
