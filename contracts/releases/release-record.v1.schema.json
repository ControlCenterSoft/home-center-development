{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://home-center.local/contracts/releases/release-record.v1.schema.json",
  "title": "Home Center immutable release record v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "product", "version", "revision", "platform", "artifact", "provenance", "acceptance"],
  "properties": {
    "schema": {"const": "home-center.release-record.v1"},
    "product": {"const": "home-center"},
    "version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
    "revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "platform": {
      "type": "object",
      "additionalProperties": false,
      "required": ["os", "architecture"],
      "properties": {
        "os": {"const": "linux"},
        "architecture": {"const": "amd64"}
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["filename", "sha256", "bytes", "manifest_sha256", "media_type", "object_key"],
      "properties": {
        "filename": {"type": "string", "pattern": "^home-center-(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)-linux-amd64\\.tar\\.gz$"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "bytes": {"type": "integer", "minimum": 1, "maximum": 268435456},
        "manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "media_type": {"const": "application/gzip"},
        "object_key": {"type": "string", "pattern": "^sha256/[0-9a-f]{2}/[0-9a-f]{64}/home-center-[0-9]+\\.[0-9]+\\.[0-9]+-linux-amd64\\.tar\\.gz$"}
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "source_ref", "workflow", "workflow_sha256", "run_id", "run_attempt", "ci_artifact_id", "ci_outer_zip_sha256", "source_date_epoch"],
      "properties": {
        "repository": {"const": "ControlCenterSoft/home-center"},
        "source_ref": {"const": "refs/heads/main"},
        "workflow": {"const": ".github/workflows/ci.yml"},
        "workflow_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "run_id": {"type": "integer", "minimum": 1},
        "run_attempt": {"type": "integer", "minimum": 1},
        "ci_artifact_id": {"type": "integer", "minimum": 1},
        "ci_outer_zip_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "source_date_epoch": {"type": "integer", "minimum": 1}
      }
    },
    "acceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile", "status", "transaction_id", "accepted_at", "evidence_bundle_sha256", "evidence_refs", "required_checks"],
      "properties": {
        "profile": {"const": "home-center-example-two-node.v1"},
        "status": {"enum": ["passed", "failed"]},
        "transaction_id": {"type": "string", "minLength": 1, "maxLength": 96, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/#@+-]*$"},
        "accepted_at": {"type": "string", "format": "date-time"},
        "evidence_bundle_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "locator", "content_sha256"],
            "properties": {
              "kind": {"enum": ["github-issue-comment", "gdrive-document-revision", "server-command-result"]},
              "locator": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/#@+-]*$"},
              "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
            }
          }
        },
        "required_checks": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_.-]{0,63}$"}
        }
      }
    }
  }
}
