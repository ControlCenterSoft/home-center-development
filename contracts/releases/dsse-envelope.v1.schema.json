{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://home-center.local/contracts/releases/dsse-envelope.v1.schema.json",
  "title": "Home Center DSSE release-ledger envelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["payloadType", "payload", "signatures"],
  "properties": {
    "payloadType": {"const": "application/vnd.home-center.release-ledger.v1+json"},
    "payload": {"type": "string", "minLength": 4, "maxLength": 2097152, "pattern": "^[A-Za-z0-9+/]+={0,2}$"},
    "signatures": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["keyid", "sig"],
        "properties": {
          "keyid": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
          "sig": {"type": "string", "minLength": 12, "maxLength": 1024, "pattern": "^[A-Za-z0-9+/]+={0,2}$"}
        }
      }
    }
  }
}
