{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://control-center.pro/schemas/home-center/commercial-legal-qualification.v1.schema.json",
  "title": "Home Center commercial legal qualification decision v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "revision",
    "candidate_artifact_sha256",
    "external_review_sha256",
    "disposition",
    "evidence_sha256",
    "dependencies_reviewed",
    "redistribution_reviewed",
    "notices_prepared",
    "source_obligations_resolved",
    "sbom_reviewed",
    "legal_terms_dispositioned",
    "release_claims_reviewed",
    "qualified",
    "blockers",
    "release_authorized",
    "external_publication_authorized"
  ],
  "properties": {
    "schema": {"const": "home-center.commercial-legal-qualification.v1"},
    "version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
    "revision": {"type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"},
    "candidate_artifact_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "external_review_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "disposition": {"enum": ["approved", "review-required", "blocked"]},
    "evidence_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "dependencies_reviewed": {"type": "boolean"},
    "redistribution_reviewed": {"type": "boolean"},
    "notices_prepared": {"type": "boolean"},
    "source_obligations_resolved": {"type": "boolean"},
    "sbom_reviewed": {"type": "boolean"},
    "legal_terms_dispositioned": {"type": "boolean"},
    "release_claims_reviewed": {"type": "boolean"},
    "qualified": {"type": "boolean"},
    "blockers": {
      "type": "array",
      "items": {
        "enum": [
          "candidate_artifact_digest",
          "external_review_evidence",
          "commercial_disposition",
          "dependencies_reviewed",
          "redistribution_reviewed",
          "notices_prepared",
          "source_obligations_resolved",
          "sbom_reviewed",
          "legal_terms_dispositioned",
          "release_claims_reviewed"
        ]
      },
      "uniqueItems": true
    },
    "release_authorized": {"const": false},
    "external_publication_authorized": {"const": false}
  }
}
