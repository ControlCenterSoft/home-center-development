{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://control-center.pro/schemas/home-center/real-environment-evidence.v1.schema.json",
  "title": "Home Center real environment qualification evidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "revision",
    "candidate_artifact_sha256",
    "target_node_id",
    "target_environment_sha256",
    "target_execution_transcript_sha256",
    "target_install_or_upgrade_exercised",
    "target_health_ready",
    "target_user_state_preserved",
    "target_rollback_exercised",
    "ha_node_ids",
    "ha_environment_sha256",
    "ha_execution_transcript_sha256",
    "real_multi_node_contour_exercised",
    "replication_healthy",
    "peer_continuity_verified",
    "restart_exercised",
    "post_restart_health_ready",
    "ha_rollback_exercised"
  ],
  "properties": {
    "schema": {"const": "home-center.real-environment-evidence.v1"},
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "revision": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "candidate_artifact_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "target_node_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._-]{0,126}[A-Za-z0-9])?$"
    },
    "target_environment_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "target_execution_transcript_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "target_install_or_upgrade_exercised": {"type": "boolean"},
    "target_health_ready": {"type": "boolean"},
    "target_user_state_preserved": {"type": "boolean"},
    "target_rollback_exercised": {"type": "boolean"},
    "ha_node_ids": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._-]{0,126}[A-Za-z0-9])?$"
      }
    },
    "ha_environment_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "ha_execution_transcript_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "real_multi_node_contour_exercised": {"type": "boolean"},
    "replication_healthy": {"type": "boolean"},
    "peer_continuity_verified": {"type": "boolean"},
    "restart_exercised": {"type": "boolean"},
    "post_restart_health_ready": {"type": "boolean"},
    "ha_rollback_exercised": {"type": "boolean"}
  }
}
