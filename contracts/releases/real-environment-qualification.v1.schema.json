{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://control-center.pro/schemas/home-center/real-environment-qualification.v1.schema.json",
  "title": "Home Center real environment qualification decision v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "revision",
    "candidate_artifact_sha256",
    "evidence_sha256",
    "qualified",
    "blockers",
    "release_authorized",
    "external_publication_authorized"
  ],
  "properties": {
    "schema": {"const": "home-center.real-environment-qualification.v1"},
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "revision": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "candidate_artifact_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "evidence_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "qualified": {"type": "boolean"},
    "blockers": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "release_authorized": {"const": false},
    "external_publication_authorized": {"const": false}
  }
}
