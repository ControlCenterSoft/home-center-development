{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://control-center.pro/schemas/home-center/target-node-execution-transcript.v1.schema.json",
  "title": "Home Center target-node execution transcript v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "revision",
    "candidate_artifact_sha256",
    "target_node_id",
    "operation",
    "source_version",
    "source_revision",
    "target_version",
    "target_revision",
    "deployment_transaction_sha256",
    "install_or_upgrade_exercised",
    "service_active",
    "readyz_status",
    "user_state_preserved",
    "rollback_exercised",
    "rollback_version",
    "rollback_revision",
    "rollback_service_active",
    "rollback_readyz_status"
  ],
  "properties": {
    "schema": {"const": "home-center.target-node-execution-transcript.v1"},
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "revision": {"type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"},
    "candidate_artifact_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "target_node_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._-]{0,126}[A-Za-z0-9])?$"
    },
    "operation": {"const": "upgrade"},
    "source_version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "source_revision": {"type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"},
    "target_version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "target_revision": {"type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"},
    "deployment_transaction_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "install_or_upgrade_exercised": {"type": "boolean"},
    "service_active": {"type": "boolean"},
    "readyz_status": {"type": "integer", "minimum": 100, "maximum": 599},
    "user_state_preserved": {"type": "boolean"},
    "rollback_exercised": {"type": "boolean"},
    "rollback_version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "rollback_revision": {"type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"},
    "rollback_service_active": {"type": "boolean"},
    "rollback_readyz_status": {"type": "integer", "minimum": 100, "maximum": 599}
  }
}
