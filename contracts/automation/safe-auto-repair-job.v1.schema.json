{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://home-center.local/contracts/automation/safe-auto-repair-job.v1.schema.json",
  "title": "Home Center safe auto-repair Job v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "job_id",
    "admission_id",
    "recommendation_id",
    "recommendation_sha256",
    "idempotency_key_sha256",
    "state",
    "created_at_epoch",
    "updated_at_epoch",
    "effect_receipt_sha256",
    "post_condition_evidence_sha256",
    "post_condition_verified",
    "raw_idempotency_key_persisted",
    "automatic_retry_authorized",
    "execution_authorized",
    "provider_execution_authorized",
    "infrastructure_mutation_authorized",
    "external_publication_authorized"
  ],
  "properties": {
    "schema": {"const": "home-center.safe-auto-repair-job.v1"},
    "job_id": {"type": "string", "pattern": "^hcrpj-[0-9a-f]{24}$"},
    "admission_id": {"type": "string", "pattern": "^hcrpa-[0-9a-f]{24}$"},
    "recommendation_id": {"type": "string", "pattern": "^hcrpr-[0-9a-f]{24}$"},
    "recommendation_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "idempotency_key_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "state": {"enum": ["admitted", "running", "verifying", "succeeded", "failed", "reconcile-required"]},
    "created_at_epoch": {"type": "integer", "minimum": 0},
    "updated_at_epoch": {"type": "integer", "minimum": 0},
    "effect_receipt_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "post_condition_evidence_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "post_condition_verified": {"type": "boolean"},
    "raw_idempotency_key_persisted": {"const": false},
    "automatic_retry_authorized": {"const": false},
    "execution_authorized": {"const": false},
    "provider_execution_authorized": {"const": false},
    "infrastructure_mutation_authorized": {"const": false},
    "external_publication_authorized": {"const": false}
  }
}
