{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://home-center.local/contracts/automation/safe-auto-repair-adapter-apply-request.v1.schema.json",
  "title": "Home Center safe auto-repair adapter apply request v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema","job_id","adapter_id","adapter_version","recommendation_id","recommendation_sha256","household_id","resource_id","resource_generation","source_evidence_sha256","action","policy_id","policy_sha256","adapter_execution_authorized","credential_value_access_authorized","provider_execution_authorized","infrastructure_mutation_authorized","external_publication_authorized","post_condition_verified"],
  "properties": {
    "schema": {"const": "home-center.safe-auto-repair-adapter-apply-request.v1"},
    "job_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "adapter_id": {"type": "string", "pattern": "^[a-z0-9](?:[a-z0-9._-]{0,126}[a-z0-9])?$"},
    "adapter_version": {"type": "string", "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)$"},
    "recommendation_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "recommendation_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "household_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "resource_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "resource_generation": {"type": "integer", "minimum": 0},
    "source_evidence_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "action": {"enum": ["reconcile-derived-state","rebuild-derived-index","refresh-local-read-model"]},
    "policy_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "policy_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "adapter_execution_authorized": {"const": true},
    "credential_value_access_authorized": {"const": false},
    "provider_execution_authorized": {"const": false},
    "infrastructure_mutation_authorized": {"const": false},
    "external_publication_authorized": {"const": false},
    "post_condition_verified": {"const": false}
  }
}
