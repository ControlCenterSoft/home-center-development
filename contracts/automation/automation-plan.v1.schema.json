{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://home-center.invalid/contracts/automation/automation-plan.v1.schema.json",
  "title": "Device Automation Plan v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "rule_id",
    "state",
    "steps",
    "blockers",
    "production_mutation_enabled",
    "execution_authorized"
  ],
  "properties": {
    "schema": {"const": "home-center.automation-plan.v1"},
    "rule_id": {"type": "string", "pattern": "^[a-z][a-z0-9_.:-]{1,127}$"},
    "state": {"enum": ["planned", "blocked"]},
    "steps": {
      "type": "array",
      "maxItems": 64,
      "items": {"$ref": "#/$defs/step"}
    },
    "blockers": {
      "type": "array",
      "maxItems": 67,
      "items": {"type": "string", "minLength": 1, "maxLength": 256}
    },
    "production_mutation_enabled": {"const": false},
    "execution_authorized": {"const": false}
  },
  "oneOf": [
    {
      "properties": {
        "state": {"const": "planned"},
        "blockers": {"maxItems": 0}
      }
    },
    {
      "properties": {
        "state": {"const": "blocked"},
        "steps": {"maxItems": 0},
        "blockers": {"minItems": 1}
      }
    }
  ],
  "$defs": {
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sequence",
        "target_id",
        "capability",
        "command",
        "parameters",
        "requires_execution_authority"
      ],
      "properties": {
        "sequence": {"type": "integer", "minimum": 1, "maximum": 64},
        "target_id": {"type": "string", "pattern": "^[a-z][a-z0-9_.:-]{1,127}$"},
        "capability": {"type": "string", "pattern": "^[a-z][a-z0-9.-]{1,126}\\.v[1-9][0-9]*$"},
        "command": {"type": "string", "pattern": "^[a-z][a-z0-9_.:-]{1,127}$"},
        "parameters": {"type": "object", "maxProperties": 32},
        "requires_execution_authority": {"const": true}
      }
    }
  }
}
