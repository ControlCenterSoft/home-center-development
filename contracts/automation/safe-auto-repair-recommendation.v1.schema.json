{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://home-center.local/contracts/automation/safe-auto-repair-recommendation.v1.schema.json",
  "title": "Home Center safe auto-repair recommendation v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "recommendation_id",
    "household_id",
    "resource_id",
    "resource_generation",
    "evidence_sha256",
    "action",
    "risk",
    "policy_id",
    "policy_sha256",
    "eligible_for_auto_repair",
    "blockers",
    "recovery_proven",
    "post_condition_verification_required",
    "repair_history_required",
    "execution_authorized",
    "provider_execution_authorized",
    "infrastructure_mutation_authorized",
    "external_publication_authorized"
  ],
  "properties": {
    "schema": {"const": "home-center.safe-auto-repair-recommendation.v1"},
    "recommendation_id": {"type": "string", "pattern": "^hcrpr-[0-9a-f]{24}$"},
    "household_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "resource_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "resource_generation": {"type": "integer", "minimum": 0},
    "evidence_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "action": {
      "enum": ["reconcile-derived-state", "rebuild-derived-index", "refresh-local-read-model"]
    },
    "risk": {"enum": ["low", "medium", "high"]},
    "policy_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "policy_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "eligible_for_auto_repair": {"type": "boolean"},
    "blockers": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "action-not-allowed",
          "risk-not-allowed",
          "recovery-not-proven",
          "post-condition-not-verifiable",
          "provider-execution-required",
          "infrastructure-mutation-required",
          "external-publication-required"
        ]
      }
    },
    "recovery_proven": {"type": "boolean"},
    "post_condition_verification_required": {"const": true},
    "repair_history_required": {"const": true},
    "execution_authorized": {"const": false},
    "provider_execution_authorized": {"const": false},
    "infrastructure_mutation_authorized": {"const": false},
    "external_publication_authorized": {"const": false}
  }
}
