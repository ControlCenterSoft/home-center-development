{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://home-center.local/contracts/automation/runbook-plan-request.v1.schema.json",
  "title": "Automation Runbook Plan Request v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "runbook_id", "steps"],
  "properties": {
    "schema": {"const": "home-center.automation-runbook-plan-request.v1"},
    "runbook_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,63}$"},
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {"$ref": "#/$defs/step"}
    }
  },
  "$defs": {
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["step_id", "action_id", "target_node_id", "depends_on", "input"],
      "properties": {
        "step_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$"},
        "action_id": {
          "enum": [
            "backup.create.v1",
            "backup.verify.v1",
            "health.verify.v1",
            "inventory.refresh.v1"
          ]
        },
        "target_node_id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9._:-]{1,127}$"},
        "depends_on": {
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$"}
        },
        "input": {"type": "object"}
      },
      "allOf": [
        {
          "if": {"properties": {"action_id": {"const": "backup.create.v1"}}},
          "then": {"properties": {"input": {"$ref": "#/$defs/retentionInput"}}},
          "else": {"properties": {"input": {"$ref": "#/$defs/emptyInput"}}}
        }
      ]
    },
    "emptyInput": {
      "type": "object",
      "maxProperties": 0
    },
    "retentionInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["retention_class"],
      "properties": {"retention_class": {"enum": ["default", "protected"]}}
    }
  }
}
