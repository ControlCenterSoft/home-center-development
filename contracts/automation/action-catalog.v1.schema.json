{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://home-center.local/contracts/automation/action-catalog.v1.schema.json",
  "title": "Automation Action Catalog v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "actions", "arbitrary_commands_allowed"],
  "properties": {
    "schema": {"const": "home-center.automation-action-catalog.v1"},
    "actions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["action_id", "required_capability", "risk"],
        "properties": {
          "action_id": {
            "enum": [
              "backup.create.v1",
              "backup.verify.v1",
              "health.verify.v1",
              "inventory.refresh.v1"
            ]
          },
          "required_capability": {
            "enum": ["backup.sqlite.v1", "health.v1", "inventory.v1"]
          },
          "risk": {"enum": ["read-only", "bounded-change"]}
        }
      }
    },
    "arbitrary_commands_allowed": {"const": false}
  }
}
