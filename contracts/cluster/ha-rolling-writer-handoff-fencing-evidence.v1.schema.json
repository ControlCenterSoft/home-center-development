{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "home-center.ha-rolling-writer-handoff-fencing-evidence.v1",
  "title": "HA rolling writer handoff fencing evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "cluster_id",
    "evidence_id",
    "recovery_assessment_id",
    "handoff_receipt_id",
    "handoff_intent_id",
    "blocked_plan_id",
    "previous_writer_node_id",
    "successor_writer_node_id",
    "member_node_ids",
    "peer_snapshot_id",
    "peer_journal_seq",
    "role_assignment_id",
    "role_epoch",
    "role_resource_version",
    "role_journal_seq",
    "role_transition_id",
    "minimum_ready_nodes",
    "required_quorum_nodes",
    "ready_node_ids",
    "ready_count",
    "lease_id",
    "lease_epoch",
    "lease_resource_version",
    "lease_state_id",
    "lease_revoked",
    "fence_confirmed",
    "rollback_candidate_node_id",
    "rollback_admission_authorized",
    "role_transition_authorized",
    "failover_authorized",
    "host_mutation_authorized",
    "production_mutation_enabled"
  ],
  "properties": {
    "schema": {
      "const": "home-center.ha-rolling-writer-handoff-fencing-evidence.v1"
    },
    "cluster_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.:-]{1,127}$"
    },
    "evidence_id": {
      "type": "string",
      "pattern": "^ha-roll-writer-handoff-fencing-[a-f0-9]{64}$"
    },
    "recovery_assessment_id": {
      "type": "string",
      "pattern": "^ha-roll-writer-handoff-recovery-[a-f0-9]{64}$"
    },
    "handoff_receipt_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "handoff_intent_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "blocked_plan_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "previous_writer_node_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.:-]{1,127}$"
    },
    "successor_writer_node_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.:-]{1,127}$"
    },
    "member_node_ids": {
      "type": "array",
      "minItems": 2,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_.:-]{1,127}$"
      }
    },
    "peer_snapshot_id": {
      "type": "string",
      "pattern": "^ha-state-[a-f0-9]{64}$"
    },
    "peer_journal_seq": {
      "type": "integer",
      "minimum": 0
    },
    "role_assignment_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "role_epoch": {
      "type": "integer",
      "minimum": 0
    },
    "role_resource_version": {
      "type": "integer",
      "minimum": 1
    },
    "role_journal_seq": {
      "type": "integer",
      "minimum": 1
    },
    "role_transition_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "minimum_ready_nodes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 64
    },
    "required_quorum_nodes": {
      "type": "integer",
      "minimum": 2,
      "maximum": 33
    },
    "ready_node_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_.:-]{1,127}$"
      }
    },
    "ready_count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 64
    },
    "lease_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.:-]{1,127}$"
    },
    "lease_epoch": {
      "type": "integer",
      "minimum": 1
    },
    "lease_resource_version": {
      "type": "integer",
      "minimum": 1
    },
    "lease_state_id": {
      "type": "string",
      "pattern": "^ha-writer-lease-[a-f0-9]{64}$"
    },
    "lease_revoked": {
      "const": true
    },
    "fence_confirmed": {
      "const": true
    },
    "rollback_candidate_node_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.:-]{1,127}$"
    },
    "rollback_admission_authorized": {
      "const": false
    },
    "role_transition_authorized": {
      "const": false
    },
    "failover_authorized": {
      "const": false
    },
    "host_mutation_authorized": {
      "const": false
    },
    "production_mutation_enabled": {
      "const": false
    }
  }
}
