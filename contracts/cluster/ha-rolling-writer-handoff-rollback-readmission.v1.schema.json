{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://home-center.invalid/contracts/cluster/ha-rolling-writer-handoff-rollback-readmission.v1.schema.json",
  "title": "HA rolling writer handoff rollback readmission",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "cluster_id",
    "readmission_id",
    "reconciliation_receipt_id",
    "prior_admission_id",
    "candidate_admission_id",
    "fencing_evidence_id",
    "recovery_assessment_id",
    "rollback_writer_node_id",
    "fenced_successor_node_id",
    "member_node_ids",
    "peer_snapshot_id",
    "peer_journal_seq",
    "ready_node_ids",
    "ready_count",
    "minimum_ready_nodes",
    "required_quorum_nodes",
    "expected_role_assignment_id",
    "expected_role_epoch",
    "expected_role_resource_version",
    "expected_role_journal_seq",
    "expected_role_transition_id",
    "target_role_assignment_id",
    "target_role_epoch",
    "lease_id",
    "lease_epoch",
    "lease_resource_version",
    "lease_state_id",
    "lease_revoked_for_role_transition_id",
    "recovery_generation",
    "maximum_recovery_generation",
    "fresh_cas_admission",
    "single_use_by_cas",
    "rollback_transition_admitted",
    "automatic_retry_authorized",
    "execution_authorized",
    "failover_authorized",
    "writer_service_authorized",
    "host_mutation_authorized",
    "production_mutation_enabled"
  ],
  "properties": {
    "schema": {
      "const": "home-center.ha-rolling-writer-handoff-rollback-readmission.v1"
    },
    "cluster_id": {"$ref": "#/$defs/identifier"},
    "readmission_id": {"$ref": "#/$defs/identifier"},
    "reconciliation_receipt_id": {"$ref": "#/$defs/identifier"},
    "prior_admission_id": {"$ref": "#/$defs/identifier"},
    "candidate_admission_id": {"$ref": "#/$defs/identifier"},
    "fencing_evidence_id": {"$ref": "#/$defs/identifier"},
    "recovery_assessment_id": {"$ref": "#/$defs/identifier"},
    "rollback_writer_node_id": {"$ref": "#/$defs/identifier"},
    "fenced_successor_node_id": {"$ref": "#/$defs/identifier"},
    "member_node_ids": {
      "type": "array",
      "minItems": 2,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/identifier"}
    },
    "peer_snapshot_id": {"$ref": "#/$defs/identifier"},
    "peer_journal_seq": {"type": "integer", "minimum": 0},
    "ready_node_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/identifier"}
    },
    "ready_count": {"type": "integer", "minimum": 1, "maximum": 64},
    "minimum_ready_nodes": {"type": "integer", "minimum": 1, "maximum": 64},
    "required_quorum_nodes": {"type": "integer", "minimum": 2, "maximum": 33},
    "expected_role_assignment_id": {"$ref": "#/$defs/identifier"},
    "expected_role_epoch": {"type": "integer", "minimum": 1},
    "expected_role_resource_version": {"type": "integer", "minimum": 1},
    "expected_role_journal_seq": {"type": "integer", "minimum": 1},
    "expected_role_transition_id": {"$ref": "#/$defs/identifier"},
    "target_role_assignment_id": {"$ref": "#/$defs/identifier"},
    "target_role_epoch": {"type": "integer", "minimum": 2},
    "lease_id": {"$ref": "#/$defs/identifier"},
    "lease_epoch": {"type": "integer", "minimum": 1},
    "lease_resource_version": {"type": "integer", "minimum": 1},
    "lease_state_id": {"$ref": "#/$defs/identifier"},
    "lease_revoked_for_role_transition_id": {"$ref": "#/$defs/identifier"},
    "recovery_generation": {"const": 1},
    "maximum_recovery_generation": {"const": 1},
    "fresh_cas_admission": {"const": true},
    "single_use_by_cas": {"const": true},
    "rollback_transition_admitted": {"const": true},
    "automatic_retry_authorized": {"const": false},
    "execution_authorized": {"const": false},
    "failover_authorized": {"const": false},
    "writer_service_authorized": {"const": false},
    "host_mutation_authorized": {"const": false},
    "production_mutation_enabled": {"const": false}
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.:-]{1,127}$"
    }
  }
}
