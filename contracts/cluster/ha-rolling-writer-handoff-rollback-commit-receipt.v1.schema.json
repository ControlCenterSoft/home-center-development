{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://home-center.invalid/contracts/cluster/ha-rolling-writer-handoff-rollback-commit-receipt.v1.schema.json",
  "title": "HA rolling writer handoff rollback commit receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "cluster_id",
    "receipt_id",
    "admission_id",
    "fencing_evidence_id",
    "recovery_assessment_id",
    "handoff_receipt_id",
    "handoff_intent_id",
    "blocked_plan_id",
    "rollback_writer_node_id",
    "fenced_successor_node_id",
    "member_node_ids",
    "precommit_peer_snapshot_id",
    "precommit_peer_journal_seq",
    "precommit_ready_node_ids",
    "minimum_ready_nodes",
    "required_quorum_nodes",
    "previous_role_assignment_id",
    "previous_role_epoch",
    "previous_role_resource_version",
    "previous_role_journal_seq",
    "previous_role_transition_id",
    "committed_role_assignment_id",
    "committed_role_epoch",
    "committed_role_resource_version",
    "committed_role_journal_seq",
    "committed_role_transition_id",
    "lease_id",
    "lease_epoch",
    "lease_resource_version",
    "lease_state_id",
    "transition_kind",
    "role_commit_applied",
    "single_use_by_cas",
    "retry_authorized",
    "execution_authorized",
    "failover_authorized",
    "writer_service_authorized",
    "host_mutation_authorized",
    "production_mutation_enabled"
  ],
  "properties": {
    "schema": {
      "const": "home-center.ha-rolling-writer-handoff-rollback-commit-receipt.v1"
    },
    "cluster_id": {
      "$ref": "#/$defs/identifier"
    },
    "receipt_id": {
      "$ref": "#/$defs/identifier"
    },
    "admission_id": {
      "$ref": "#/$defs/identifier"
    },
    "fencing_evidence_id": {
      "$ref": "#/$defs/identifier"
    },
    "recovery_assessment_id": {
      "$ref": "#/$defs/identifier"
    },
    "handoff_receipt_id": {
      "$ref": "#/$defs/identifier"
    },
    "handoff_intent_id": {
      "$ref": "#/$defs/identifier"
    },
    "blocked_plan_id": {
      "$ref": "#/$defs/identifier"
    },
    "rollback_writer_node_id": {
      "$ref": "#/$defs/identifier"
    },
    "fenced_successor_node_id": {
      "$ref": "#/$defs/identifier"
    },
    "member_node_ids": {
      "type": "array",
      "minItems": 2,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/identifier"
      }
    },
    "precommit_peer_snapshot_id": {
      "$ref": "#/$defs/identifier"
    },
    "precommit_peer_journal_seq": {
      "type": "integer",
      "minimum": 0
    },
    "precommit_ready_node_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/identifier"
      }
    },
    "minimum_ready_nodes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 64
    },
    "required_quorum_nodes": {
      "type": "integer",
      "minimum": 2,
      "maximum": 33
    },
    "previous_role_assignment_id": {
      "$ref": "#/$defs/identifier"
    },
    "previous_role_epoch": {
      "type": "integer",
      "minimum": 0
    },
    "previous_role_resource_version": {
      "type": "integer",
      "minimum": 1
    },
    "previous_role_journal_seq": {
      "type": "integer",
      "minimum": 1
    },
    "previous_role_transition_id": {
      "$ref": "#/$defs/identifier"
    },
    "committed_role_assignment_id": {
      "$ref": "#/$defs/identifier"
    },
    "committed_role_epoch": {
      "type": "integer",
      "minimum": 1
    },
    "committed_role_resource_version": {
      "type": "integer",
      "minimum": 2
    },
    "committed_role_journal_seq": {
      "type": "integer",
      "minimum": 2
    },
    "committed_role_transition_id": {
      "$ref": "#/$defs/identifier"
    },
    "lease_id": {
      "$ref": "#/$defs/identifier"
    },
    "lease_epoch": {
      "type": "integer",
      "minimum": 1
    },
    "lease_resource_version": {
      "type": "integer",
      "minimum": 1
    },
    "lease_state_id": {
      "$ref": "#/$defs/identifier"
    },
    "transition_kind": {
      "const": "rollback"
    },
    "role_commit_applied": {
      "const": true
    },
    "single_use_by_cas": {
      "const": true
    },
    "retry_authorized": {
      "const": false
    },
    "execution_authorized": {
      "const": false
    },
    "failover_authorized": {
      "const": false
    },
    "writer_service_authorized": {
      "const": false
    },
    "host_mutation_authorized": {
      "const": false
    },
    "production_mutation_enabled": {
      "const": false
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.:-]{1,127}$"
    }
  }
}
