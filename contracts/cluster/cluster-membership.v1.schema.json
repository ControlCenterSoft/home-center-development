{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://home-center.local/contracts/cluster/cluster-membership.v1.schema.json",
  "title": "ClusterMembership v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "cluster_id", "generation", "writer", "members", "quorum", "observed_at"],
  "properties": {
    "schema": {"const": "home-center.cluster-membership.v1"},
    "cluster_id": {"type": "string"},
    "generation": {"type": "integer", "minimum": 1},
    "writer": {"type": "string"},
    "members": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "object", "additionalProperties": false, "required": ["node_id", "state", "roles"], "properties": {"node_id": {"type": "string"}, "state": {"enum": ["joining", "ready", "maintenance", "draining", "removed"]}, "roles": {"type": "array", "items": {"type": "string"}}}}},
    "quorum": {"type": "object", "additionalProperties": false, "required": ["mode", "automatic_failover"], "properties": {"mode": {"enum": ["single-writer-manual-failover", "witness", "majority"]}, "automatic_failover": {"type": "boolean"}, "witness_id": {"type": ["string", "null"]}}},
    "observed_at": {"type": "string", "format": "date-time"}
  }
}
