{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "home-center.ha-rolling-writer-handoff-rollback-terminal-closure.v1",
  "title": "Home Center HA rolling writer handoff rollback terminal closure",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "cluster_id",
    "closure_id",
    "closure_replay_key",
    "closure_journal_entry_id",
    "source_terminal_reconciliation_receipt_id",
    "readmission_id",
    "prior_admission_id",
    "candidate_admission_id",
    "observed_reconciliation_receipt_id",
    "outcome",
    "reason",
    "operator_decision_id",
    "recovery_generation",
    "maximum_recovery_generation",
    "terminal_generation",
    "operator_recovery_closed",
    "single_use_by_source_receipt",
    "requires_new_recovery_lineage",
    "new_peer_snapshot_required",
    "new_fencing_evidence_required",
    "new_recovery_assessment_required",
    "previous_readmission_reusable",
    "previous_admission_reusable",
    "current_lineage_recovery_authorized",
    "fresh_admission_authorized",
    "further_readmission_authorized",
    "automatic_retry_authorized",
    "execution_authorized",
    "failover_authorized",
    "writer_service_authorized",
    "host_mutation_authorized",
    "production_mutation_enabled",
    "schema"
  ],
  "properties": {
    "cluster_id": {"type": "string", "minLength": 1},
    "closure_id": {"type": "string", "minLength": 1},
    "closure_replay_key": {"type": "string", "minLength": 1},
    "closure_journal_entry_id": {"type": "string", "minLength": 1},
    "source_terminal_reconciliation_receipt_id": {"type": "string", "minLength": 1},
    "readmission_id": {"type": "string", "minLength": 1},
    "prior_admission_id": {"type": "string", "minLength": 1},
    "candidate_admission_id": {"type": "string", "minLength": 1},
    "observed_reconciliation_receipt_id": {"type": "string", "minLength": 1},
    "outcome": {
      "enum": ["definitely-not-applied", "superseded", "ambiguous"]
    },
    "reason": {"type": "string", "minLength": 1},
    "operator_decision_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "recovery_generation": {"const": 1},
    "maximum_recovery_generation": {"const": 1},
    "terminal_generation": {"const": true},
    "operator_recovery_closed": {"const": true},
    "single_use_by_source_receipt": {"const": true},
    "requires_new_recovery_lineage": {"const": true},
    "new_peer_snapshot_required": {"const": true},
    "new_fencing_evidence_required": {"const": true},
    "new_recovery_assessment_required": {"const": true},
    "previous_readmission_reusable": {"const": false},
    "previous_admission_reusable": {"const": false},
    "current_lineage_recovery_authorized": {"const": false},
    "fresh_admission_authorized": {"const": false},
    "further_readmission_authorized": {"const": false},
    "automatic_retry_authorized": {"const": false},
    "execution_authorized": {"const": false},
    "failover_authorized": {"const": false},
    "writer_service_authorized": {"const": false},
    "host_mutation_authorized": {"const": false},
    "production_mutation_enabled": {"const": false},
    "schema": {
      "const": "home-center.ha-rolling-writer-handoff-rollback-terminal-closure.v1"
    }
  }
}
