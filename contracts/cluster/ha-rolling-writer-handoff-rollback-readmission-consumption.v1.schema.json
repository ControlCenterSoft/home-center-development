    "cluster_id": {"$ref": "#/$defs/identifier"},
    "consumption_id": {"$ref": "#/$defs/identifier"},
    "readmission_id": {"$ref": "#/$defs/identifier"},
    "reconciliation_receipt_id": {"$ref": "#/$defs/identifier"},
    "prior_admission_id": {"$ref": "#/$defs/identifier"},
    "candidate_admission_id": {"$ref": "#/$defs/identifier"},
    "commit_receipt_id": {"$ref": "#/$defs/identifier"},
    "fencing_evidence_id": {"$ref": "#/$defs/identifier"},
    "recovery_assessment_id": {"$ref": "#/$defs/identifier"},
    "handoff_receipt_id": {"$ref": "#/$defs/identifier"},
    "handoff_intent_id": {"$ref": "#/$defs/identifier"},
    "blocked_plan_id": {"$ref": "#/$defs/identifier"},
    "rollback_writer_node_id": {"$ref": "#/$defs/identifier"},
    "fenced_successor_node_id": {"$ref": "#/$defs/identifier"},
    "member_node_ids": {"type": "array", "minItems": 2, "maxItems": 64, "uniqueItems": true, "items": {"$ref": "#/$defs/identifier"}},
    "precommit_peer_snapshot_id": {"$ref": "#/$defs/identifier"},
    "precommit_peer_journal_seq": {"type": "integer", "minimum": 0},
    "precommit_ready_node_ids": {"type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": {"$ref": "#/$defs/identifier"}},
    "minimum_ready_nodes": {"type": "integer", "minimum": 1, "maximum": 64},
    "required_quorum_nodes": {"type": "integer", "minimum": 2, "maximum": 33},
    "previous_role_assignment_id": {"$ref": "#/$defs/identifier"},
    "previous_role_epoch": {"type": "integer", "minimum": 1},
    "previous_role_resource_version": {"type": "integer", "minimum": 1},
    "previous_role_journal_seq": {"type": "integer", "minimum": 1},
    "previous_role_transition_id": {"$ref": "#/$defs/identifier"},
    "committed_role_assignment_id": {"$ref": "#/$defs/identifier"},
    "committed_role_epoch": {"type": "integer", "minimum": 2},
    "committed_role_resource_version": {"type": "integer", "minimum": 2},
    "committed_role_journal_seq": {"type": "integer", "minimum": 2},
    "committed_role_transition_id": {"$ref": "#/$defs/identifier"},
    "lease_id": {"$ref": "#/$defs/identifier"},
    "lease_epoch": {"type": "integer", "minimum": 1},
    "lease_resource_version": {"type": "integer", "minimum": 1},
    "lease_state_id": {"$ref": "#/$defs/identifier"},
    "recovery_generation": {"const": 1},
    "maximum_recovery_generation": {"const": 1},
    "readmission_consumed": {"const": true},
    "role_commit_applied": {"const": true},
    "single_use_by_cas": {"const": true},
    "fresh_admission_required": {"const": false},
    "further_readmission_authorized": {"const": false},
    "automatic_retry_authorized": {"const": false},
    "execution_authorized": {"const": false},
    "failover_authorized": {"const": false},
    "writer_service_authorized": {"const": false},
    "host_mutation_authorized": {"const": false},
    "production_mutation_enabled": {"const": false}
  },
  "$defs": {"identifier": {"type": "string", "pattern": "^[a-z][a-z0-9_.:-]{1,127}$"}}
}
