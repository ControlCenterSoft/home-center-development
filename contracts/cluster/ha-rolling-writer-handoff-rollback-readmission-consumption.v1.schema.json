{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HA rolling writer handoff rollback readmission consumption",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "cluster_id", "consumption_id", "readmission_id", "reconciliation_receipt_id", "prior_admission_id", "candidate_admission_id", "commit_receipt_id", "fencing_evidence_id", "recovery_assessment_id", "handoff_receipt_id", "handoff_intent_id", "blocked_plan_id", "rollback_writer_node_id", "fenced_successor_node_id", "member_node_ids", "precommit_peer_snapshot_id", "precommit_peer_journal_seq", "precommit_ready_node_ids", "minimum_ready_nodes", "required_quorum_nodes", "previous_role_assignment_id", "previous_role_epoch", "previous_role_resource_version", "previous_role_journal_seq", "previous_role_transition_id", "committed_role_assignment_id", "committed_role_epoch", "committed_role_resource_version", "committed_role_journal_seq", "committed_role_transition_id", "lease_id", "lease_epoch", "lease_resource_version", "lease_state_id", "recovery_generation", "maximum_recovery_generation", "readmission_consumed", "role_commit_applied", "single_use_by_cas", "fresh_admission_required", "further_readmission_authorized", "automatic_retry_authorized", "execution_authorized", "failover_authorized", "writer_service_authorized", "host_mutation_authorized", "production_mutation_enabled"],
  "properties": {
