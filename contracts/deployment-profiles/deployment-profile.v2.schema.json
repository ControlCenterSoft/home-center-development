{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://home-center.invalid/contracts/deployment-profile.v2.schema.json",
  "title": "Home Center Deployment Profile v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "profile_id", "nodes", "placement"],
  "properties": {
    "schema": {"const": "home-center.deployment-profile.v2"},
    "profile_id": {"type": "string", "pattern": "^[a-z][a-z0-9_.:-]{1,127}$"},
    "directory_provider": {"type": ["string", "null"]},
    "nodes": {
      "type": "array", "minItems": 1, "maxItems": 64,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["node_id", "roles", "required_capabilities"],
        "properties": {
          "node_id": {"type": "string"},
          "hostname": {"type": ["string", "null"]},
          "endpoint": {"type": ["string", "null"]},
          "roles": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "required_capabilities": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
        }
      }
    },
    "placement": {
      "type": "object", "additionalProperties": false,
      "required": ["minimum_ready_nodes", "maximum_nodes", "allow_single_node"],
      "properties": {
        "minimum_ready_nodes": {"type": "integer", "minimum": 1, "maximum": 64},
        "maximum_nodes": {"type": "integer", "minimum": 1, "maximum": 64},
        "allow_single_node": {"type": "boolean"},
        "require_distinct_failure_domains": {"type": "boolean", "default": false}
      }
    }
  }
}
