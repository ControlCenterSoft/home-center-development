{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://home-center.local/contracts/smart-home/smart-home-device-state.v1.schema.json",
  "title": "Home Center smart home device state v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "device_id", "inventory_sha256", "profile_generation", "display_name", "room_id", "observed_room_id", "capabilities", "capability_families", "health", "diagnostics", "drift_detected", "observed_at_epoch", "battery_percent", "link_quality", "mutation_authorized", "provider_execution_authorized", "infrastructure_mutation_authorized", "external_publication_authorized"],
  "properties": {
    "schema": {"const": "home-center.smart-home-device-state.v1"},
    "device_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "inventory_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "profile_generation": {"type": "integer", "minimum": 1},
    "display_name": {"type": "string", "minLength": 1, "maxLength": 96},
    "room_id": {"type": ["string", "null"], "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "observed_room_id": {"type": ["string", "null"], "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "capabilities": {"type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+){0,7}$"}},
    "capability_families": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["climate", "cover", "lighting", "media", "other", "security", "sensor", "switch"]}},
    "health": {"enum": ["healthy", "degraded", "stale", "unknown"]},
    "diagnostics": {"type": "array", "maxItems": 16, "uniqueItems": true, "items": {"enum": ["low-battery", "room-drift", "state-stale", "state-unavailable", "weak-link"]}},
    "drift_detected": {"type": "boolean"},
    "observed_at_epoch": {"type": "integer", "minimum": 0},
    "battery_percent": {"type": ["integer", "null"], "minimum": 0, "maximum": 100},
    "link_quality": {"type": ["integer", "null"], "minimum": 0, "maximum": 255},
    "mutation_authorized": {"const": false},
    "provider_execution_authorized": {"const": false},
    "infrastructure_mutation_authorized": {"const": false},
    "external_publication_authorized": {"const": false}
  }
}
