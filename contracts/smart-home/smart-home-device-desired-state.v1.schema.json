{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://home-center.local/contracts/smart-home/smart-home-device-desired-state.v1.schema.json",
  "title": "Home Center Smart Home device desired state v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema","device_id","generation","display_name","room_id","expected_capabilities","configuration_sha256"],
  "properties": {
    "schema": {"const": "home-center.smart-home-device-desired-state.v1"},
    "device_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "generation": {"type": "integer", "minimum": 1},
    "display_name": {"type": "string", "minLength": 1, "maxLength": 96, "pattern": "^[^\\u0000-\\u001f\\u007f]+$"},
    "room_id": {"oneOf": [{"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"}, {"type": "null"}]},
    "expected_capabilities": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+){0,7}$"}
    },
    "configuration_sha256": {"oneOf": [{"type": "string", "pattern": "^[0-9a-f]{64}$"}, {"type": "null"}]}
  }
}
