{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://home-center.local/contracts/smart-home/zigbee-mqtt-backup-plan.v1.schema.json",
  "title": "Home Center ZigBee/MQTT backup plan v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "plan_id", "coordinator_id", "inventory_sha256", "reason", "backup_execution_authorized", "restore_execution_authorized", "external_publication_authorized"],
  "properties": {
    "schema": {"const": "home-center.zigbee-mqtt-backup-plan.v1"},
    "plan_id": {"type": "string", "pattern": "^hc65-backup-[0-9a-f]{24}$"},
    "coordinator_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "inventory_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "reason": {"enum": ["pre-pair", "pre-unpair", "manual"]},
    "backup_execution_authorized": {"const": false},
    "restore_execution_authorized": {"const": false},
    "external_publication_authorized": {"const": false}
  }
}
