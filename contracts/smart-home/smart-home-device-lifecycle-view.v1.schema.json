{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://home-center.local/contracts/smart-home/smart-home-device-lifecycle-view.v1.schema.json",
  "title": "Home Center Smart Home device lifecycle view v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema","device_id","coordinator_id","inventory_sha256","desired_generation","health","drift_state","drift_reasons",
    "observed_room_id","desired_room_id","observed_capabilities","expected_capabilities","battery_percent","link_quality",
    "configuration_verification_available","lifecycle_mutation_authorized","configuration_restore_authorized",
    "provider_execution_authorized","infrastructure_mutation_authorized","external_publication_authorized"
  ],
  "properties": {
    "schema": {"const": "home-center.smart-home-device-lifecycle-view.v1"},
    "device_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "coordinator_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "inventory_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "desired_generation": {"type": "integer", "minimum": 1},
    "health": {"enum": ["current","stale","unavailable"]},
    "drift_state": {"enum": ["in-sync","drifted","unknown"]},
    "drift_reasons": {"type": "array", "maxItems": 16, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$"}},
    "observed_room_id": {"oneOf": [{"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"}, {"type": "null"}]},
    "desired_room_id": {"oneOf": [{"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"}, {"type": "null"}]},
    "observed_capabilities": {"type": "array", "maxItems": 32, "uniqueItems": true, "items": {"type": "string"}},
    "expected_capabilities": {"type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": {"type": "string"}},
    "battery_percent": {"oneOf": [{"type": "integer", "minimum": 0, "maximum": 100}, {"type": "null"}]},
    "link_quality": {"oneOf": [{"type": "integer", "minimum": 0, "maximum": 255}, {"type": "null"}]},
    "configuration_verification_available": {"type": "boolean"},
    "lifecycle_mutation_authorized": {"const": false},
    "configuration_restore_authorized": {"const": false},
    "provider_execution_authorized": {"const": false},
    "infrastructure_mutation_authorized": {"const": false},
    "external_publication_authorized": {"const": false}
  },
  "allOf": [
    {"if": {"properties": {"health": {"enum": ["stale","unavailable"]}}, "required": ["health"]}, "then": {"properties": {"drift_state": {"const": "unknown"}}}}
  ]
}
