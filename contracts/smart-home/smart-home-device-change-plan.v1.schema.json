{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://home-center.local/contracts/smart-home/smart-home-device-change-plan.v1.schema.json",
  "title": "Home Center Smart Home device change plan v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema","plan_id","change_kind","device_id","coordinator_id","inventory_sha256","desired_generation",
    "expected_observed_room_id","proposed_display_name","proposed_room_id","explicit_confirmation_required",
    "execution_authorized","provider_execution_authorized","infrastructure_mutation_authorized","external_publication_authorized"
  ],
  "properties": {
    "schema": {"const": "home-center.smart-home-device-change-plan.v1"},
    "plan_id": {"type": "string", "pattern": "^hc66-change-[0-9a-f]{24}$"},
    "change_kind": {"enum": ["rename","assign-room"]},
    "device_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "coordinator_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "inventory_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "desired_generation": {"type": "integer", "minimum": 1},
    "expected_observed_room_id": {"oneOf": [{"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"}, {"type": "null"}]},
    "proposed_display_name": {"oneOf": [{"type": "string", "minLength": 1, "maxLength": 96, "pattern": "^[^\\u0000-\\u001f\\u007f]+$"}, {"type": "null"}]},
    "proposed_room_id": {"oneOf": [{"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"}, {"type": "null"}]},
    "explicit_confirmation_required": {"const": true},
    "execution_authorized": {"const": false},
    "provider_execution_authorized": {"const": false},
    "infrastructure_mutation_authorized": {"const": false},
    "external_publication_authorized": {"const": false}
  },
  "allOf": [
    {
      "if": {"properties": {"change_kind": {"const": "rename"}}, "required": ["change_kind"]},
      "then": {"properties": {"proposed_display_name": {"type": "string", "minLength": 1, "maxLength": 96}, "proposed_room_id": {"type": "null"}}}
    },
    {
      "if": {"properties": {"change_kind": {"const": "assign-room"}}, "required": ["change_kind"]},
      "then": {"properties": {"proposed_display_name": {"type": "null"}, "proposed_room_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"}}}
    }
  ]
}
