[Unit]
Description=Home Center HA automatic stable-release update check
Wants=network-online.target
After=network-online.target
ConditionPathExists=/opt/home-center/scripts/home-center-sync.sh

[Service]
Type=oneshot
User=root
Group=root
EnvironmentFile=-/etc/home-center/auto-update.env
ExecStart=/usr/local/sbin/home-center-auto-update
TimeoutStartSec=50min
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
